@model List<Game.Models.Order>
@{
    ViewData["Title"] = "ประวัติการสั่งซื้อ";
    var email = ViewBag.UserEmail as string;
}

<style>
    .mo-wrap { display: flex; max-width: 1100px; margin: 0 auto; min-height: 70vh; }

    .mo-side { width: 220px; flex-shrink: 0; background: #05070d; border-radius: 1rem 0 0 1rem;
               padding: 1.5rem 1rem; display: flex; flex-direction: column; gap: .3rem; }
    .mo-side a { display: flex; align-items: center; gap: .6rem; color: #cbd5e1; text-decoration: none;
                 padding: .6rem .8rem; border-radius: .6rem; font-size: .85rem; }
    .mo-side a:hover { background: rgba(255,255,255,.06); }
    .mo-side a.active { background: #7c3aed; color: #fff; font-weight: 600; }

    .mo-main { flex: 1; background: linear-gradient(160deg, #4c3bb8, #2c2270); border-radius: 0 1rem 1rem 0; padding: 2rem; }

    .mo-user { background: #0f1320; border-radius: .9rem; padding: 1.1rem 1.3rem; display: flex; align-items: center; gap: .9rem; margin-bottom: 1.5rem; }
    .mo-avatar { width: 42px; height: 42px; border-radius: 50%; background: linear-gradient(135deg,#7c3aed,#9333ea);
                 display: flex; align-items: center; justify-content: center; font-weight: 700; color: #fff; flex-shrink: 0; }
    .mo-user .lbl { font-size: .7rem; color: #94a3b8; }
    .mo-user .val { font-size: .95rem; font-weight: 600; color: #fff; }

    .mo-panel { background: #0f1320; border-radius: .9rem; padding: 1.3rem; }
    .mo-panel h3 { margin: 0 0 1rem; font-size: 1.05rem; font-weight: 700; color: #fff; }

    .mo-alert { background: rgba(34,197,94,.15); color: #86efac; border-radius: .6rem; padding: .6rem .9rem; font-size: .85rem; margin-bottom: 1rem; }

    .mo-order { border: 1px solid rgba(255,255,255,.08); border-radius: .8rem; padding: 1rem 1.1rem; margin-bottom: .9rem; }
    .mo-order-head { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: .5rem; margin-bottom: .6rem; }
    .mo-order-no { color: #fff; font-weight: 700; font-size: .9rem; }
    .mo-order-date { color: #94a3b8; font-size: .78rem; }

    .mo-badge { font-size: .72rem; padding: .2rem .7rem; border-radius: 9999px; font-weight: 600; }
    .mo-badge.pending { background: rgba(250,204,21,.15); color: #fde047; }
    .mo-badge.paid { background: rgba(34,197,94,.15); color: #86efac; }

    .mo-line { display: flex; justify-content: space-between; font-size: .82rem; color: #cbd5e1; padding: .25rem 0; }
    .mo-total { display: flex; justify-content: space-between; border-top: 1px solid rgba(255,255,255,.08);
                margin-top: .5rem; padding-top: .5rem; font-weight: 700; color: #fff; font-size: .9rem; }

    .mo-pay { margin-top: .8rem; width: 100%; background: #4de1c4; color: #063b33; border: none; border-radius: .6rem;
              padding: .6rem; font-weight: 700; cursor: pointer; }
    .mo-pay:hover { background: #6ff0d5; }

    .mo-empty { text-align: center; color: #cbd5e1; padding: 3rem 1rem; }
    .mo-empty a { display: inline-block; margin-top: 1rem; background: #7c3aed; color: #fff; padding: .55rem 1.3rem;
                  border-radius: .7rem; text-decoration: none; font-weight: 600; }

    @@media (max-width: 700px) {
        .mo-wrap { flex-direction: column; }
        .mo-side { width: 100%; flex-direction: row; overflow-x: auto; border-radius: 1rem 1rem 0 0; }
        .mo-main { border-radius: 0 0 1rem 1rem; }
    }

    .mo-alert.err { background: rgba(239,68,68,.12); color: #fca5a5; }

.pm-overlay { display:none; position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,.7);
              align-items:center; justify-content:center; padding:1rem; }
.pm-box { background:#111827; border:1px solid rgba(255,255,255,.1); border-radius:1rem;
          padding:1.6rem; max-width:400px; width:100%; color:#fff; }
.pm-box h3 { margin:0 0 .3rem; font-size:1.1rem; font-weight:700; }
.pm-sub { color:#94a3b8; font-size:.82rem; margin:0 0 1.1rem; }

.pm-options { display:grid; grid-template-columns:1fr 1fr; gap:.7rem; }
.pm-opt { background:#0f1320; border:1.5px solid rgba(255,255,255,.1); border-radius:.8rem;
          padding:1rem .6rem; color:#cbd5e1; cursor:pointer; display:flex; flex-direction:column;
          align-items:center; gap:.5rem; font-size:.8rem; }
.pm-opt i { font-size:1.6rem; }
.pm-opt:hover { border-color:rgba(255,255,255,.3); }
.pm-opt.selected { border-color:#7c3aed; background:rgba(124,58,237,.12); color:#fff; }

.pm-detail { margin-top:1rem; background:#0f1320; border-radius:.7rem; padding:.9rem; font-size:.82rem; color:#cbd5e1; }
.pm-detail input { width:100%; background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.15);
                    border-radius:.5rem; padding:.5rem .6rem; color:#fff; outline:none; box-sizing:border-box; }
.pm-qr { text-align:center; }
.pm-qr-box { font-size:3rem; background:#fff; color:#111; width:120px; height:120px; margin:0 auto .6rem;
             border-radius:.6rem; display:flex; align-items:center; justify-content:center; }

.pm-actions { display:flex; gap:.7rem; margin-top:1.3rem; }
.pm-cancel, .pm-continue { flex:1; border:none; border-radius:.6rem; padding:.65rem; font-weight:700; cursor:pointer; }
.pm-cancel { background:rgba(255,255,255,.08); color:#fff; }
.pm-continue { background:#4de1c4; color:#063b33; }
.pm-continue:disabled { opacity:.4; cursor:not-allowed; }
</style>

<div class="mo-wrap">
    <aside class="mo-side">
        <a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house"></i> หน้าแรก</a>
        <a asp-controller="Cart" asp-action="Index"><i class="fa-solid fa-cart-shopping"></i> ตะกร้า</a>
        <a asp-controller="Cart" asp-action="MyOrders" class="active"><i class="fa-solid fa-clock-rotate-left"></i> History</a>
    </aside>

    <div class="mo-main">
        <div class="mo-user">
            <div class="mo-avatar">@(string.IsNullOrEmpty(email) ? "?" : email.Substring(0,1).ToUpper())</div>
            <div>
                <div class="lbl">เข้าสู่ระบบด้วย</div>
                <div class="val">@email</div>
            </div>
        </div>

        <div class="mo-panel">
            <h3>ประวัติการสั่งซื้อ</h3>

            @if (TempData["PayOk"] != null)
            {
                <div class="mo-alert">@TempData["PayOk"]</div>
            }

            @if (!Model.Any())
            {
                <div class="mo-empty">
                    <div style="font-size:2.4rem;">🧾</div>
                    <p>ยังไม่มีประวัติการสั่งซื้อ</p>
                    <a asp-controller="Product" asp-action="Index">ไปเลือกซื้อเกม</a>
                </div>
            }
            else
            {
                @foreach (var order in Model)
                {
                    var orderNo = order.Id.ToString().Substring(0, 8).ToUpper();
                    <div class="mo-order">
                        <div class="mo-order-head">
                            <div>
                                <div class="mo-order-no">#@orderNo</div>
                                <div class="mo-order-date">@order.CreatedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")</div>
                            </div>
                            <span class="mo-badge @(order.Status == "paid" ? "paid" : "pending")">
                                @(order.Status == "paid" ? "ชำระเงินแล้ว" : "รอชำระเงิน")
                            </span>
                        </div>

                        @foreach (var item in order.Items)
                        {
                            <div class="mo-line">
                                <span>@(item.Product?.Name ?? "สินค้า") × @item.Quantity</span>
                                <span>฿@((item.Price * item.Quantity).ToString("N2"))</span>
                            </div>
                        }

                        @if (order.DiscountAmount > 0)
                        {
                            <div class="mo-line" style="color:#86efac">
                                <span>ส่วนลด (@order.CouponCode)</span>
                                <span>−฿@order.DiscountAmount.ToString("N2")</span>
                            </div>
                        }

                        <div class="mo-total"><span>ยอดสุทธิ</span><span>฿@order.TotalPrice.ToString("N2")</span></div>

                        @if (order.Status == "pending")
                        {
                           <button type="button" class="mo-pay" onclick="openPayModal('@order.Id')">💳 ชำระเงิน</button>
                        }
                        @if (TempData["PayError"] != null)
                        {
                            <div class="mo-alert err">@TempData["PayError"]</div>
                        }
                    </div>
                }
                <!-- PAYMENT MODAL -->
<div id="payModal" class="pm-overlay">
    <div class="pm-box">
        <h3>เลือกวิธีชำระเงิน</h3>
        <p class="pm-sub">กรุณาเลือกช่องทางชำระเงินก่อนดำเนินการต่อ</p>

        <div class="pm-options">
            <button type="button" class="pm-opt" data-method="visa">
                <i class="fa-brands fa-cc-visa"></i>
                <span>บัตร Visa</span>
            </button>
            <button type="button" class="pm-opt" data-method="promptpay">
                <i class="fa-solid fa-qrcode"></i>
                <span>PromptPay QR</span>
            </button>
        </div>

        <div id="pmDetail" class="pm-detail" style="display:none;"></div>

        <div class="pm-actions">
            <button type="button" class="pm-cancel" id="pmCancel">ยกเลิก</button>
            <button type="button" class="pm-continue" id="pmContinue" disabled>ดำเนินการต่อ</button>
        </div>
    </div>
</div>

<form id="payForm" asp-action="Pay" method="post" style="display:none">
    <input type="hidden" name="id" id="payFormId" />
    <input type="hidden" name="method" id="payFormMethod" />
</form>

@section Scripts {
<script>
(function () {
    let selectedMethod = null;

    window.openPayModal = function (orderId) {
        document.getElementById('payFormId').value = orderId;
        selectedMethod = null;
        document.querySelectorAll('.pm-opt').forEach(o => o.classList.remove('selected'));
        document.getElementById('pmDetail').style.display = 'none';
        document.getElementById('pmContinue').disabled = true;
        document.getElementById('payModal').style.display = 'flex';
    };

    document.querySelectorAll('.pm-opt').forEach(function (opt) {
        opt.addEventListener('click', function () {
            document.querySelectorAll('.pm-opt').forEach(o => o.classList.remove('selected'));
            opt.classList.add('selected');
            selectedMethod = opt.dataset.method;
            document.getElementById('pmContinue').disabled = false;

            const detail = document.getElementById('pmDetail');
            if (selectedMethod === 'visa') {
                detail.innerHTML =
                    '<input placeholder="หมายเลขบัตร (จำลอง) 4242 4242 4242 4242" maxlength="19" />' +
                    '<div style="display:flex;gap:.5rem;margin-top:.5rem">' +
                    '<input placeholder="MM/YY" style="width:50%" />' +
                    '<input placeholder="CVV" style="width:50%" /></div>';
            } else {
                detail.innerHTML =
                    '<div class="pm-qr"><div class="pm-qr-box">📱</div>' +
                    '<p>สแกน QR เพื่อชำระผ่าน PromptPay (จำลอง)</p></div>';
            }
            detail.style.display = 'block';
        });
    });

    document.getElementById('pmCancel').addEventListener('click', function () {
        document.getElementById('payModal').style.display = 'none';   // 👈 ยกเลิก = ไม่มีอะไรเกิดขึ้น
    });

    document.getElementById('payModal').addEventListener('click', function (e) {
        if (e.target === this) this.style.display = 'none';
    });

    document.getElementById('pmContinue').addEventListener('click', function () {
        if (!selectedMethod) return;
        document.getElementById('payFormMethod').value = selectedMethod;
        document.getElementById('payForm').submit();   // 👈 Continue = ตัดสต็อกจริง + ไปหน้าประวัติ
    });
})();
</script>
}
            }
        </div>
    </div>
</div>