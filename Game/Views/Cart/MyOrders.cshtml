@model List<Game.Models.Order>

@{
    ViewData["Title"] = "ประวัติการสั่งซื้อ";
    Layout = null;

    var orders = Model ?? new List<Game.Models.Order>();
    var pendingOrders = orders.Where(o => o.Status == "pending").ToList();
    var paidOrders = orders.Where(o => o.Status == "paid").ToList();
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - GameWorld</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <style>
        :root {
            --bg: #080810;
            --panel: #11111f;
            --panel-light: #17172a;
            --purple: #8b5cf6;
            --purple-light: #a78bfa;
            --text: #f5f3ff;
            --muted: #9999b5;
            --border: rgba(167, 139, 250, .17);
            --red: #f87171;
            --green: #34d399;
        }

        * {
            box-sizing: border-box;
        }

        /* แก้ไข: ทำให้ body เป็น flex เพื่อให้ sidebar กับเนื้อหาอยู่เคียงกัน */
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: flex-start;
            font-family: 'Kanit', sans-serif;
            color: var(--text);
            background:
                radial-gradient(ellipse at 15% 0%, rgba(109, 40, 217, .13), transparent 38%),
                radial-gradient(ellipse at 90% 35%, rgba(76, 29, 149, .10), transparent 35%),
                var(--bg);
        }

        button, input, select {
            font: inherit;
        }

        button {
            cursor: pointer;
        }

        /* แก้ไข: ใช้ flex:1 แทนการกำหนด width ตายตัว */
        .orders-page {
            flex: 1;
            min-width: 0;
            max-width: 1120px;
            margin: 0 auto;
            padding: 42px 18px 70px;
        }

        .page-heading {
            margin-bottom: 30px;
        }

        .heading-label {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--purple-light);
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .page-title {
            margin: 10px 0 8px;
            font-size: clamp(27px, 4vw, 38px);
            font-weight: 800;
            letter-spacing: -.5px;
        }

        .page-subtitle {
            margin: 0;
            color: var(--muted);
            font-size: 14px;
        }

        .summary-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 15px;
            margin-bottom: 35px;
        }

        .summary-card {
            display: flex;
            align-items: center;
            gap: 15px;
            min-width: 0;
            padding: 20px;
            border: 1px solid var(--border);
            border-radius: 18px;
            background: linear-gradient(145deg, rgba(23, 23, 42, .95), rgba(13, 13, 25, .95));
        }

        .summary-icon {
            display: grid;
            place-items: center;
            flex-shrink: 0;
            width: 47px;
            height: 47px;
            border-radius: 14px;
            color: var(--purple-light);
            background: rgba(139, 92, 246, .13);
            font-size: 19px;
        }

        .summary-icon.orange {
            color: #fbbf24;
            background: rgba(245, 158, 11, .11);
        }

        .summary-icon.green {
            color: var(--green);
            background: rgba(52, 211, 153, .11);
        }

        .summary-label {
            color: var(--muted);
            font-size: 12px;
        }

        .summary-value {
            margin-top: 3px;
            font-size: 23px;
            font-weight: 700;
            line-height: 1.3;
        }

        .section-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin: 35px 0 16px;
        }

        .section-title {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 0;
            font-size: 20px;
            font-weight: 700;
        }

        .section-title i {
            color: var(--purple-light);
        }

        .section-count {
            display: inline-grid;
            place-items: center;
            min-width: 28px;
            height: 27px;
            padding: 0 8px;
            border: 1px solid var(--border);
            border-radius: 9px;
            color: var(--purple-light);
            background: rgba(139, 92, 246, .12);
            font-size: 12px;
        }

        .orders-list {
            display: grid;
            gap: 17px;
        }

        .order-card {
            overflow: hidden;
            border: 1px solid var(--border);
            border-radius: 20px;
            background: linear-gradient(145deg, rgba(19, 19, 34, .98), rgba(12, 12, 23, .98));
            box-shadow: 0 12px 35px rgba(0, 0, 0, .14);
            transition: border-color .2s, transform .2s;
        }

        .order-card:hover {
            border-color: rgba(167, 139, 250, .38);
            transform: translateY(-2px);
        }

        .order-top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 16px;
            padding: 20px 22px;
            border-bottom: 1px solid rgba(167, 139, 250, .10);
        }

        .order-label {
            color: var(--muted);
            font-size: 12px;
        }

        .order-number {
            margin-top: 4px;
            color: var(--purple-light);
            font-size: 17px;
            font-weight: 700;
            overflow-wrap: anywhere;
        }

        .order-date {
            margin-top: 5px;
            color: var(--muted);
            font-size: 12px;
        }

        .status {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            flex-shrink: 0;
            padding: 7px 11px;
            border: 1px solid rgba(251, 191, 36, .2);
            border-radius: 30px;
            color: #fbbf24;
            background: rgba(245, 158, 11, .09);
            font-size: 12px;
            white-space: nowrap;
        }

        .status.paid {
            border-color: rgba(52, 211, 153, .2);
            color: var(--green);
            background: rgba(52, 211, 153, .08);
        }

        .order-body {
            padding: 20px 22px;
        }

        .items-list {
            display: grid;
            gap: 14px;
        }

        .order-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
        }

        .item-info {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 0;
        }

        .item-icon {
            display: grid;
            place-items: center;
            flex-shrink: 0;
            width: 43px;
            height: 43px;
            border: 1px solid var(--border);
            border-radius: 12px;
            color: var(--purple-light);
            background: rgba(139, 92, 246, .09);
        }

        .item-name {
            overflow-wrap: anywhere;
            font-size: 14px;
            font-weight: 500;
        }

        .item-quantity {
            margin-top: 3px;
            color: var(--muted);
            font-size: 12px;
        }

        .item-price {
            flex-shrink: 0;
            color: #e9e3ff;
            font-size: 14px;
            font-weight: 600;
        }

        .order-bottom {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
            padding: 18px 22px;
            border-top: 1px solid rgba(167, 139, 250, .12);
            background: rgba(7, 7, 15, .32);
        }

        .total-label {
            color: var(--muted);
            font-size: 12px;
        }

        .total-price {
            margin-top: 3px;
            color: #c4b5fd;
            font-size: 25px;
            font-weight: 800;
        }

        .order-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            flex-wrap: wrap;
            gap: 10px;
        }

        .order-actions form {
            margin: 0;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 43px;
            padding: 10px 16px;
            border: 1px solid transparent;
            border-radius: 11px;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            transition: .2s ease;
        }

        .btn:disabled {
            opacity: .6;
            cursor: not-allowed;
        }

        .btn-purple {
            color: white;
            background: linear-gradient(135deg, #8b5cf6, #6d28d9);
            box-shadow: 0 5px 18px rgba(139, 92, 246, .17);
        }

        .btn-purple:hover {
            color: white;
            filter: brightness(1.12);
            transform: translateY(-1px);
        }

        .btn-cancel {
            color: #fca5a5;
            border-color: rgba(248, 113, 113, .25);
            background: rgba(239, 68, 68, .08);
        }

        .btn-cancel:hover {
            color: white;
            border-color: rgba(248, 113, 113, .6);
            background: rgba(239, 68, 68, .18);
        }

        .btn-dark {
            color: #d1d5e8;
            border-color: rgba(148, 163, 184, .2);
            background: rgba(148, 163, 184, .08);
        }

        .btn-dark:hover {
            color: white;
            background: rgba(148, 163, 184, .16);
        }

        .empty-state {
            padding: 45px 20px;
            border: 1px dashed rgba(167, 139, 250, .22);
            border-radius: 18px;
            text-align: center;
            background: rgba(17, 17, 31, .55);
        }

        .empty-icon {
            display: grid;
            place-items: center;
            width: 65px;
            height: 65px;
            margin: 0 auto 15px;
            border-radius: 20px;
            color: var(--purple-light);
            background: rgba(139, 92, 246, .12);
            font-size: 25px;
        }

        .empty-state h3 {
            margin: 0 0 7px;
            font-size: 18px;
        }

        .empty-state p {
            margin: 0;
            color: var(--muted);
            font-size: 13px;
        }

        /* Popup ยืนยันการยกเลิก */
        .cancel-modal {
            position: fixed;
            inset: 0;
            z-index: 100001;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: rgba(2, 6, 23, .82);
            backdrop-filter: blur(10px);
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: opacity .25s ease, visibility .25s ease;
        }

        .cancel-modal.open {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
        }

        .cancel-dialog {
            width: 100%;
            max-width: 410px;
            padding: 30px 26px 25px;
            border: 1px solid rgba(248, 113, 113, .28);
            border-radius: 24px;
            background: linear-gradient(145deg, #191629, #0d1220 75%);
            box-shadow: 0 0 55px rgba(239, 68, 68, .12), 0 20px 70px rgba(0, 0, 0, .4);
            text-align: center;
            transform: translateY(18px) scale(.96);
            transition: transform .25s ease;
        }

        .cancel-modal.open .cancel-dialog {
            transform: translateY(0) scale(1);
        }

        .cancel-icon {
            display: grid;
            place-items: center;
            width: 78px;
            height: 78px;
            margin: 0 auto 19px;
            border: 1px solid rgba(248, 113, 113, .3);
            border-radius: 50%;
            color: #f87171;
            background: rgba(239, 68, 68, .10);
            font-size: 30px;
            box-shadow: 0 0 28px rgba(239, 68, 68, .10);
        }

        .cancel-title {
            margin: 0 0 10px;
            color: #f8fafc;
            font-size: 23px;
            font-weight: 800;
        }

        .cancel-description {
            margin: 0 0 20px;
            color: #9ca3b8;
            font-size: 14px;
            line-height: 1.8;
        }

        .cancel-order-info {
            margin-bottom: 23px;
            padding: 14px;
            border: 1px solid rgba(148, 163, 184, .14);
            border-radius: 13px;
            background: rgba(15, 23, 42, .7);
            color: #94a3b8;
            font-size: 12px;
        }

        .cancel-order-info strong {
            display: block;
            margin-top: 5px;
            color: #c4b5fd;
            font-size: 19px;
        }

        .cancel-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 11px;
        }

        .cancel-actions .btn {
            width: 100%;
            min-height: 46px;
        }

        .btn-cancel-confirm {
            color: #fff;
            border: 1px solid rgba(248, 113, 113, .4);
            background: linear-gradient(135deg, #ef4444, #b91c1c);
        }

        .btn-cancel-confirm:hover {
            color: #fff;
            filter: brightness(1.12);
            box-shadow: 0 0 20px rgba(239, 68, 68, .2);
        }

        /* Popup ชำระเงิน */
        .pm-overlay {
            position: fixed;
            inset: 0;
            z-index: 100000;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 18px;
            background: rgba(2, 6, 23, .84);
            backdrop-filter: blur(10px);
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: .25s ease;
        }

        .pm-overlay.open {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
        }

        .pm-box {
            width: 100%;
            max-width: 480px;
            max-height: 90vh;
            overflow-y: auto;
            padding: 25px;
            border: 1px solid var(--border);
            border-radius: 22px;
            background: linear-gradient(145deg, #191629, #0d1220);
            box-shadow: 0 20px 70px rgba(0, 0, 0, .5);
            transform: translateY(12px) scale(.98);
            transition: .25s ease;
        }

        .pm-overlay.open .pm-box {
            transform: translateY(0) scale(1);
        }

        .pm-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            margin-bottom: 20px;
        }

        .pm-head h2 {
            margin: 0;
            font-size: 21px;
        }

        .pm-close {
            display: grid;
            place-items: center;
            width: 36px;
            height: 36px;
            border: 1px solid var(--border);
            border-radius: 10px;
            color: #cbd5e1;
            background: rgba(148, 163, 184, .08);
        }

        .pm-amount {
            margin-bottom: 20px;
            padding: 17px;
            border: 1px solid var(--border);
            border-radius: 14px;
            background: rgba(139, 92, 246, .08);
        }

        .pm-amount small {
            color: var(--muted);
        }

        .pm-amount strong {
            display: block;
            margin-top: 4px;
            color: #c4b5fd;
            font-size: 28px;
        }

        .pm-label {
            display: block;
            margin-bottom: 9px;
            color: #d1d5e8;
            font-size: 13px;
        }

        .pm-options {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 18px;
        }

        .pm-option {
            padding: 15px 10px;
            border: 1px solid var(--border);
            border-radius: 13px;
            color: #e5e7eb;
            background: rgba(148, 163, 184, .04);
            text-align: center;
        }

        .pm-option.active {
            border-color: var(--purple);
            background: rgba(139, 92, 246, .12);
            box-shadow: 0 0 16px rgba(139, 92, 246, .09);
        }

        .pm-option i {
            display: block;
            margin-bottom: 8px;
            color: var(--purple-light);
            font-size: 23px;
        }

        .pm-detail {
            margin-bottom: 18px;
            padding: 17px;
            border: 1px solid rgba(167, 139, 250, .13);
            border-radius: 14px;
            background: rgba(8, 8, 16, .45);
        }

        .pm-qr {
            display: block;
            width: 190px;
            height: 190px;
            max-width: 100%;
            margin: 12px auto;
            border-radius: 12px;
            background: white;
            object-fit: contain;
        }

        .pm-note {
            color: var(--muted);
            font-size: 12px;
            line-height: 1.7;
            text-align: center;
        }

        .pm-field {
            width: 100%;
            min-height: 44px;
            margin-bottom: 12px;
            padding: 10px 12px;
            border: 1px solid rgba(167, 139, 250, .2);
            border-radius: 10px;
            outline: none;
            color: white;
            background: #0c0c18;
        }

        .pm-field:focus {
            border-color: var(--purple);
        }

        .pm-submit {
            width: 100%;
            min-height: 47px;
            border: 0;
            border-radius: 12px;
            color: white;
            background: linear-gradient(135deg, #8b5cf6, #6d28d9);
            font-weight: 700;
        }

        .pm-submit:hover {
            filter: brightness(1.1);
        }

        .pm-submit:disabled {
            opacity: .6;
            cursor: not-allowed;
        }

        .notice {
            margin-bottom: 20px;
            padding: 14px 16px;
            border: 1px solid;
            border-radius: 12px;
            font-size: 13px;
        }

        .notice.success {
            border-color: rgba(52, 211, 153, .25);
            color: #6ee7b7;
            background: rgba(16, 185, 129, .08);
        }

        .notice.error {
            border-color: rgba(248, 113, 113, .25);
            color: #fca5a5;
            background: rgba(239, 68, 68, .08);
        }

        /* การ์ดแบบกะทัดรัด (ชำระเงินแล้ว) */
        .paid-list {
            gap: 9px;
        }

        .order-card.compact {
            border-radius: 14px;
            box-shadow: none;
        }

        .order-card.compact:hover {
            transform: none;
        }

        .compact-row {
            display: grid;
            grid-template-columns: 150px minmax(0, 1fr) auto;
            align-items: center;
            gap: 16px;
            padding: 11px 16px;
        }

        .compact-id .order-number {
            margin: 0;
            font-size: 14px;
        }

        .compact-id .order-date {
            margin-top: 2px;
            font-size: 11px;
        }

        .compact-items {
            display: grid;
            gap: 4px;
            min-width: 0;
        }

        .compact-item {
            display: flex;
            align-items: center;
            gap: 8px;
            min-width: 0;
            font-size: 13px;
        }

        .compact-item i {
            flex-shrink: 0;
            color: var(--purple-light);
            font-size: 12px;
        }

        .compact-item-name {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-weight: 500;
        }

        .compact-item-qty {
            flex-shrink: 0;
            color: var(--muted);
            font-size: 12px;
        }

        .compact-item-empty {
            color: var(--muted);
            font-size: 12px;
        }

        .compact-end {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 4px;
        }

        .compact-total {
            color: #c4b5fd;
            font-size: 17px;
            font-weight: 800;
            line-height: 1.2;
        }

        .status.mini {
            padding: 2px 9px;
            font-size: 11px;
        }

        @@media (max-width: 720px) {
            .compact-row {
                grid-template-columns: 1fr;
                gap: 8px;
                padding: 12px 14px;
            }

            .compact-end {
                flex-direction: row;
                align-items: center;
                justify-content: space-between;
            }
        }

        /* มือถือ/แท็บเล็ตเล็ก: sidebar กลายเป็นแถบด้านบน ให้เรียงแนวตั้ง */
        @@media (max-width: 760px) {
            body {
                flex-direction: column;
                align-items: stretch;
            }
        }

        @@media (max-width: 720px) {
            .orders-page {
                width: 100%;
                padding: 28px 12px 50px;
            }

            .summary-grid {
                grid-template-columns: 1fr;
                gap: 10px;
            }

            .summary-card {
                padding: 15px;
            }

            .order-top {
                padding: 17px;
            }

            .order-body {
                padding: 17px;
            }

            .order-bottom {
                align-items: stretch;
                flex-direction: column;
                padding: 17px;
            }

            .order-actions {
                display: grid;
                grid-template-columns: 1fr 1fr;
                width: 100%;
            }

            .order-actions .btn,
            .order-actions form,
            .order-actions form .btn {
                width: 100%;
            }

            .cancel-actions {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 400px) {
            .order-actions {
                grid-template-columns: 1fr;
            }

            .order-number {
                font-size: 14px;
            }

            .status {
                padding: 6px 8px;
                font-size: 11px;
            }

            .pm-box {
                padding: 18px;
            }
        }
    </style>
</head>

<body>
    @await Html.PartialAsync("_Sidebar")

    <main class="orders-page">
        <header class="page-heading">
            <div class="heading-label">
                <i class="fa-solid fa-gamepad"></i>
                GAMEWORLD ACCOUNT
            </div>
            <h1 class="page-title">ประวัติการสั่งซื้อ</h1>
            <p class="page-subtitle">ตรวจสอบรายการสั่งซื้อและจัดการการชำระเงินของคุณ</p>
        </header>

        @if (TempData["PayOk"] != null)
        {
            <div class="notice success">
                <i class="fa-solid fa-circle-check"></i>
                @TempData["PayOk"]
            </div>
        }

        @if (TempData["PaySuccess"] != null)
        {
            <div class="notice success">
                <i class="fa-solid fa-circle-check"></i>
                @TempData["PaySuccess"]
            </div>
        }

        @if (TempData["PayError"] != null)
        {
            <div class="notice error">
                <i class="fa-solid fa-circle-exclamation"></i>
                @TempData["PayError"]
            </div>
        }

        @if (TempData["CancelSuccess"] != null)
        {
            <div class="notice success">
                <i class="fa-solid fa-circle-check"></i>
                @TempData["CancelSuccess"]
            </div>
        }

        @if (TempData["CancelError"] != null)
        {
            <div class="notice error">
                <i class="fa-solid fa-circle-exclamation"></i>
                @TempData["CancelError"]
            </div>
        }

        <section class="summary-grid">
            <div class="summary-card">
                <div class="summary-icon">
                    <i class="fa-solid fa-receipt"></i>
                </div>
                <div>
                    <div class="summary-label">คำสั่งซื้อทั้งหมดที่แสดง</div>
                    <div class="summary-value">@((pendingOrders.Count + paidOrders.Count).ToString("N0"))</div>
                </div>
            </div>

            <div class="summary-card">
                <div class="summary-icon orange">
                    <i class="fa-solid fa-clock"></i>
                </div>
                <div>
                    <div class="summary-label">รอชำระเงิน</div>
                    <div class="summary-value">@pendingOrders.Count.ToString("N0")</div>
                </div>
            </div>

            <div class="summary-card">
                <div class="summary-icon green">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <div>
                    <div class="summary-label">ชำระเงินแล้ว</div>
                    <div class="summary-value">@paidOrders.Count.ToString("N0")</div>
                </div>
            </div>
        </section>

        <!-- รายการที่รอชำระเงิน -->
        <section>
            <div class="section-heading">
                <h2 class="section-title">
                    <i class="fa-regular fa-hourglass-half"></i>
                    รอชำระเงิน
                </h2>
                <span class="section-count">@pendingOrders.Count</span>
            </div>

            @if (pendingOrders.Any())
            {
                <div class="orders-list">
                    @foreach (var order in pendingOrders)
                    {
                        var shortOrderId = order.Id.ToString().Length >= 8
                            ? order.Id.ToString().Substring(0, 8).ToUpperInvariant()
                            : order.Id.ToString().ToUpperInvariant();

                        <article class="order-card">
                            <div class="order-top">
                                <div>
                                    <div class="order-label">หมายเลขคำสั่งซื้อ</div>
                                    <div class="order-number">#@shortOrderId</div>
                                    <div class="order-date">
                                        <i class="fa-regular fa-calendar"></i>
                                        @order.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                </div>

                                <span class="status">
                                    <i class="fa-solid fa-clock"></i>
                                    รอชำระเงิน
                                </span>
                            </div>

                            <div class="order-body">
                                <div class="items-list">
                                    @if (order.Items != null && order.Items.Any())
                                    {
                                        @foreach (var item in order.Items)
                                        {
                                            <div class="order-item">
                                                <div class="item-info">
                                                    <div class="item-icon">
                                                        <i class="fa-solid fa-gamepad"></i>
                                                    </div>
                                                    <div>
                                                        <div class="item-name">
                                                            @(item.Product?.Name ?? "สินค้า")
                                                        </div>
                                                        <div class="item-quantity">
                                                            จำนวน @item.Quantity ชิ้น
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="item-price">
                                                    ฿@((item.Price * item.Quantity).ToString("N2"))
                                                </div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="item-quantity">ไม่มีรายละเอียดสินค้า</div>
                                    }
                                </div>
                            </div>

                            <div class="order-bottom">
                                <div>
                                    <div class="total-label">ยอดชำระทั้งหมด</div>
                                    <div class="total-price">
                                        ฿@order.TotalPrice.ToString("N2")
                                    </div>
                                </div>

                                <div class="order-actions">
                                    <button type="button"
                                            class="btn btn-purple"
                                            onclick="openPayment('@order.Id', @order.TotalPrice.ToString(System.Globalization.CultureInfo.InvariantCulture))">
                                        <i class="fa-solid fa-credit-card"></i>
                                        ชำระเงิน
                                    </button>

                                    <form class="cancel-order-form"
                                          action="@Url.Action("CancelOrder", "Cart")"
                                          method="post"
                                          onsubmit="return false;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@order.Id" />

                                        <button type="button"
                                                class="btn btn-cancel"
                                                onclick="openCancelPopup('@order.Id', '@shortOrderId', this)">
                                            <i class="fa-solid fa-trash-can"></i>
                                            ยกเลิกคำสั่งซื้อ
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="fa-solid fa-bag-shopping"></i>
                    </div>
                    <h3>ไม่มีคำสั่งซื้อที่รอชำระเงิน</h3>
                    <p>คำสั่งซื้อที่รอชำระเงินจะแสดงในส่วนนี้</p>
                </div>
            }
        </section>

        <!-- รายการที่ชำระเงินแล้ว (แบบกะทัดรัด) -->
        <section>
            <div class="section-heading">
                <h2 class="section-title">
                    <i class="fa-solid fa-circle-check"></i>
                    ชำระเงินแล้ว
                </h2>
                <span class="section-count">@paidOrders.Count</span>
            </div>

            @if (paidOrders.Any())
            {
                <div class="orders-list paid-list">
                    @foreach (var order in paidOrders)
                    {
                        var shortOrderId = order.Id.ToString().Length >= 8
                            ? order.Id.ToString().Substring(0, 8).ToUpperInvariant()
                            : order.Id.ToString().ToUpperInvariant();

                        <article class="order-card compact">
                            <div class="compact-row">
                                <div class="compact-id">
                                    <div class="order-number">#@shortOrderId</div>
                                    <div class="order-date">
                                        <i class="fa-regular fa-calendar"></i>
                                        @order.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                </div>

                                <div class="compact-items">
                                    @if (order.Items != null && order.Items.Any())
                                    {
                                        @foreach (var item in order.Items)
                                        {
                                            <div class="compact-item">
                                                <i class="fa-solid fa-gamepad"></i>
                                                <span class="compact-item-name">@(item.Product?.Name ?? "สินค้า")</span>
                                                <span class="compact-item-qty">x@(item.Quantity)</span>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="compact-item compact-item-empty">ไม่มีรายละเอียดสินค้า</div>
                                    }
                                </div>

                                <div class="compact-end">
                                    <div class="compact-total">฿@order.TotalPrice.ToString("N2")</div>
                                    <span class="status paid mini">
                                        <i class="fa-solid fa-circle-check"></i>
                                        ชำระเงินแล้ว
                                    </span>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="fa-solid fa-receipt"></i>
                    </div>
                    <h3>ยังไม่มีรายการที่ชำระเงินแล้ว</h3>
                    <p>เมื่อชำระเงินสำเร็จ รายการจะแสดงในส่วนนี้</p>
                </div>
            }
        </section>
    </main>

    <!-- Popup ยืนยันการยกเลิกคำสั่งซื้อ -->
    <div class="cancel-modal" id="cancelModal" aria-hidden="true">
        <div class="cancel-dialog"
             role="dialog"
             aria-modal="true"
             aria-labelledby="cancelTitle">

            <div class="cancel-icon">
                <i class="fa-solid fa-trash-can"></i>
            </div>

            <h2 class="cancel-title" id="cancelTitle">
                ยืนยันการยกเลิก?
            </h2>

            <p class="cancel-description">
                คุณต้องการยกเลิกคำสั่งซื้อนี้ใช่หรือไม่
                <br />
                โปรดตรวจสอบหมายเลขคำสั่งซื้อก่อนยืนยัน
            </p>

            <div class="cancel-order-info">
                หมายเลขคำสั่งซื้อ
                <strong id="cancelOrderNumber">-</strong>
            </div>

            <div class="cancel-actions">
                <button type="button"
                        class="btn btn-dark"
                        id="cancelKeepButton">
                    <i class="fa-solid fa-arrow-left"></i>
                    ไม่ยกเลิก
                </button>

                <button type="button"
                        class="btn btn-cancel-confirm"
                        id="cancelConfirmButton">
                    <i class="fa-solid fa-trash-can"></i>
                    ยืนยันยกเลิก
                </button>
            </div>
        </div>
    </div>

    <!-- Popup ชำระเงิน -->
    <div class="pm-overlay" id="payModal" aria-hidden="true">
        <div class="pm-box" role="dialog" aria-modal="true" aria-labelledby="payTitle">
            <div class="pm-head">
                <h2 id="payTitle">
                    <i class="fa-solid fa-shield-halved" style="color:#a78bfa"></i>
                    ชำระเงิน
                </h2>

                <button type="button" class="pm-close" id="closePayModal"
                        aria-label="ปิดหน้าต่างชำระเงิน">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="pm-amount">
                <small>ยอดที่ต้องชำระ</small>
                <strong id="payAmount">฿0.00</strong>
            </div>

            <label class="pm-label">เลือกวิธีชำระเงิน</label>

            <div class="pm-options">
                <button type="button" class="pm-option active" data-method="PromptPay">
                    <i class="fa-solid fa-qrcode"></i>
                    PromptPay QR
                </button>

                <button type="button" class="pm-option" data-method="Visa">
                    <i class="fa-brands fa-cc-visa"></i>
                    Visa
                </button>
            </div>

            <div class="pm-detail" id="paymentDetail"></div>

            <form id="payForm" action="@Url.Action("Pay", "Cart")" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="payOrderId" />
                <input type="hidden" name="method" id="payMethod" value="PromptPay" />

                <button type="submit" class="pm-submit" id="paySubmitButton">
                    <i class="fa-solid fa-lock"></i>
                    ยืนยันการชำระเงิน
                </button>
            </form>

            <p class="pm-note" style="margin:13px 0 0">
                หน้าจอนี้เป็นตัวอย่าง UI สำหรับโปรเจกต์
                ยังไม่ได้เชื่อมต่อระบบรับชำระเงินจริง
            </p>
        </div>
    </div>

    <script>
        (() => {
            // ---------------------------
            // Popup ยืนยันยกเลิกคำสั่งซื้อ
            // ---------------------------
            const cancelModal = document.getElementById("cancelModal");
            const cancelOrderNumber = document.getElementById("cancelOrderNumber");
            const cancelKeepButton = document.getElementById("cancelKeepButton");
            const cancelConfirmButton = document.getElementById("cancelConfirmButton");

            let selectedCancelForm = null;

            window.openCancelPopup = function (orderId, shortOrderId, button) {
                selectedCancelForm = button.closest("form");

                if (!selectedCancelForm) {
                    return;
                }

                cancelOrderNumber.textContent = "#" + shortOrderId;
                cancelConfirmButton.disabled = false;
                cancelKeepButton.disabled = false;

                cancelConfirmButton.innerHTML =
                    '<i class="fa-solid fa-trash-can"></i> ยืนยันยกเลิก';

                cancelModal.classList.add("open");
                cancelModal.setAttribute("aria-hidden", "false");
                document.body.style.overflow = "hidden";
                cancelKeepButton.focus();
            };

            function closeCancelPopup() {
                cancelModal.classList.remove("open");
                cancelModal.setAttribute("aria-hidden", "true");
                document.body.style.overflow = "";
                selectedCancelForm = null;
            }

            cancelKeepButton.addEventListener("click", closeCancelPopup);

            cancelModal.addEventListener("click", function (event) {
                if (event.target === cancelModal) {
                    closeCancelPopup();
                }
            });

            cancelConfirmButton.addEventListener("click", function () {
                if (!selectedCancelForm) {
                    return;
                }

                cancelConfirmButton.disabled = true;
                cancelKeepButton.disabled = true;

                cancelConfirmButton.innerHTML =
                    '<i class="fa-solid fa-spinner fa-spin"></i> กำลังยกเลิก...';

                // ส่ง POST ไปที่ CartController.CancelOrder
                selectedCancelForm.submit();
            });

            // ---------------------------
            // Popup ชำระเงิน
            // ---------------------------
            const payModal = document.getElementById("payModal");
            const closePayButton = document.getElementById("closePayModal");
            const payOrderId = document.getElementById("payOrderId");
            const payMethod = document.getElementById("payMethod");
            const payAmount = document.getElementById("payAmount");
            const paymentDetail = document.getElementById("paymentDetail");
            const payForm = document.getElementById("payForm");
            const paySubmitButton = document.getElementById("paySubmitButton");
            const methodButtons = document.querySelectorAll(".pm-option");

            let currentAmount = 0;

            function formatMoney(amount) {
                return Number(amount).toLocaleString("th-TH", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
            }

            function renderPaymentMethod(method) {
                payMethod.value = method;

                methodButtons.forEach(button => {
                    button.classList.toggle("active", button.dataset.method === method);
                });

                if (method === "PromptPay") {
                    // QR นี้เป็นตัวอย่างเท่านั้น ไม่ใช่ QR สำหรับรับเงินจริง
                    const qrText = "GAMEWORLD DEMO ORDER "
                        + payOrderId.value
                        + " AMOUNT "
                        + currentAmount.toFixed(2);

                    paymentDetail.innerHTML = `
                        <div style="text-align:center">
                            <div style="font-weight:700">PromptPay QR</div>
                            <img class="pm-qr"
                                 alt="QR ตัวอย่างสำหรับหน้าจอทดสอบ"
                                 src="https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=${encodeURIComponent(qrText)}" />
                            <div class="pm-note">
                                QR นี้เป็นเพียงภาพตัวอย่างสำหรับทดสอบหน้าตาเว็บไซต์
                                ไม่สามารถใช้ยืนยันการรับเงินจริงได้
                            </div>
                        </div>`;
                } else {
                    paymentDetail.innerHTML = `
                        <label class="pm-label" for="visaNumber">หมายเลขบัตร Visa</label>
                        <input class="pm-field"
                               id="visaNumber"
                               type="text"
                               inputmode="numeric"
                               autocomplete="cc-number"
                               maxlength="19"
                               placeholder="1234 5678 9012 3456"
                               required />

                        <label class="pm-label" for="visaName">ชื่อบนบัตร</label>
                        <input class="pm-field"
                               id="visaName"
                               type="text"
                               autocomplete="cc-name"
                               placeholder="ชื่อเจ้าของบัตร"
                               required />

                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
                            <div>
                                <label class="pm-label" for="visaExpiry">วันหมดอายุ</label>
                                <input class="pm-field"
                                       id="visaExpiry"
                                       type="text"
                                       inputmode="numeric"
                                       autocomplete="cc-exp"
                                       maxlength="5"
                                       placeholder="MM/YY"
                                       required />
                            </div>
                            <div>
                                <label class="pm-label" for="visaCvv">CVV</label>
                                <input class="pm-field"
                                       id="visaCvv"
                                       type="password"
                                       inputmode="numeric"
                                       autocomplete="cc-csc"
                                       maxlength="4"
                                       placeholder="123"
                                       required />
                            </div>
                        </div>

                        <div class="pm-note">
                            แบบฟอร์มบัตรนี้เป็นตัวอย่าง UI เท่านั้น
                            ไม่มีการส่งข้อมูลบัตรไปยังผู้ให้บริการชำระเงิน
                        </div>`;
                }
            }

            window.openPayment = function (orderId, amount) {
                payOrderId.value = orderId;
                currentAmount = Number(amount) || 0;
                payAmount.textContent = "฿" + formatMoney(currentAmount);

                paySubmitButton.disabled = false;
                paySubmitButton.innerHTML =
                    '<i class="fa-solid fa-lock"></i> ยืนยันการชำระเงิน';

                renderPaymentMethod("PromptPay");

                payModal.classList.add("open");
                payModal.setAttribute("aria-hidden", "false");
                document.body.style.overflow = "hidden";
            };

            function closePayment() {
                payModal.classList.remove("open");
                payModal.setAttribute("aria-hidden", "true");
                document.body.style.overflow = "";
            }

            closePayButton.addEventListener("click", closePayment);

            payModal.addEventListener("click", function (event) {
                if (event.target === payModal) {
                    closePayment();
                }
            });

            methodButtons.forEach(button => {
                button.addEventListener("click", function () {
                    renderPaymentMethod(this.dataset.method);
                });
            });

            // จัดรูปแบบช่องหมายเลขบัตร
            paymentDetail.addEventListener("input", function (event) {
                if (event.target.id === "visaNumber") {
                    let value = event.target.value.replace(/\D/g, "").slice(0, 16);
                    event.target.value = value.replace(/(.{4})/g, "$1 ").trim();
                }

                if (event.target.id === "visaExpiry") {
                    let value = event.target.value.replace(/\D/g, "").slice(0, 4);

                    if (value.length > 2) {
                        value = value.slice(0, 2) + "/" + value.slice(2);
                    }

                    event.target.value = value;
                }

                if (event.target.id === "visaCvv") {
                    event.target.value = event.target.value.replace(/\D/g, "").slice(0, 4);
                }
            });

            // ตรวจสอบฟอร์มตัวอย่างก่อนส่งไปยัง Cart/Pay
            payForm.addEventListener("submit", function (event) {
                if (payMethod.value === "Visa") {
                    const number = document.getElementById("visaNumber");
                    const name = document.getElementById("visaName");
                    const expiry = document.getElementById("visaExpiry");
                    const cvv = document.getElementById("visaCvv");

                    const digits = number.value.replace(/\D/g, "");

                    if (digits.length < 13 ||
                        !name.value.trim() ||
                        !/^\d{2}\/\d{2}$/.test(expiry.value) ||
                        !/^\d{3,4}$/.test(cvv.value)) {
                        event.preventDefault();
                        alert("กรุณาตรวจสอบข้อมูลในแบบฟอร์ม Visa ให้ครบถ้วน");
                        return;
                    }
                }

                paySubmitButton.disabled = true;
                paySubmitButton.innerHTML =
                    '<i class="fa-solid fa-spinner fa-spin"></i> กำลังดำเนินการ...';
            });

            document.addEventListener("keydown", function (event) {
                if (event.key === "Escape") {
                    if (cancelModal.classList.contains("open")) {
                        closeCancelPopup();
                    } else if (payModal.classList.contains("open")) {
                        closePayment();
                    }
                }
            });
        })();
    </script>
</body>
</html>
