@model Game.Models.Order

@{
    ViewData["Title"] = "สั่งซื้อสำเร็จ";

    var orderNo = Model.Id.ToString();
    if (orderNo.Length > 8)
    {
        orderNo = orderNo.Substring(0, 8);
    }
    orderNo = orderNo.ToUpper();

    var isPaid = Model.Status == "paid";
}

<style>
    :root {
        --os-bg: #080914;
        --os-card: #111323;
        --os-purple: #9b5cff;
        --os-purple-light: #c4a0ff;
        --os-cyan: #4de1c4;
        --os-muted: #9299b8;
        --os-border: rgba(168, 126, 255, .17);
    }

    .os-page,
    .os-page *,
    .pm-overlay,
    .pm-overlay * {
        box-sizing: border-box;
    }

    .os-page {
        display: flex;
        width: 100%;
        min-height: calc(100vh - 76px);
        align-items: center;
        justify-content: center;
        padding: 24px 18px 32px;
        color: #f8f8ff;
        background:
            radial-gradient(ellipse at 50% 0%, rgba(117, 63, 220, .16), transparent 55%);
        font-family: inherit;
    }

    .os-container {
        width: 100%;
        max-width: 920px;
        margin: 0 auto;
    }

    .os-top {
        text-align: center;
        margin-bottom: 16px;
    }

    .os-brand {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 14px;
        border: 1px solid var(--os-border);
        border-radius: 100px;
        background: rgba(124, 58, 237, .08);
        color: var(--os-purple-light);
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 2px;
    }

    .os-brand i {
        color: var(--os-purple);
    }

    .os-top h1 {
        margin: 10px 0 4px;
        font-size: clamp(22px, 4vw, 28px);
        line-height: 1.35;
        font-weight: 850;
        letter-spacing: -.7px;
    }

    .os-top p {
        margin: 0;
        color: var(--os-muted);
        font-size: 13px;
    }

    .os-card {
        position: relative;
        overflow: hidden;
        border: 1px solid var(--os-border);
        border-radius: 22px;
        background: linear-gradient(145deg, #151629, #0e101e 75%);
        box-shadow:
            0 22px 65px rgba(0, 0, 0, .32),
            0 0 45px rgba(124, 58, 237, .07);
    }

    .os-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 15%;
        right: 15%;
        height: 2px;
        background: linear-gradient(90deg, transparent, #a855f7, #4de1c4, transparent);
    }

    .os-layout {
        display: block;
    }

    /* HERO */

    .os-hero {
        padding: 20px 24px 18px;
        text-align: center;
        border-bottom: 1px solid rgba(255,255,255,.07);
    }

    .os-success-icon {
        position: relative;
        display: flex;
        width: 60px;
        height: 60px;
        align-items: center;
        justify-content: center;
        margin: 0 auto 12px;
        border: 1px solid rgba(77, 225, 196, .4);
        border-radius: 50%;
        background: radial-gradient(circle, rgba(77,225,196,.17), rgba(77,225,196,.025));
        box-shadow: 0 0 35px rgba(77,225,196,.10);
    }

    .os-success-icon i {
        color: var(--os-cyan);
        font-size: 24px;
    }

    .os-hero h2 {
        margin: 0 0 6px;
        font-size: 20px;
        font-weight: 800;
    }

    .os-hero p {
        margin: 0;
        color: var(--os-muted);
        font-size: 13px;
    }

    .os-order-no {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 12px;
        padding: 7px 14px;
        border: 1px dashed rgba(168,126,255,.35);
        border-radius: 10px;
        background: rgba(124,58,237,.08);
        color: #d7c5ff;
        font-size: 13px;
    }

    .os-order-no strong {
        color: #fff;
        letter-spacing: 1px;
    }

    .os-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-top: 10px;
        padding: 6px 13px;
        border-radius: 100px;
        font-size: 12px;
        font-weight: 750;
    }

    .os-status.pending {
        background: rgba(251,191,36,.10);
        border: 1px solid rgba(251,191,36,.2);
        color: #fcd34d;
    }

    .os-status.paid {
        background: rgba(77,225,196,.09);
        border: 1px solid rgba(77,225,196,.22);
        color: #6ff0d5;
    }

    /* BODY */

    .os-body {
        padding: 18px 22px 22px;
    }

    .os-section-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 10px;
    }

    .os-section-heading h3 {
        margin: 0;
        font-size: 15px;
        font-weight: 800;
    }

    .os-section-heading span {
        color: var(--os-muted);
        font-size: 12px;
    }

    .os-items {
        display: flex;
        flex-direction: column;
        max-height: 30vh;
        overflow-y: auto;
        padding-right: 4px;
    }

    .os-items::-webkit-scrollbar {
        width: 5px;
    }

    .os-items::-webkit-scrollbar-thumb {
        border-radius: 10px;
        background: rgba(168,126,255,.3);
    }

    .os-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 10px 0;
        border-bottom: 1px solid rgba(255,255,255,.065);
    }

    .os-item:first-child {
        padding-top: 0;
    }

    .os-item:last-child {
        border-bottom: 0;
    }

    .os-item-info {
        min-width: 0;
        flex: 1;
    }

    .os-item-name {
        overflow-wrap: anywhere;
        color: #f4f2ff;
        font-size: 14px;
        font-weight: 700;
    }

    .os-item-meta {
        display: block;
        margin-top: 4px;
        color: var(--os-muted);
        font-size: 12px;
    }

    .os-item-price {
        flex-shrink: 0;
        color: #fff;
        font-size: 14px;
        font-weight: 800;
        white-space: nowrap;
    }

    .os-summary {
        margin-top: 12px;
        padding: 14px 18px;
        border: 1px solid rgba(168,126,255,.13);
        border-radius: 15px;
        background: rgba(7,8,20,.48);
    }

    .os-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-bottom: 8px;
        color: #b7bdd5;
        font-size: 13px;
    }

    .os-row span:last-child {
        text-align: right;
        white-space: nowrap;
    }

    .os-row.disc {
        color: #65e9c9;
    }

    .os-row.total {
        margin: 0;
        padding-top: 12px;
        border-top: 1px solid rgba(255,255,255,.09);
        color: #fff;
        font-size: 14px;
        font-weight: 800;
    }

    .os-total-price {
        color: #c5a4ff;
        font-size: 22px;
        font-weight: 900;
        letter-spacing: -.5px;
    }

    .os-secure {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        margin-top: 12px;
        color: #7e86a6;
        font-size: 11px;
    }

    .os-secure i {
        color: var(--os-cyan);
    }

    .os-actions {
        display: flex;
        gap: 11px;
        margin-top: 16px;
    }

    .os-btn {
        display: inline-flex;
        min-height: 44px;
        flex: 1;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 10px 16px;
        border: 1px solid transparent;
        border-radius: 12px;
        text-decoration: none !important;
        font-size: 13px;
        font-weight: 800;
        cursor: pointer;
        transition: transform .2s, box-shadow .2s, background .2s;
    }

    .os-btn:hover {
        transform: translateY(-2px);
    }

    .os-btn-primary {
        background: linear-gradient(110deg, #7c3aed, #a855f7);
        color: #fff !important;
        box-shadow: 0 7px 22px rgba(124,58,237,.2);
    }

    .os-btn-primary:hover {
        color: #fff !important;
        box-shadow: 0 9px 28px rgba(124,58,237,.35);
    }

    .os-btn-pay {
        background: linear-gradient(110deg, #4de1c4, #8cf5df);
        color: #073a32 !important;
        box-shadow: 0 7px 22px rgba(77,225,196,.12);
    }

    .os-btn-pay:hover {
        color: #073a32 !important;
        box-shadow: 0 9px 28px rgba(77,225,196,.24);
    }

    .os-btn-ghost {
        border-color: rgba(255,255,255,.1);
        background: rgba(255,255,255,.035);
        color: #d0d4e9 !important;
    }

    .os-btn-ghost:hover {
        background: rgba(255,255,255,.075);
    }

    /* Desktop: 2 columns */

    @@media (min-width: 900px) {
        .os-container {
            max-width: 1000px;
        }

        .os-layout {
            display: grid;
            grid-template-columns: 340px 1fr;
            align-items: stretch;
        }

        .os-hero {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border-bottom: 0;
            border-right: 1px solid rgba(255,255,255,.07);
        }

        .os-body {
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 24px 28px;
        }
    }

    /* Short screens (laptops) */

    @@media (max-height: 800px) and (min-width: 900px) {
        .os-page {
            padding: 16px 18px 20px;
        }

        .os-top {
            margin-bottom: 12px;
        }

        .os-top p,
        .os-hero p,
        .os-secure {
            display: none;
        }

        .os-items {
            max-height: 24vh;
        }
    }

    @@media (max-width: 520px) {
        .os-page {
            padding: 20px 12px 32px;
        }

        .os-hero {
            padding: 20px 15px 18px;
        }

        .os-body {
            padding: 16px 15px;
        }

        .os-actions {
            flex-direction: column;
        }

        .os-btn {
            width: 100%;
        }

        .os-summary {
            padding: 14px 13px;
        }

        .os-total-price {
            font-size: 20px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .os-btn {
            transition: none;
        }
    }

    /* =========================================================
       Popup ชำระเงิน (สไตล์เดียวกับหน้า MyOrders)
       ========================================================= */

    .pm-overlay {
        --border: rgba(167, 139, 250, .17);
        --muted: #9999b5;
        --purple: #8b5cf6;
        --purple-light: #a78bfa;

        position: fixed;
        inset: 0;
        z-index: 100000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 18px;
        background: rgba(2, 6, 23, .84);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: .25s ease;
    }

    .pm-overlay.open {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
    }

    .pm-box {
        width: 100%;
        max-width: 480px;
        max-height: 90vh;
        overflow-y: auto;
        padding: 25px;
        border: 1px solid var(--border);
        border-radius: 22px;
        background: linear-gradient(145deg, #191629, #0d1220);
        color: #f5f3ff;
        box-shadow: 0 20px 70px rgba(0, 0, 0, .5);
        transform: translateY(12px) scale(.98);
        transition: .25s ease;
    }

    .pm-overlay.open .pm-box {
        transform: translateY(0) scale(1);
    }

    .pm-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 20px;
    }

    .pm-head h2 {
        margin: 0;
        font-size: 21px;
    }

    .pm-close {
        display: grid;
        place-items: center;
        width: 36px;
        height: 36px;
        border: 1px solid var(--border);
        border-radius: 10px;
        color: #cbd5e1;
        background: rgba(148, 163, 184, .08);
        cursor: pointer;
    }

    .pm-amount {
        margin-bottom: 20px;
        padding: 17px;
        border: 1px solid var(--border);
        border-radius: 14px;
        background: rgba(139, 92, 246, .08);
    }

    .pm-amount small {
        color: var(--muted);
    }

    .pm-amount strong {
        display: block;
        margin-top: 4px;
        color: #c4b5fd;
        font-size: 28px;
    }

    .pm-label {
        display: block;
        margin-bottom: 9px;
        color: #d1d5e8;
        font-size: 13px;
    }

    .pm-options {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-bottom: 18px;
    }

    .pm-option {
        padding: 15px 10px;
        border: 1px solid var(--border);
        border-radius: 13px;
        color: #e5e7eb;
        background: rgba(148, 163, 184, .04);
        font: inherit;
        text-align: center;
        cursor: pointer;
    }

    .pm-option.active {
        border-color: var(--purple);
        background: rgba(139, 92, 246, .12);
        box-shadow: 0 0 16px rgba(139, 92, 246, .09);
    }

    .pm-option i {
        display: block;
        margin-bottom: 8px;
        color: var(--purple-light);
        font-size: 23px;
    }

    .pm-detail {
        margin-bottom: 18px;
        padding: 17px;
        border: 1px solid rgba(167, 139, 250, .13);
        border-radius: 14px;
        background: rgba(8, 8, 16, .45);
    }

    .pm-qr {
        display: block;
        width: 190px;
        height: 190px;
        max-width: 100%;
        margin: 12px auto;
        border-radius: 12px;
        background: white;
        object-fit: contain;
    }

    .pm-note {
        color: var(--muted);
        font-size: 12px;
        line-height: 1.7;
        text-align: center;
    }

    .pm-field {
        width: 100%;
        min-height: 44px;
        margin-bottom: 12px;
        padding: 10px 12px;
        border: 1px solid rgba(167, 139, 250, .2);
        border-radius: 10px;
        outline: none;
        color: white;
        background: #0c0c18;
        font: inherit;
    }

    .pm-field:focus {
        border-color: var(--purple);
    }

    .pm-submit {
        width: 100%;
        min-height: 47px;
        border: 0;
        border-radius: 12px;
        color: white;
        background: linear-gradient(135deg, #8b5cf6, #6d28d9);
        font: inherit;
        font-weight: 700;
        cursor: pointer;
    }

    .pm-submit:hover {
        filter: brightness(1.1);
    }

    .pm-submit:disabled {
        opacity: .6;
        cursor: not-allowed;
    }

    @@media (max-width: 400px) {
        .pm-box {
            padding: 18px;
        }
    }
</style>

<div class="os-page">
    <div class="os-container">

        <div class="os-top">
            <div class="os-brand">
                <i class="fa-solid fa-gamepad"></i>
                GAMEWORLD
            </div>
            <h1>คำสั่งซื้อของคุณ</h1>
            <p>ขอบคุณที่เลือกซื้อเกมกับเรา</p>
        </div>

        <div class="os-card">
            <div class="os-layout">

                <!-- LEFT : STATUS -->
                <div class="os-hero">
                    <div class="os-success-icon">
                        <i class="fa-solid @(isPaid ? "fa-check" : "fa-receipt")"></i>
                    </div>

                    <h2>@(isPaid ? "ชำระเงินสำเร็จแล้ว!" : "สร้างคำสั่งซื้อเรียบร้อย!")</h2>

                    <p>
                        @(isPaid
                            ? "ขอบคุณสำหรับการสั่งซื้อ ขอให้สนุกกับเกมของคุณ"
                            : "ตรวจสอบรายการให้เรียบร้อย แล้วเลือกวิธีชำระเงินได้เลย")
                    </p>

                    <div>
                        <div class="os-order-no">
                            <i class="fa-solid fa-hashtag"></i>
                            ORDER
                            <strong>@orderNo</strong>
                        </div>
                    </div>

                    <div>
                        <span class="os-status @(isPaid ? "paid" : "pending")">
                            <i class="fa-solid @(isPaid ? "fa-circle-check" : "fa-clock")"></i>
                            @(isPaid ? "ชำระเงินแล้ว" : "รอชำระเงิน")
                        </span>
                    </div>
                </div>

                <!-- RIGHT : ITEMS + SUMMARY + ACTIONS -->
                <div class="os-body">

                    <div class="os-section-heading">
                        <h3>
                            <i class="fa-solid fa-bag-shopping"
                               style="color:#b58aff;margin-right:7px"></i>
                            รายการสินค้า
                        </h3>
                        <span>@(Model.Items?.Count() ?? 0) รายการ</span>
                    </div>

                    <div class="os-items">
                        @if (Model.Items != null)
                        {
                            foreach (var item in Model.Items)
                            {
                                <div class="os-item">
                                    <div class="os-item-info">
                                        <div class="os-item-name">
                                            @(item.Product?.Name ?? "สินค้า")
                                        </div>
                                        <small class="os-item-meta">
                                            ฿@item.Price.ToString("N2")
                                            <span style="padding:0 4px">×</span>
                                            @item.Quantity รายการ
                                        </small>
                                    </div>

                                    <div class="os-item-price">
                                        ฿@((item.Price * item.Quantity).ToString("N2"))
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <div class="os-summary">
                        <div class="os-row">
                            <span>ยอดรวมสินค้า</span>
                            <span>฿@Model.Subtotal.ToString("N2")</span>
                        </div>

                        @if (Model.DiscountAmount > 0)
                        {
                            <div class="os-row disc">
                                <span>
                                    <i class="fa-solid fa-ticket"
                                       style="margin-right:5px"></i>
                                    ส่วนลด (@Model.CouponCode)
                                </span>
                                <span>−฿@Model.DiscountAmount.ToString("N2")</span>
                            </div>
                        }

                        <div class="os-row total">
                            <span>ยอดชำระสุทธิ</span>
                            <span class="os-total-price">
                                ฿@Model.TotalPrice.ToString("N2")
                            </span>
                        </div>
                    </div>

                    <div class="os-secure">
                        <i class="fa-solid fa-shield-halved"></i>
                        กรุณาตรวจสอบสถานะการชำระเงินในประวัติคำสั่งซื้อ
                    </div>

                    <div class="os-actions">
                        @if (Model.Status == "pending")
                        {
                            <button type="button"
                                    class="os-btn os-btn-pay"
                                    onclick="openPayModal('@Model.Id', @Model.TotalPrice.ToString(System.Globalization.CultureInfo.InvariantCulture))">
                                <i class="fa-solid fa-credit-card"></i>
                                ชำระเงินตอนนี้
                            </button>
                        }
                        else
                        {
                            <a class="os-btn os-btn-primary"
                               asp-controller="Product"
                               asp-action="Index">
                                <i class="fa-solid fa-gamepad"></i>
                                เลือกซื้อเกมต่อ
                            </a>
                        }

                        <a class="os-btn os-btn-ghost"
                           asp-controller="Home"
                           asp-action="Index">
                            <i class="fa-solid fa-house"></i>
                            กลับหน้าแรก
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@if (Model.Status == "pending")
{
    <!-- Popup ชำระเงิน (ใช้งานได้จริง ส่ง POST ไปที่ Cart/Pay เหมือนหน้า MyOrders) -->
    <div class="pm-overlay" id="payModal" aria-hidden="true">
        <div class="pm-box" role="dialog" aria-modal="true" aria-labelledby="payTitle">
            <div class="pm-head">
                <h2 id="payTitle">
                    <i class="fa-solid fa-shield-halved" style="color:#a78bfa"></i>
                    ชำระเงิน
                </h2>

                <button type="button" class="pm-close" id="closePayModal"
                        aria-label="ปิดหน้าต่างชำระเงิน">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="pm-amount">
                <small>ยอดที่ต้องชำระ</small>
                <strong id="payAmount">฿0.00</strong>
            </div>

            <label class="pm-label">เลือกวิธีชำระเงิน</label>

            <div class="pm-options">
                <button type="button" class="pm-option active" data-method="PromptPay">
                    <i class="fa-solid fa-qrcode"></i>
                    PromptPay QR
                </button>

                <button type="button" class="pm-option" data-method="Visa">
                    <i class="fa-brands fa-cc-visa"></i>
                    Visa
                </button>
            </div>

            <div class="pm-detail" id="paymentDetail"></div>

            <form id="payForm" action="@Url.Action("Pay", "Cart")" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="payOrderId" />
                <input type="hidden" name="method" id="payMethod" value="PromptPay" />

                <button type="submit" class="pm-submit" id="paySubmitButton">
                    <i class="fa-solid fa-lock"></i>
                    ยืนยันการชำระเงิน
                </button>
            </form>

            <p class="pm-note" style="margin:13px 0 0">
                หน้าจอนี้เป็นตัวอย่าง UI สำหรับโปรเจกต์
                ยังไม่ได้เชื่อมต่อระบบรับชำระเงินจริง
            </p>
        </div>
    </div>

    <script>
        (() => {
            const payModal = document.getElementById("payModal");
            const closePayButton = document.getElementById("closePayModal");
            const payOrderId = document.getElementById("payOrderId");
            const payMethod = document.getElementById("payMethod");
            const payAmount = document.getElementById("payAmount");
            const paymentDetail = document.getElementById("paymentDetail");
            const payForm = document.getElementById("payForm");
            const paySubmitButton = document.getElementById("paySubmitButton");
            const methodButtons = document.querySelectorAll(".pm-option");

            if (!payModal || !payForm) return;

            let currentAmount = 0;

            function formatMoney(amount) {
                return Number(amount).toLocaleString("th-TH", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
            }

            function renderPaymentMethod(method) {
                payMethod.value = method;

                methodButtons.forEach(button => {
                    button.classList.toggle("active", button.dataset.method === method);
                });

                if (method === "PromptPay") {
                    // QR นี้เป็นตัวอย่างเท่านั้น ไม่ใช่ QR สำหรับรับเงินจริง
                    const qrText = "GAMEWORLD DEMO ORDER "
                        + payOrderId.value
                        + " AMOUNT "
                        + currentAmount.toFixed(2);

                    paymentDetail.innerHTML = `
                        <div style="text-align:center">
                            <div style="font-weight:700">PromptPay QR</div>
                            <img class="pm-qr"
                                 alt="QR ตัวอย่างสำหรับหน้าจอทดสอบ"
                                 src="https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=${encodeURIComponent(qrText)}" />
                            <div class="pm-note">
                                QR นี้เป็นเพียงภาพตัวอย่างสำหรับทดสอบหน้าตาเว็บไซต์
                                ไม่สามารถใช้ยืนยันการรับเงินจริงได้
                            </div>
                        </div>`;
                } else {
                    paymentDetail.innerHTML = `
                        <label class="pm-label" for="visaNumber">หมายเลขบัตร Visa</label>
                        <input class="pm-field"
                               id="visaNumber"
                               type="text"
                               inputmode="numeric"
                               autocomplete="cc-number"
                               maxlength="19"
                               placeholder="1234 5678 9012 3456"
                               required />

                        <label class="pm-label" for="visaName">ชื่อบนบัตร</label>
                        <input class="pm-field"
                               id="visaName"
                               type="text"
                               autocomplete="cc-name"
                               placeholder="ชื่อเจ้าของบัตร"
                               required />

                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
                            <div>
                                <label class="pm-label" for="visaExpiry">วันหมดอายุ</label>
                                <input class="pm-field"
                                       id="visaExpiry"
                                       type="text"
                                       inputmode="numeric"
                                       autocomplete="cc-exp"
                                       maxlength="5"
                                       placeholder="MM/YY"
                                       required />
                            </div>
                            <div>
                                <label class="pm-label" for="visaCvv">CVV</label>
                                <input class="pm-field"
                                       id="visaCvv"
                                       type="password"
                                       inputmode="numeric"
                                       autocomplete="cc-csc"
                                       maxlength="4"
                                       placeholder="123"
                                       required />
                            </div>
                        </div>

                        <div class="pm-note">
                            แบบฟอร์มบัตรนี้เป็นตัวอย่าง UI เท่านั้น
                            ไม่มีการส่งข้อมูลบัตรไปยังผู้ให้บริการชำระเงิน
                        </div>`;
                }
            }

            // เรียกจากปุ่ม "ชำระเงินตอนนี้": openPayModal(orderId, amount)
            window.openPayModal = function (orderId, amount) {
                payOrderId.value = orderId;
                currentAmount = Number(amount) || 0;
                payAmount.textContent = "฿" + formatMoney(currentAmount);

                paySubmitButton.disabled = false;
                paySubmitButton.innerHTML =
                    '<i class="fa-solid fa-lock"></i> ยืนยันการชำระเงิน';

                renderPaymentMethod("PromptPay");

                payModal.classList.add("open");
                payModal.setAttribute("aria-hidden", "false");
                document.body.style.overflow = "hidden";
            };

            function closePayment() {
                payModal.classList.remove("open");
                payModal.setAttribute("aria-hidden", "true");
                document.body.style.overflow = "";
            }

            closePayButton.addEventListener("click", closePayment);

            payModal.addEventListener("click", function (event) {
                if (event.target === payModal) {
                    closePayment();
                }
            });

            methodButtons.forEach(button => {
                button.addEventListener("click", function () {
                    renderPaymentMethod(this.dataset.method);
                });
            });

            // จัดรูปแบบช่องหมายเลขบัตร
            paymentDetail.addEventListener("input", function (event) {
                if (event.target.id === "visaNumber") {
                    let value = event.target.value.replace(/\D/g, "").slice(0, 16);
                    event.target.value = value.replace(/(.{4})/g, "$1 ").trim();
                }

                if (event.target.id === "visaExpiry") {
                    let value = event.target.value.replace(/\D/g, "").slice(0, 4);

                    if (value.length > 2) {
                        value = value.slice(0, 2) + "/" + value.slice(2);
                    }

                    event.target.value = value;
                }

                if (event.target.id === "visaCvv") {
                    event.target.value = event.target.value.replace(/\D/g, "").slice(0, 4);
                }
            });

            // ตรวจสอบฟอร์มก่อนส่งไปยัง Cart/Pay (ข้อมูลบัตรอยู่นอก form จึงไม่ถูกส่งไปเซิร์ฟเวอร์)
            payForm.addEventListener("submit", function (event) {
                if (payMethod.value === "Visa") {
                    const number = document.getElementById("visaNumber");
                    const name = document.getElementById("visaName");
                    const expiry = document.getElementById("visaExpiry");
                    const cvv = document.getElementById("visaCvv");

                    const digits = number.value.replace(/\D/g, "");

                    if (digits.length < 13 ||
                        !name.value.trim() ||
                        !/^\d{2}\/\d{2}$/.test(expiry.value) ||
                        !/^\d{3,4}$/.test(cvv.value)) {
                        event.preventDefault();
                        alert("กรุณาตรวจสอบข้อมูลในแบบฟอร์ม Visa ให้ครบถ้วน");
                        return;
                    }
                }

                paySubmitButton.disabled = true;
                paySubmitButton.innerHTML =
                    '<i class="fa-solid fa-spinner fa-spin"></i> กำลังดำเนินการ...';
            });

            document.addEventListener("keydown", function (event) {
                if (event.key === "Escape" && payModal.classList.contains("open")) {
                    closePayment();
                }
            });
        })();
    </script>
}
