@model Game.Models.UserFormViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "เพิ่มผู้ใช้ใหม่";
}

<style>
    .uf-page{
        box-sizing:border-box;
        width:100%;
        max-width:1200px;
        margin:0 auto;
        padding:48px 32px 80px;
    }
    .uf-back{
        display:inline-flex;align-items:center;gap:8px;
        margin-bottom:20px;
        color:#c4b5fd;font-size:14px;font-weight:600;text-decoration:none;
    }
    .uf-back:hover{color:#fff}
    .uf-back-wrap{max-width:560px;margin:0 auto}

    @@media (max-width:640px){
        .uf-page{padding:24px 16px 48px}
    }
</style>

<div class="uf-page">
    <div class="uf-back-wrap">
        <a class="uf-back" asp-action="Index">
            <i class="fa-solid fa-arrow-left"></i> กลับไปรายชื่อผู้ใช้
        </a>
    </div>

    <form method="post" asp-action="Create">
        <partial name="_Form" model="Model" />
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}