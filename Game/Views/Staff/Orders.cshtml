@model IEnumerable<Game.Models.Order>
@{
    ViewData["Title"] = "จัดการออเดอร์";
    Layout = null;
    var selected = ViewBag.SelectedStatus as string ?? "";
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Orders | WHATGAME</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body class="bg-[#090c18] text-slate-100">
<div class="min-h-screen lg:flex">

    <!-- Overlay (มือถือ/แท็บเล็ต) -->
    <div id="sidebarOverlay"
         class="fixed inset-0 z-40 hidden bg-black/60 backdrop-blur-sm lg:hidden"></div>

    <!-- Sidebar: drawer บนจอเล็ก, อยู่ข้างๆ บนจอ lg ขึ้นไป -->
    <div id="sidebarWrap"
         class="fixed inset-y-0 left-0 z-50 w-72 max-w-[85vw] -translate-x-full overflow-y-auto
                transition-transform duration-300
                lg:sticky lg:top-0 lg:z-auto lg:h-screen lg:w-auto lg:max-w-none lg:translate-x-0">
        <partial name="_Sidebar" />
    </div>

    <div class="min-w-0 flex-1">

        <!-- Top bar (เฉพาะมือถือ/แท็บเล็ต) -->
        <div class="sticky top-0 z-30 flex items-center justify-between border-b border-white/10
                    bg-[#090c18]/90 px-4 py-3 backdrop-blur lg:hidden">
            <span class="text-sm font-black tracking-wider">
                WHAT<span class="text-purple-400">GAME</span>
            </span>
            <button id="sidebarToggle" type="button" aria-label="เปิดเมนู"
                    class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10
                           bg-white/5 text-slate-200 hover:bg-white/10">
                <i class="fa-solid fa-bars"></i>
            </button>
        </div>

        <main class="p-4 sm:p-6 lg:p-8">
            <header class="mb-6 sm:mb-7">
                <p class="text-[10px] font-bold tracking-widest text-purple-400 sm:text-xs">ORDER MANAGEMENT</p>
                <h1 class="mt-2 text-2xl font-black sm:text-3xl">จัดการออเดอร์</h1>
                <p class="mt-2 text-sm text-slate-400">ตรวจสอบรายการและสถานะการชำระเงิน</p>
            </header>

            <!-- ฟอร์มกรอง: มือถือเต็มความกว้าง, จอใหญ่เรียงแนวนอน -->
            <form method="get" class="mb-5 flex flex-col gap-3 sm:flex-row">
                <select name="status"
                        class="w-full rounded-xl border border-white/10 bg-[#121729] px-4 py-3 text-sm sm:w-auto sm:min-w-[200px]">
                    <option value="">ทุกสถานะ</option>
                    <option value="pending" selected="@(selected == "pending")">รอชำระเงิน</option>
                    <option value="paid" selected="@(selected == "paid")">ชำระเงินแล้ว</option>
                </select>
                <button class="w-full rounded-xl bg-purple-600 px-5 py-3 text-sm font-bold hover:bg-purple-500 sm:w-auto">
                    <i class="fa-solid fa-filter mr-2"></i>กรองรายการ
                </button>
            </form>

            <!-- มือถือ: การ์ดเรียงลงมา (ซ่อนที่ md ขึ้นไป) -->
            <div class="space-y-3 md:hidden">
                @foreach (var order in Model)
                {
                    <div class="rounded-2xl border border-white/10 bg-[#121729] p-4">
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <p class="truncate font-bold">#@order.Id</p>
                                <p class="mt-1 text-xs text-slate-500">
                                    @order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </p>
                            </div>
                            <span class="shrink-0 rounded-full px-3 py-1 text-xs font-bold @(order.Status == "paid" ? "bg-green-500/10 text-green-300" : "bg-yellow-500/10 text-yellow-300")">
                                @(order.Status == "paid" ? "ชำระแล้ว" : order.Status == "pending" ? "รอชำระเงิน" : order.Status)
                            </span>
                        </div>

                        @if (order.Items != null && order.Items.Any())
                        {
                            <div class="mt-3 space-y-1 border-t border-white/5 pt-3 text-sm">
                                @foreach (var item in order.Items)
                                {
                                    <div class="flex justify-between gap-3">
                                        <span class="min-w-0 truncate">@(item.Product?.Name ?? "สินค้า")</span>
                                        <span class="shrink-0 text-slate-500">× @item.Quantity</span>
                                    </div>
                                }
                            </div>
                        }

                        <div class="mt-3 flex items-center justify-between border-t border-white/5 pt-3">
                            <span class="text-xs text-slate-400">ยอดสุทธิ</span>
                            <span class="font-black">฿@order.TotalPrice.ToString("N2")</span>
                        </div>
                    </div>
                }
                @if (!Model.Any())
                {
                    <div class="rounded-2xl border border-white/10 bg-[#121729] p-10 text-center text-sm text-slate-500">
                        ไม่พบรายการออเดอร์
                    </div>
                }
            </div>

            <!-- แท็บเล็ต/เดสก์ท็อป: ตาราง (ซ่อนบนมือถือ) -->
            <div class="hidden overflow-x-auto rounded-2xl border border-white/10 bg-[#121729] md:block">
                <table class="w-full text-left text-sm">
                    <thead class="bg-white/5 text-xs uppercase text-slate-400">
                        <tr>
                            <th class="p-4">ออเดอร์</th>
                            <th class="p-4">วันที่</th>
                            <th class="p-4">สินค้า</th>
                            <th class="p-4">ยอดสุทธิ</th>
                            <th class="p-4">สถานะ</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-white/5">
                    @foreach (var order in Model)
                    {
                        <tr class="hover:bg-purple-500/5">
                            <td class="p-4 font-bold">#@order.Id</td>
                            <td class="whitespace-nowrap p-4 text-slate-400">
                                @order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class="max-w-xs p-4">
                                @if (order.Items != null && order.Items.Any())
                                {
                                    foreach (var item in order.Items)
                                    {
                                        <div class="mb-1">
                                            @(item.Product?.Name ?? "สินค้า")
                                            <span class="text-slate-500">× @item.Quantity</span>
                                        </div>
                                    }
                                }
                            </td>
                            <td class="whitespace-nowrap p-4 font-bold">฿@order.TotalPrice.ToString("N2")</td>
                            <td class="p-4">
                                <span class="whitespace-nowrap rounded-full px-3 py-1 text-xs font-bold @(order.Status == "paid" ? "bg-green-500/10 text-green-300" : "bg-yellow-500/10 text-yellow-300")">
                                    @(order.Status == "paid" ? "ชำระแล้ว" : order.Status == "pending" ? "รอชำระเงิน" : order.Status)
                                </span>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5" class="p-10 text-center text-slate-500">ไม่พบรายการออเดอร์</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </main>
    </div>
</div>

<script>
    (function () {
        const wrap = document.getElementById('sidebarWrap');
        const overlay = document.getElementById('sidebarOverlay');
        const toggle = document.getElementById('sidebarToggle');

        function open() {
            wrap.classList.remove('-translate-x-full');
            overlay.classList.remove('hidden');
            document.body.classList.add('overflow-hidden');
        }
        function close() {
            wrap.classList.add('-translate-x-full');
            overlay.classList.add('hidden');
            document.body.classList.remove('overflow-hidden');
        }

        toggle.addEventListener('click', open);
        overlay.addEventListener('click', close);
        document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });
        wrap.addEventListener('click', e => { if (e.target.closest('a')) close(); });
        window.matchMedia('(min-width:1024px)').addEventListener('change', e => { if (e.matches) close(); });
    })();
</script>
</body>
</html>