@model IEnumerable<Game.Models.User>
@{
    ViewData["Title"] = "ข้อมูลลูกค้า";
    Layout = null;
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Customers | WHATGAME</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body class="bg-[#090c18] text-slate-100">
<div class="min-h-screen lg:flex">

    <!-- Overlay (มือถือ/แท็บเล็ต) -->
    <div id="sidebarOverlay"
         class="fixed inset-0 z-40 hidden bg-black/60 backdrop-blur-sm lg:hidden"></div>

    <!-- Sidebar: drawer บนจอเล็ก, อยู่ข้างๆ บนจอ lg ขึ้นไป -->
    <div id="sidebarWrap"
         class="fixed inset-y-0 left-0 z-50 w-72 max-w-[85vw] -translate-x-full overflow-y-auto
                transition-transform duration-300
                lg:sticky lg:top-0 lg:z-auto lg:h-screen lg:w-auto lg:max-w-none lg:translate-x-0">
        <partial name="_Sidebar" />
    </div>

    <div class="min-w-0 flex-1">

        <!-- Top bar (เฉพาะมือถือ/แท็บเล็ต) -->
        <div class="sticky top-0 z-30 flex items-center justify-between border-b border-white/10
                    bg-[#090c18]/90 px-4 py-3 backdrop-blur lg:hidden">
            <span class="text-sm font-black tracking-wider">
                WHAT<span class="text-purple-400">GAME</span>
            </span>
            <button id="sidebarToggle" type="button" aria-label="เปิดเมนู"
                    class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10
                           bg-white/5 text-slate-200 hover:bg-white/10">
                <i class="fa-solid fa-bars"></i>
            </button>
        </div>

        <main class="p-4 sm:p-6 lg:p-8">
            <header class="mb-6 sm:mb-7">
                <p class="text-[10px] font-bold tracking-widest text-purple-400 sm:text-xs">CUSTOMER DIRECTORY</p>
                <h1 class="mt-2 text-2xl font-black sm:text-3xl">ข้อมูลลูกค้า</h1>
                <p class="mt-2 text-sm text-slate-400">รายชื่อบัญชีลูกค้าใน WHATGAME</p>
            </header>

            <div class="mb-5 rounded-2xl border border-purple-500/20 bg-[#121729] p-4 sm:p-5">
                <p class="text-sm text-slate-400">จำนวนลูกค้าที่ตรงกับการค้นหา</p>
                <p class="mt-2 text-2xl font-black text-purple-300 sm:text-3xl">@Model.Count()</p>
            </div>

            <!-- ฟอร์มค้นหา: มือถือเรียงลง, จอ sm ขึ้นไปเรียงแนวนอน -->
            <form method="get" class="mb-5 flex flex-col gap-3 sm:flex-row">
                <input name="search" value="@ViewBag.Search" placeholder="ค้นหาอีเมลลูกค้า..."
                       class="w-full min-w-0 rounded-xl border border-white/10 bg-[#121729] px-4 py-3 text-base outline-none focus:border-purple-500 sm:flex-1 sm:text-sm" />
                <button class="w-full rounded-xl bg-purple-600 px-5 py-3 text-sm font-bold hover:bg-purple-500 sm:w-auto">
                    <i class="fa-solid fa-magnifying-glass mr-2"></i>ค้นหา
                </button>
            </form>

            <!-- มือถือ: รายการเรียงลงมา (ซ่อนที่ md ขึ้นไป) -->
            <div class="space-y-3 md:hidden">
                @foreach (var customer in Model)
                {
                    <div class="flex items-center justify-between gap-3 rounded-2xl border border-white/10 bg-[#121729] p-4">
                        <div class="flex min-w-0 items-center gap-3">
                            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-purple-500/15 font-bold text-purple-300">
                                @(string.IsNullOrEmpty(customer.Email) ? "?" : customer.Email.Substring(0, 1).ToUpper())
                            </div>
                            <span class="min-w-0 truncate text-sm font-medium">@customer.Email</span>
                        </div>
                        <span class="shrink-0 rounded-full bg-blue-500/10 px-3 py-1 text-xs text-blue-300">
                            @customer.Role
                        </span>
                    </div>
                }
                @if (!Model.Any())
                {
                    <div class="rounded-2xl border border-white/10 bg-[#121729] p-10 text-center text-sm text-slate-500">
                        ไม่พบข้อมูลลูกค้า
                    </div>
                }
            </div>

            <!-- แท็บเล็ต/เดสก์ท็อป: ตาราง (ซ่อนบนมือถือ) -->
            <div class="hidden overflow-x-auto rounded-2xl border border-white/10 bg-[#121729] md:block">
                <table class="w-full text-left text-sm">
                    <thead class="bg-white/5 text-xs text-slate-400">
                        <tr>
                            <th class="p-4">บัญชีลูกค้า</th>
                            <th class="p-4">Role</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-white/5">
                    @foreach (var customer in Model)
                    {
                        <tr class="hover:bg-purple-500/5">
                            <td class="p-4">
                                <div class="flex items-center gap-3">
                                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-purple-500/15 font-bold text-purple-300">
                                        @(string.IsNullOrEmpty(customer.Email) ? "?" : customer.Email.Substring(0, 1).ToUpper())
                                    </div>
                                    <span class="font-medium">@customer.Email</span>
                                </div>
                            </td>
                            <td class="p-4">
                                <span class="whitespace-nowrap rounded-full bg-blue-500/10 px-3 py-1 text-xs text-blue-300">
                                    @customer.Role
                                </span>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="2" class="p-10 text-center text-slate-500">ไม่พบข้อมูลลูกค้า</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </main>
    </div>
</div>

<script>
    (function () {
        const wrap = document.getElementById('sidebarWrap');
        const overlay = document.getElementById('sidebarOverlay');
        const toggle = document.getElementById('sidebarToggle');

        function open() {
            wrap.classList.remove('-translate-x-full');
            overlay.classList.remove('hidden');
            document.body.classList.add('overflow-hidden');
        }
        function close() {
            wrap.classList.add('-translate-x-full');
            overlay.classList.add('hidden');
            document.body.classList.remove('overflow-hidden');
        }

        toggle.addEventListener('click', open);
        overlay.addEventListener('click', close);
        document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });
        wrap.addEventListener('click', e => { if (e.target.closest('a')) close(); });
        window.matchMedia('(min-width:1024px)').addEventListener('change', e => { if (e.matches) close(); });
    })();
</script>
</body>
</html>