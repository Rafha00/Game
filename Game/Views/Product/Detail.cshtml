@model Game.Models.Product


@{
    ViewData["Title"] = Model.Name;
    var outOfStock = Model.Stock <= 0;
    var lowStock = Model.Stock > 0 && Model.Stock <= 5;
    var category = string.IsNullOrEmpty(Model.Category) ? "Game" : Model.Category;
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
}

<style>
    .gd-page { background: #0b0f19);
               color: #c7d5e0; padding: 24px 16px 64px; min-height: 100vh; }
    .gd-wrap { max-width: 1040px; margin: 0 auto; }

    /* TOP */
    .gd-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
    .gd-title { margin: 0; font-size: 26px; font-weight: 400; color: #fff; }
    .gd-btn { display: inline-block; padding: 6px 14px; border-radius: 2px; border: 0; cursor: pointer;
              background: rgba(103,193,245,.2); color: #67c1f5; font-size: 13px; text-decoration: none;
              transition: background .2s, color .2s; }
    .gd-btn:hover{ border-color: rgba(139,92,246,.7); transform: translateX(2px);
                    background: linear-gradient(to right, rgba(76,29,149,.65), rgba(30,27,75,.9)); }

    /* HERO */
    .gd-hero { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 16px; }

    .gd-media { background: #000; aspect-ratio: 16 / 9; overflow: hidden; }
    .gd-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .gd-noimg { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 64px; }

    .gd-thumbs { margin-top: 4px; padding: 6px; background: rgba(0,0,0,.25); display: flex; gap: 4px; }
    .gd-thumb { width: 116px; aspect-ratio: 16 / 9; border: 2px solid #fff; overflow: hidden; background: #000; }
    .gd-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }

    /* SIDE */
    .gd-side { display: flex; flex-direction: column; background: rgba(0,0,0,.2); }
    .gd-capsule { aspect-ratio: 460 / 215; background: #000; overflow: hidden; }
    .gd-capsule img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .gd-desc { margin: 0; padding: 14px 14px 10px; font-size: 13px; line-height: 1.55; color: #c7d5e0;
               display: -webkit-box; -webkit-line-clamp: 7; -webkit-box-orient: vertical; overflow: hidden; }
    .gd-rows { padding: 6px 14px 10px; }
    .gd-row { display: flex; gap: 10px; padding: 4px 0; font-size: 12px; }
    .gd-row .l { width: 110px; flex-shrink: 0; text-transform: uppercase; color: #556772; font-size: 11px; padding-top: 1px; }
    .gd-row .v { color: #8f98a0; }
    .gd-row .v.blue { color: #67c1f5; }
    .gd-row .v.ok  { color: #a4d007; }
    .gd-row .v.low { color: #fbbf24; }
    .gd-row .v.out { color: #f87171; }
    .gd-tags { margin-top: auto; padding: 10px 14px 14px; }
    .gd-tags p { margin: 0 0 6px; font-size: 11px; color: #556772; }
    .gd-tag { display: inline-block; padding: 2px 8px; margin: 0 3px 3px 0; border-radius: 2px;
              background: rgba(103,193,245,.2); color: #67c1f5; font-size: 11px; }

    /* ACTION BAR */
    .gd-actions { margin: 16px 0 36px; padding: 12px 16px; background: rgba(0,0,0,.2);
                  display: flex; flex-wrap: wrap; gap: 8px; }

    /* BUY */
    .gd-buyrow { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 16px; align-items: start; }
    .gd-buy { position: relative; padding: 22px 24px 60px; border-radius: 3px;
              background: linear-gradient(135deg, rgba(122,150,176,.55), rgba(42,71,94,.55)); }
    .gd-buy h2 { margin: 0 0 4px; font-size: 20px; font-weight: 400; color: #fff; }
    .gd-buy p { margin: 0; font-size: 12px; color: #a3cfec; }

    .gd-cart { position: absolute; right: 16px; bottom: -18px; display: flex; align-items: stretch;
               background: #000; padding: 2px; gap: 2px; }
    .gd-price { display: flex; align-items: center; padding: 0 14px; background: #344654;
                color: #fff; font-size: 15px; font-weight: 600; white-space: nowrap; }
    .gd-add { padding: 9px 20px; border: 0; cursor: pointer; color: #fff; font-size: 14px; font-weight: 600;
              background: linear-gradient(to bottom, #a4d007 5%, #536904 95%); }
    .gd-add:hover { background: linear-gradient(to bottom, #b6ee00 5%, #6a8505 95%); }
    .gd-add:disabled { cursor: not-allowed; color: #9ca3af; background: #4b5563; }

    .gd-info { background: #000; padding: 16px; }
    .gd-info h3 { margin: 0 0 8px; font-size: 16px; font-weight: 400; color: #fff; }
    .gd-info p { margin: 0; font-size: 12px; line-height: 1.6; color: #8f98a0; }

    @@media (max-width: 860px) {
        .gd-hero, .gd-buyrow { grid-template-columns: 1fr; }
        .gd-buy { margin-bottom: 24px; }
        .gd-title { font-size: 22px; }
    }
</style>

<div class="gd-page">
    <div class="gd-wrap">

        <!-- TOP: title + back -->
        <div class="gd-top">
            <h1 class="gd-title">@Model.Name</h1>
            <a class="gd-btn" href="javascript:history.back()"><i class="fa-solid fa-arrow-left-long"></i> กลับ</a>
        </div>

        <!-- HERO -->
        <div class="gd-hero">

            <!-- LEFT: main media -->
            <div>
                <div class="gd-media">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.Name" />
                    }
                    else
                    {
                        <div class="gd-noimg"><i class="fa-brands fa-playstation"></i></div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div class="gd-thumbs">
                        <div class="gd-thumb"><img src="@Model.ImageUrl" alt="" /></div>
                    </div>
                }
            </div>

            <!-- RIGHT: summary -->
            <div class="gd-side">
                <div class="gd-capsule">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.Name" />
                    }
                    else
                    {
                        <div class="gd-noimg" style="font-size:40px">🎮</div>
                    }
                </div>

                <p class="gd-desc">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "ไม่มีรายละเอียด" : Model.Description)
                </p>

                <div class="gd-rows">
                    <div class="gd-row">
                        <span class="l">หมวดหมู่:</span>
                        <span class="v blue">@category</span>
                    </div>
                    <div class="gd-row">
                        <span class="l">สถานะสต็อก:</span>
                        <span class="v @(outOfStock ? "out" : lowStock ? "low" : "ok")">
                            @(outOfStock ? "สินค้าหมด" : $"{Model.Stock} ชิ้น")
                        </span>
                    </div>
                </div>

                <div class="gd-tags">
                    <p>แท็กของสินค้านี้:</p>
                    <span class="gd-tag">@category</span>
                    <span class="gd-tag">Digital</span>
                </div>
            </div>
        </div>

        <!-- ACTION BAR -->
        <div class="gd-actions ">

        </div>

        <!-- BUY -->
        <div class="gd-buyrow">
            <div class="gd-buy">
                <h2>ซื้อ @Model.Name</h2>
                <p>สินค้าพร้อมส่งทันทีผ่านระบบดิจิทัล</p>

                <div class="gd-cart">
                    <div class="gd-price">฿@Model.Price.ToString("N2")</div>
                     @if (outOfStock)
                    {
                        <button type="button" class="gd-add" disabled>สินค้าหมด</button>
                    }
                    else
                    {
                        <button type="button" class="gd-add" id="addToCartBtn" data-id="@Model.Id">หยิบใส่ตะกร้า</button>
                    }
                </div>
                
            </div>
                                <!-- POPUP -->
                    <div id="gdModal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.65);align-items:center;justify-content:center;">
                        <div style="background:#1b2838;border:1px solid #2a475e;border-radius:12px;padding:28px;max-width:380px;width:90%;text-align:center;color:#fff;">
                            <div id="gdModalIcon" style="font-size:42px;margin-bottom:8px;"><i class="fa-solid fa-lock"></i></div>
                            <h3 id="gdModalTitle" style="font-size:20px;font-weight:600;margin-bottom:6px;"></h3>
                            <p id="gdModalMsg" style="color:#9fb3c8;margin-bottom:20px;"></p>
                            <div style="display:flex;gap:10px;justify-content:center;">
                                <a id="gdModalLogin" href="/Auth/Login" style="display:none;background:#7c3aed;color:#fff;padding:8px 18px;border-radius:8px;text-decoration:none;">เข้าสู่ระบบ</a>
                                <a id="gdModalCart" href="/Cart" style="display:none;background:#5c7e10;color:#fff;padding:8px 18px;border-radius:8px;text-decoration:none;">ไปที่ตะกร้า</a>
                                <button type="button" id="gdModalClose" style="background:#2a475e;color:#fff;padding:8px 18px;border-radius:8px;border:none;">ปิด</button>
                            </div>
                        </div>
                    </div>

                        @section Scripts {
                        <script>
                        (function () {
                            const modal = document.getElementById('gdModal');
                            const show = (icon, title, msg, mode) => {
                                document.getElementById('gdModalIcon').innerHTML = icon;
                                document.getElementById('gdModalTitle').textContent = title;
                                document.getElementById('gdModalMsg').textContent = msg;
                                document.getElementById('gdModalLogin').style.display = mode === 'login' ? 'inline-block' : 'none';
                                document.getElementById('gdModalCart').style.display  = mode === 'cart'  ? 'inline-block' : 'none';
                                modal.style.display = 'flex';
                            };
                            document.getElementById('gdModalClose').onclick = () => modal.style.display = 'none';
                            modal.onclick = e => { if (e.target === modal) modal.style.display = 'none'; };

                            const btn = document.getElementById('addToCartBtn');
                            if (!btn) return;

                            btn.addEventListener('click', async () => {
                                btn.disabled = true;
                                try {
                                    const res = await fetch('/Cart/Add', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                                        body: 'productId=' + encodeURIComponent(btn.dataset.id) + '&qty=1'
                                    });

                                    if (res.status === 401) {
                                        document.getElementById('gdModalLogin').href =
                                            '/Auth/Login?returnUrl=' + encodeURIComponent(location.pathname + location.search);
                                        show('<i class="fa-solid fa-lock"></i>', 'กรุณาเข้าสู่ระบบ', 'คุณต้องเข้าสู่ระบบก่อนจึงจะหยิบสินค้าใส่ตะกร้าได้', 'login');
                                        return;
                                    }

                                    const data = await res.json();
                                    if (data.success) {
                                        window.updateCartBadge && window.updateCartBadge(data.count);
                                        show('<i class="fa-regular fa-circle-check" style="color: rgb(99, 230, 190);"></i>', 'เพิ่มลงตะกร้าแล้ว', 'สินค้าถูกเพิ่มในตะกร้าของคุณเรียบร้อย', 'cart');
                                    } else {
                                        show('<i class="fa-solid fa-exclamation" style="color: rgb(218, 32, 36);"></i>', 'ไม่สามารถเพิ่มได้', data.message, null);
                                    }
                                } catch (e) {
                                    show('<i class="fa-solid fa-triangle-exclamation" style="color: rgb(218, 32, 36);"></i>', 'เกิดข้อผิดพลาด', 'กรุณาลองใหม่อีกครั้ง', null);
                                } finally {
                                    btn.disabled = false;
                                }
                            });
                        })();
                        </script>
                        }

            <div class="gd-info">
                <h3>สถานะสินค้า</h3>
                <p>
                    @if (outOfStock)
                    {
                        <text>ขณะนี้สินค้าหมดชั่วคราว กรุณากลับมาเช็กอีกครั้งภายหลัง</text>
                    }
                    else if (lowStock)
                    {
                        <text>เหลือเพียง @Model.Stock ชิ้นสุดท้าย รีบสั่งซื้อก่อนหมด</text>
                    }
                    else
                    {
                        <text>มีสินค้าพร้อมจำหน่าย @Model.Stock ชิ้น จัดส่งทันทีผ่านระบบดิจิทัล</text>
                    }
                </p>
            </div>
        </div>

    </div>
</div>