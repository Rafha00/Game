@model Game.Models.Product

@{
    ViewData["Title"] = Model.Name;
    var outOfStock = Model.Stock <= 0;
    var lowStock = Model.Stock > 0 && Model.Stock <= 5;
    var category = string.IsNullOrWhiteSpace(Model.Category) ? "Game" : Model.Category;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    .gd-page {
        --gd-purple: #a78bfa;
        --gd-cyan: #67e8f9;
        --gd-muted: #9ca3af;
        position: relative;
        isolation: isolate;
        min-height: 100vh;
        overflow: hidden;
        padding: 34px 20px 76px;
        color: #e5e7eb;
        background:
            radial-gradient(ellipse at 12% 0%, rgba(124, 58, 237, .19), transparent 38%),
            radial-gradient(ellipse at 92% 15%, rgba(34, 211, 238, .09), transparent 32%),
            #080b14;
    }
    .gd-page::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        opacity: .18;
        background-image: linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px);
        background-size: 42px 42px;
        mask-image: linear-gradient(to bottom, black, transparent 80%);
    }
    .gd-wrap { max-width: 1120px; margin: 0 auto; }
    .gd-top { display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:22px; }
    .gd-breadcrumb { color:#8791a5; font-size:12px; margin-bottom:7px; }
    .gd-breadcrumb a { color:#b7a4ff; text-decoration:none; }
    .gd-breadcrumb a:hover { color:#fff; }
    .gd-title { margin:0; color:#fff; font-size:clamp(24px,3vw,34px); font-weight:800; line-height:1.2; letter-spacing:-.7px; overflow-wrap:anywhere; }
    .gd-title-mark { display:inline-block; width:5px; height:27px; margin-right:12px; border-radius:10px; vertical-align:-3px; background:linear-gradient(#c4b5fd,#7c3aed); box-shadow:0 0 18px rgba(167,139,250,.65); }
    .gd-btn { display:inline-flex; align-items:center; justify-content:center; gap:9px; flex-shrink:0; padding:10px 15px; border:1px solid rgba(255,255,255,.12); border-radius:11px; color:#e5e7eb; text-decoration:none; font-size:13px; font-weight:650; background:rgba(255,255,255,.045); transition:.2s ease; }
    .gd-btn:hover { transform:translateY(-2px); border-color:rgba(167,139,250,.6); color:#fff; background:rgba(124,58,237,.15); }
    .gd-hero { display:grid; grid-template-columns:minmax(0,1.55fr) minmax(300px,.85fr); gap:20px; align-items:stretch; }
    .gd-gallery, .gd-side, .gd-buy, .gd-info { border:1px solid rgba(255,255,255,.09); border-radius:18px; overflow:hidden; background:rgba(15,19,33,.86); box-shadow:0 18px 50px rgba(0,0,0,.22); }
    .gd-media { position:relative; width:100%; aspect-ratio:16/9; overflow:hidden; background:linear-gradient(135deg,#17142a,#0c1220); }
    .gd-media::after { content:""; position:absolute; inset:0; pointer-events:none; background:linear-gradient(180deg,transparent 60%,rgba(4,6,12,.22)); }
    .gd-media img, .gd-capsule img { width:100%; height:100%; object-fit:cover; display:block; }
    .gd-media img { transition:transform .6s ease; }
    .gd-gallery:hover .gd-media img { transform:scale(1.025); }
    .gd-noimg { width:100%; height:100%; min-height:160px; display:flex; align-items:center; justify-content:center; flex-direction:column; gap:12px; color:#a78bfa; font-size:64px; background:radial-gradient(circle,rgba(124,58,237,.15),transparent 65%); }
    .gd-noimg span { color:#7f8ba3; font-size:12px; letter-spacing:2px; text-transform:uppercase; }
    .gd-thumbs { display:flex; gap:9px; padding:12px; background:rgba(255,255,255,.025); }
    .gd-thumb { width:112px; aspect-ratio:16/9; border:1px solid rgba(167,139,250,.65); border-radius:9px; overflow:hidden; background:#090d18; box-shadow:0 0 0 2px rgba(124,58,237,.1); }
    .gd-thumb img { width:100%; height:100%; object-fit:cover; display:block; }
    .gd-side { display:flex; flex-direction:column; }
    .gd-capsule { position:relative; aspect-ratio:16/7; overflow:hidden; background:linear-gradient(135deg,#17142a,#0c1220); }
    .gd-capsule::after { content:""; position:absolute; inset:0; background:linear-gradient(0deg,rgba(10,12,22,.55),transparent 65%); }
    .gd-side-content { padding:20px 20px 18px; }
    .gd-chip { display:inline-flex; align-items:center; gap:7px; padding:6px 10px; border:1px solid rgba(167,139,250,.22); border-radius:999px; color:#c4b5fd; background:rgba(124,58,237,.12); font-size:11px; font-weight:700; letter-spacing:.3px; }
    .gd-desc-title { margin:16px 0 8px; color:#fff; font-size:15px; font-weight:750; }
    .gd-desc { margin:0; color:#a8b0c2; font-size:13px; line-height:1.8; overflow-wrap:anywhere; white-space:pre-line; }
    .gd-divider { height:1px; margin:18px 0; background:rgba(255,255,255,.08); }
    .gd-rows { display:flex; flex-direction:column; gap:12px; }
    .gd-row { display:flex; justify-content:space-between; align-items:center; gap:12px; font-size:12px; }
    .gd-row .l { color:#7f8ba3; }
    .gd-row .v { color:#e5e7eb; text-align:right; font-weight:650; }
    .gd-row .v.blue { color:#a5b4fc; }
    .gd-row .v.ok { color:#86efac; }
    .gd-row .v.low { color:#fcd34d; }
    .gd-row .v.out { color:#fca5a5; }
    .gd-stock-dot { display:inline-block; width:7px; height:7px; margin-right:6px; border-radius:50%; background:currentColor; vertical-align:1px; }
    .gd-tags { display:flex; flex-wrap:wrap; gap:7px; margin-top:18px; }
    .gd-tag { padding:6px 10px; border:1px solid rgba(255,255,255,.08); border-radius:8px; color:#aab3c7; background:rgba(255,255,255,.035); font-size:11px; }
    .gd-tag i { margin-right:5px; color:#a78bfa; }
    .gd-buyrow { display:grid; grid-template-columns:minmax(0,1.55fr) minmax(280px,.85fr); gap:20px; margin-top:20px; align-items:stretch; }
    .gd-buy { position:relative; padding:25px; background:linear-gradient(120deg,rgba(91,33,182,.2),rgba(15,19,33,.96) 62%); }
    .gd-buy-eyebrow { display:flex; align-items:center; gap:8px; margin-bottom:10px; color:#c4b5fd; font-size:11px; font-weight:800; letter-spacing:1.6px; text-transform:uppercase; }
    .gd-buy h2 { margin:0 0 8px; color:#fff; font-size:22px; font-weight:800; overflow-wrap:anywhere; }
    .gd-buy p { max-width:520px; margin:0; color:#9ba5ba; font-size:13px; line-height:1.7; }
    .gd-buy-bottom { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:18px; margin-top:25px; padding-top:20px; border-top:1px solid rgba(255,255,255,.09); }
    .gd-price-label { display:block; margin-bottom:4px; color:#8c96aa; font-size:11px; }
    .gd-price { color:#fff; font-size:clamp(25px,3vw,34px); line-height:1.1; font-weight:900; letter-spacing:-.7px; }
    .gd-price small { margin-left:4px; color:#a78bfa; font-size:12px; font-weight:650; letter-spacing:0; }
    .gd-add { display:inline-flex; align-items:center; justify-content:center; gap:10px; min-height:46px; padding:12px 19px; border:1px solid rgba(255,255,255,.12); border-radius:12px; cursor:pointer; color:#fff; font-size:13px; font-weight:800; background:linear-gradient(135deg,#8b5cf6,#6d28d9); box-shadow:0 8px 25px rgba(109,40,217,.27); transition:transform .2s,filter .2s,opacity .2s; }
    .gd-add:hover { transform:translateY(-2px); filter:brightness(1.12); }
    .gd-add:disabled { cursor:not-allowed; opacity:.55; box-shadow:none; }
    .gd-info { padding:22px; }
    .gd-info h3 { display:flex; align-items:center; gap:9px; margin:0 0 12px; color:#fff; font-size:15px; font-weight:800; }
    .gd-info h3 i { color:#a78bfa; }
    .gd-info p { margin:0; color:#9ba5ba; font-size:12px; line-height:1.8; }
    .gd-info-list { display:flex; flex-direction:column; gap:12px; margin-top:17px; }
    .gd-info-item { display:flex; align-items:flex-start; gap:10px; color:#b9c1d1; font-size:12px; line-height:1.6; }
    .gd-info-item i { width:17px; margin-top:2px; color:#86efac; }
    .gd-modal { position:fixed; inset:0; z-index:9999; display:none; align-items:center; justify-content:center; padding:20px; background:rgba(2,4,10,.78); backdrop-filter:blur(9px); }
   .gd-modal-card {
    width: 100%;
    max-width: 420px;
    padding: 30px;
    border: 1px solid rgba(255, 23, 68, .4);
    border-radius: 20px;
    text-align: center;
    color: #fff;
    background: linear-gradient(145deg, #260812, #0e1422);
    box-shadow: 0 25px 90px rgba(0, 0, 0, .55),
                0 0 30px rgba(255, 23, 68, .12);
    animation: gdPop .22s ease-out;
}
    @@keyframes gdPop { from { opacity:0; transform:translateY(10px) scale(.98); } to { opacity:1; transform:translateY(0) scale(1); } }
    .gd-modal-icon { display:flex; align-items:center; justify-content:center; width:68px; height:68px; margin:0 auto 16px; border:1px solid rgba(167,139,250,.25); border-radius:20px; color:#c4b5fd; background:rgba(124,58,237,.14); font-size:28px; }
    .gd-modal-card h3 { margin:0 0 8px; color:#fff; font-size:21px; font-weight:800; }
    .gd-modal-card p { margin:0 0 22px; color:#a6afc2; font-size:13px; line-height:1.7; }
    .gd-modal-actions { display:flex; flex-wrap:wrap; gap:10px; justify-content:center; }
    .gd-modal-actions a, .gd-modal-actions button { display:inline-flex; align-items:center; justify-content:center; gap:8px; padding:10px 16px; border:1px solid rgba(255,255,255,.1); border-radius:10px; cursor:pointer; color:#fff; text-decoration:none; font-size:12px; font-weight:750; background:rgba(255,255,255,.07); }
   .gd-modal-actions .primary {
    border-color: transparent;
    background: linear-gradient(135deg, #ff1744, #d50936);
    color: #fff;
    box-shadow: 0 6px 20px rgba(255, 23, 68, .25);
    transition: .2s ease;
}

.gd-modal-actions .primary:hover {
    background: linear-gradient(135deg, #ff4566, #ff1744);
    transform: translateY(-2px);
}
    @@media (max-width: 850px) {
        .gd-page { padding:25px 15px 55px; }
        .gd-hero, .gd-buyrow { grid-template-columns:1fr; }
        .gd-side { display:grid; grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr); }
        .gd-capsule { height:100%; min-height:180px; aspect-ratio:auto; }
        .gd-side-content { padding:18px; }
        .gd-buyrow { gap:14px; }
    }
    @@media (max-width: 560px) {
        .gd-page { padding:20px 12px 42px; }
        .gd-top { align-items:flex-start; }
        .gd-title { font-size:23px; }
        .gd-title-mark { height:22px; margin-right:8px; }
        .gd-btn { padding:9px 11px; font-size:12px; }
        .gd-side { display:flex; }
        .gd-capsule { aspect-ratio:16/7; min-height:0; }
        .gd-buy { padding:20px; }
        .gd-buy-bottom { align-items:stretch; flex-direction:column; }
        .gd-add { width:100%; }
        .gd-info { padding:19px; }
        .gd-modal-card { padding:25px 20px; }
    }
</style>

<div class="gd-page">
    <div class="gd-wrap">
        <div class="gd-top">
            <div>
                <div class="gd-breadcrumb">
                    <a asp-controller="Home" asp-action="Index">หน้าแรก</a>
                    <span> / </span>
                    <a asp-controller="Product" asp-action="Index">เกมทั้งหมด</a>
                    <span> / รายละเอียดเกม</span>
                </div>
                <h1 class="gd-title"><span class="gd-title-mark"></span>@Model.Name</h1>
            </div>
            <a class="gd-btn" asp-controller="Product" asp-action="Index"><i class="fa-solid fa-arrow-left"></i> กลับไปหน้าร้าน</a>
        </div>

        <div class="gd-hero">
            <div class="gd-gallery">
                <div class="gd-media">
                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.Name" />
                    }
                    else
                    {
                        <div class="gd-noimg"><i class="fa-solid fa-gamepad"></i><span>GameWorld</span></div>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <div class="gd-thumbs">
                        <div class="gd-thumb"><img src="@Model.ImageUrl" alt="@Model.Name preview" /></div>
                    </div>
                }
            </div>

            <aside class="gd-side">
                <div class="gd-capsule">
                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.Name cover" />
                    }
                    else
                    {
                        <div class="gd-noimg" style="font-size:42px"><i class="fa-solid fa-gamepad"></i></div>
                    }
                </div>
                <div class="gd-side-content">
                    <span class="gd-chip"><i class="fa-solid fa-layer-group"></i> @category</span>
                    <h2 class="gd-desc-title">เกี่ยวกับเกมนี้</h2>
                    <p class="gd-desc">@(string.IsNullOrWhiteSpace(Model.Description) ? "ยังไม่มีรายละเอียดสำหรับเกมนี้" : Model.Description)</p>
                    <div class="gd-divider"></div>
                    <div class="gd-rows">
                        <div class="gd-row">
                            <span class="l">หมวดหมู่</span>
                            <span class="v blue">@category</span>
                        </div>
                        <div class="gd-row">
                            <span class="l">สถานะสินค้า</span>
                            @if (outOfStock)
                            {
                                <span class="v out"><span class="gd-stock-dot"></span>สินค้าหมด</span>
                            }
                            else if (lowStock)
                            {
                                <span class="v low"><span class="gd-stock-dot"></span>เหลือน้อย</span>
                            }
                            else
                            {
                                <span class="v ok"><span class="gd-stock-dot"></span>พร้อมจำหน่าย</span>
                            }
                        </div>
                        <div class="gd-row">
                            <span class="l">คงเหลือ</span>
                            <span class="v">@Math.Max(0, Model.Stock) ชิ้น</span>
                        </div>
                    </div>
                    <div class="gd-tags">
                        <span class="gd-tag"><i class="fa-solid fa-gamepad"></i>@category</span>
                        <span class="gd-tag"><i class="fa-solid fa-bolt"></i>Digital Game</span>
                        <span class="gd-tag"><i class="fa-solid fa-shield-halved"></i>GameWorld Store</span>
                    </div>
                </div>
            </aside>
        </div>

        <div class="gd-buyrow">
            <section class="gd-buy">
                <div class="gd-buy-eyebrow"><i class="fa-solid fa-sparkles"></i> WHATGAME Store</div>
                <h2>@Model.Name</h2>
                <p>เลือกเกมที่คุณชอบ แล้วเพิ่มลงตะกร้าเพื่อดำเนินการสั่งซื้อได้เลย</p>
                <div class="gd-buy-bottom">
                    <div>
                        <span class="gd-price-label">ราคาจำหน่าย</span>
                        <div class="gd-price">฿@Model.Price.ToString("N2") <small>THB</small></div>
                    </div>
                    @if (outOfStock)
                    {
                        <button type="button" class="gd-add" disabled><i class="fa-solid fa-ban"></i> สินค้าหมดชั่วคราว</button>
                    }
                    else
                    {
                        <button type="button" class="gd-add" id="addToCartBtn" data-id="@Model.Id">
                            <i class="fa-solid fa-cart-plus"></i> หยิบใส่ตะกร้า
                        </button>
                    }
                </div>
            </section>

            <aside class="gd-info">
                <h3><i class="fa-solid fa-circle-check"></i> ซื้อเกมกับ WHATGAME</h3>
                <p>เลือกเกมที่ต้องการได้อย่างสะดวก ตรวจสอบราคาและจำนวนสินค้าคงเหลือก่อนเพิ่มลงตะกร้า</p>
                <div class="gd-info-list">
                    <div class="gd-info-item"><i class="fa-solid fa-check"></i><span>แสดงรายละเอียดและราคาของเกมก่อนสั่งซื้อ</span></div>
                    <div class="gd-info-item"><i class="fa-solid fa-check"></i><span>ตรวจสอบสถานะสินค้าคงเหลือได้จากหน้านี้</span></div>
                    <div class="gd-info-item"><i class="fa-solid fa-check"></i><span>จัดการรายการที่เลือกได้ผ่านตะกร้าสินค้า</span></div>
                </div>
            </aside>
        </div>
    </div>
</div>

<div id="gdModal" class="gd-modal" role="dialog" aria-modal="true" aria-labelledby="gdModalTitle">
    <div class="gd-modal-card">
        <div id="gdModalIcon" class="gd-modal-icon"><i class="fa-solid fa-lock"></i></div>
        <h3 id="gdModalTitle">แจ้งเตือน</h3>
        <p id="gdModalMsg"></p>
        <div class="gd-modal-actions">
            <a id="gdModalLogin" class="primary" href="/Auth/Login" style="display:none"><i class="fa-solid fa-right-to-bracket"></i> เข้าสู่ระบบ</a>
            <a id="gdModalCart" class="primary" href="/Cart" style="display:none"><i class="fa-solid fa-cart-shopping"></i> ไปที่ตะกร้า</a>
            <button type="button" id="gdModalClose"><i class="fa-solid fa-xmark"></i> ปิด</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const modal = document.getElementById('gdModal');
            const modalIcon = document.getElementById('gdModalIcon');
            const modalTitle = document.getElementById('gdModalTitle');
            const modalMsg = document.getElementById('gdModalMsg');
            const loginLink = document.getElementById('gdModalLogin');
            const cartLink = document.getElementById('gdModalCart');
            const closeBtn = document.getElementById('gdModalClose');
            const btn = document.getElementById('addToCartBtn');

            function showModal(iconClass, title, message, mode, success) {
              modalIcon.innerHTML = '<i class="' + iconClass + '"></i>';
               if (success) {
                    modalIcon.style.color = '#ff1744';
                } else {
                    modalIcon.style.color = '#ff1744';
                }
                modalTitle.textContent = title;
                modalMsg.textContent = message;
                loginLink.style.display = mode === 'login' ? 'inline-flex' : 'none';
                cartLink.style.display = mode === 'cart' ? 'inline-flex' : 'none';
                modal.style.display = 'flex';
            }

            function closeModal() { modal.style.display = 'none'; }
            closeBtn.addEventListener('click', closeModal);
            modal.addEventListener('click', function (event) {
                if (event.target === modal) closeModal();
            });
            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') closeModal();
            });

            if (!btn) return;

            btn.addEventListener('click', async function () {
                if (btn.disabled) return;
                btn.disabled = true;
                const originalHtml = btn.innerHTML;
                btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> กำลังเพิ่ม...';

                try {
                    const response = await fetch('/Cart/Add', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: 'productId=' + encodeURIComponent(btn.dataset.id) + '&qty=1'
                    });

                    if (response.status === 401) {
                        loginLink.href = '/Auth/Login?returnUrl=' + encodeURIComponent(location.pathname + location.search);
                        showModal('fa-solid fa-lock', 'กรุณาเข้าสู่ระบบ', 'คุณต้องเข้าสู่ระบบก่อนจึงจะหยิบสินค้าใส่ตะกร้าได้', 'login', false);
                        return;
                    }

                    const data = await response.json();
                    if (data.success) {
                        if (window.updateCartBadge) window.updateCartBadge(data.count);
                        showModal('fa-regular fa-circle-check', 'เพิ่มลงตะกร้าแล้ว', 'เพิ่มเกมลงในตะกร้าของคุณเรียบร้อยแล้ว', 'cart', true);
                    } else {
                        showModal('fa-solid fa-circle-exclamation', 'ไม่สามารถเพิ่มสินค้าได้', data.message || 'กรุณาลองใหม่อีกครั้ง', null, false);
                    }
                } catch (error) {
                    showModal('fa-solid fa-triangle-exclamation', 'เกิดข้อผิดพลาด', 'ไม่สามารถเชื่อมต่อระบบได้ กรุณาลองใหม่อีกครั้ง', null, false);
                } finally {
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                }
            });
        })();
    </script>
}
