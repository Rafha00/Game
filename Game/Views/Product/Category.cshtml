@model IEnumerable<Game.Models.Product>

@{
    var title = ViewBag.CategoryName as string ?? "All Games";
    ViewData["Title"] = title;
    var total = Model.Count();
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600&family=Prompt:wght@500;600;700&display=swap" rel="stylesheet" />

<style>
    .gw-wrap {
        --gw-ink: #f5f3ff;
        --gw-muted: #9b9ab8;
        --gw-faint: #6c6b8a;
        --gw-accent: #8b5cf6;
        --gw-accent-soft: #c4b5fd;
        --gw-out: #f87171;
        --gw-line: rgba(255,255,255,.08);

        max-width: 1080px; margin: 0 auto; padding: 24px 24px 56px;
        color: var(--gw-ink);
        font-family: 'IBM Plex Sans Thai', system-ui, sans-serif;
    }

    /* ---------- Header ---------- */
    .gw-head { display: flex; align-items: center; justify-content: space-between; gap: 16px;
               margin-bottom: 18px; }
    .gw-head h1 { margin: 0; font-family: 'Prompt', sans-serif; font-weight: 600;
                  font-size: 20px; line-height: 1.2; }
    .gw-count { flex-shrink: 0; font-size: 13px; color: var(--gw-muted); }
    .gw-count b { font-family: 'Prompt', sans-serif; font-weight: 600; color: var(--gw-accent-soft); }

    /* ---------- List ---------- */
    .gw-list { display: flex; flex-direction: column; gap: 14px; animation: gw-in .5s ease-out both; }

    .gw-row { position: relative; display: grid; grid-template-columns: 262px 1fr auto;
              height: 158px; overflow: hidden; color: inherit; text-decoration: none;
              background: linear-gradient(100deg, rgba(30,30,64,.9), rgba(15,18,36,.95) 55%);
              border: 1px solid var(--gw-line); border-radius: 18px;
              transition: border-color .2s, box-shadow .2s, transform .2s; }
    .gw-row:hover, .gw-row:focus-visible { border-color: rgba(139,92,246,.55);
                      box-shadow: 0 10px 30px -12px rgba(124,58,237,.5);
                      transform: translateY(-1px); }
    .gw-row:focus-visible { outline: 2px solid var(--gw-accent-soft); outline-offset: 2px; }

    /* ---------- Thumbnail ---------- */
    .gw-thumb { position: relative; overflow: hidden; background: #0b1020; height: 100%; }
    .gw-thumb img { width: 100%; height: 100%; object-fit: cover; object-position: center top;
                    display: block; transition: transform .5s ease; }
    .gw-row:hover .gw-thumb img { transform: scale(1.05); }
    .gw-noimg { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
                font-size: 34px; background: radial-gradient(circle at 30% 30%, #2e2a6b, #0b1020); }

    /* ---------- Info ---------- */
    .gw-info { min-width: 0; padding: 14px 24px; display: flex; flex-direction: column;
               justify-content: center; align-items: flex-start; gap: 6px; }
    .gw-kind { font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase;
               color: var(--gw-accent-soft); }
    .gw-name { margin: 0; max-width: 100%; font-family: 'Prompt', sans-serif; font-weight: 600;
               font-size: 20px; line-height: 1.3; color: #fff;
               white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .gw-cat { font-size: 13px; color: var(--gw-accent-soft); }
    .gw-desc { margin: 0; max-width: 100%; font-size: 13px; line-height: 1.5; color: var(--gw-muted);
               display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }

    /* ---------- Price ---------- */
    .gw-side { display: flex; flex-direction: column; align-items: flex-end; justify-content: center;
               gap: 8px; padding: 14px 24px 14px 8px; }
    .gw-side-label { font-size: 11px; letter-spacing: .08em; color: var(--gw-faint); text-transform: uppercase; }
    .gw-price { padding: 9px 16px; border-radius: 12px; white-space: nowrap;
                background: rgba(139,92,246,.14); border: 1px solid rgba(139,92,246,.35);
                font-family: 'Prompt', sans-serif; font-weight: 600; font-size: 18px; line-height: 1;
                font-variant-numeric: tabular-nums; color: #fff; }
    .gw-cur { margin-right: 4px; font-size: 14px; color: var(--gw-accent-soft); }
    .gw-more { font-size: 12px; color: var(--gw-muted); }

    .gw-row.soldout .gw-thumb img { filter: grayscale(1); opacity: .6; }
    .gw-row.soldout .gw-price { background: rgba(255,255,255,.05); border-color: var(--gw-line);
                                color: #cfcde6; }
    .gw-row.soldout .gw-cur { color: var(--gw-faint); }

    /* ---------- Empty ---------- */
    .gw-empty { text-align: center; padding: 56px 16px; border: 1px dashed rgba(255,255,255,.16);
                border-radius: 16px; background: rgba(255,255,255,.03); color: var(--gw-muted); }
    .gw-empty p { margin: 8px 0 0; font-size: 15px; }
    .gw-empty a { display: inline-block; margin-top: 20px; padding: 10px 24px; border-radius: 10px;
                  background: var(--gw-accent); color: #fff; text-decoration: none;
                  font-size: 14px; font-weight: 600; transition: background .2s; }
    .gw-empty a:hover { background: #7c3aed; }

    @@keyframes gw-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

    @@media (max-width: 720px) {
        .gw-wrap { padding: 20px 16px 48px; }
        .gw-row { grid-template-columns: 116px 1fr; height: auto; min-height: 104px; }
        .gw-info { padding: 12px 14px 4px; }
        .gw-name { font-size: 16px; }
        .gw-desc { display: none; }
        .gw-side { grid-column: 2; flex-direction: row; align-items: center; justify-content: space-between;
                   padding: 0 14px 12px; }
        .gw-side-label { display: none; }
        .gw-price { font-size: 16px; padding: 7px 12px; }
        .gw-thumb { grid-row: 1 / span 2; }
    }

    @@media (prefers-reduced-motion: reduce) {
        .gw-list { animation: none; }
        .gw-row, .gw-thumb img { transition: none; }
    }
</style>

<section class="gw-wrap">

    <!-- HEADER -->
    <header class="gw-head">
        <h1>@title</h1>
        <span class="gw-count">พบทั้งหมด <b>@total</b> เกม</span>
    </header>

    @if (total > 0)
    {
        <!-- GAME LIST -->
        <div class="gw-list">
            @foreach (var game in Model)
            {
                var outOfStock = game.Stock <= 0;

                <a asp-controller="Product"
                   asp-action="Detail"
                   asp-route-id="@game.Id"
                   class="gw-row @(outOfStock ? "soldout" : "")">

                    <!-- IMAGE -->
                    <div class="gw-thumb">
                        @if (!string.IsNullOrEmpty(game.ImageUrl))
                        {
                            <img src="@game.ImageUrl" alt="@game.Name" loading="lazy" />
                        }
                        else
                        {
                            <div class="gw-noimg">🎮</div>
                        }
                    </div>

                    <!-- INFO -->
                    <div class="gw-info">
                        <span class="gw-kind">PC Game</span>
                        <h2 class="gw-name">@game.Name</h2>
                        <span class="gw-cat">@(string.IsNullOrEmpty(game.Category) ? "Game" : game.Category)</span>
                        @if (!string.IsNullOrWhiteSpace(game.Description))
                        {
                            <p class="gw-desc">@game.Description</p>
                        }
                    </div>

                    <!-- PRICE -->
                    <div class="gw-side">
                        <span class="gw-side-label">Price</span>
                        <div class="gw-price">
                            @if (outOfStock)
                            {
                                <span>สินค้าหมด</span>
                            }
                            else
                            {
                                <span class="gw-cur">฿</span>@game.Price.ToString("N2")
                            }
                        </div>
                        <span class="gw-more">ดูรายละเอียด →</span>
                    </div>
                </a>
            }
        </div>
    }
    else
    {
        <div class="gw-empty">
            <div style="font-size:44px"><i class="fa-regular fa-hourglass"></i></div>
            <p>ยังไม่มีเกมในหมวดหมู่นี้</p>
            <a href="/">กลับสู่หน้าแรก</a>
        </div>
    }

</section>