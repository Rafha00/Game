
@{
    ViewData["Title"] = "เข้าสู่ระบบ - GameWorld";
    Layout = null;
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body style="margin:0">

<div class="auth-page">
    <div class="auth-card">

        <section class="auth-brand">
            <div class="auth-logo-icon">
                <i class="fa-solid fa-gamepad"></i>
            </div>

            <h1>WHAT<span>GAME</span></h1>

            <p>
                เข้าสู่โลกแห่งเกมไร้ขีดจำกัด
                ค้นหาเกมที่คุณชื่นชอบและเริ่มต้นการผจญภัยครั้งใหม่
            </p>

            <div class="auth-brand-line"></div>
        </section>

        <section class="auth-form-panel">
            <div class="auth-form-content">

                <div class="auth-eyebrow">WELCOME BACK</div>
                <h2 class="auth-title">เข้าสู่ระบบ</h2>
                <p class="auth-subtitle">
                    กรอกข้อมูลบัญชีของคุณเพื่อเข้าสู่ WhatGame
                </p>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="auth-validation">
                        @TempData["ErrorMessage"]
                    </div>
                }

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="auth-validation">
                        @Html.ValidationSummary()
                    </div>
                }

                <form asp-controller="Auth"
                      asp-action="Login"
                      method="post">

                    <input type="hidden"
                           name="returnUrl"
                           value="@ViewBag.ReturnUrl" />

                    <div class="auth-field">
                        <label class="auth-label" for="loginEmail">
                            อีเมล (Email)
                        </label>

                        <div class="auth-input-wrap">
                            <i class="fa-regular fa-envelope auth-input-icon"></i>

                            <input class="auth-input"
                                   id="loginEmail"
                                   type="email"
                                   name="email"
                                   placeholder="example@email.com"
                                   autocomplete="email"
                                   required />
                        </div>
                    </div>

                    <div class="auth-field">
                        <label class="auth-label" for="loginPassword">
                            รหัสผ่าน (Password)
                        </label>

                        <div class="auth-input-wrap">
                            <i class="fa-solid fa-lock auth-input-icon"></i>

                            <input class="auth-input"
                                   id="loginPassword"
                                   type="password"
                                   name="password"
                                   placeholder="กรอกรหัสผ่านของคุณ"
                                   autocomplete="current-password"
                                   required />

                            <button class="auth-password-toggle"
                                    type="button"
                                    data-toggle-password="loginPassword"
                                    aria-label="แสดงรหัสผ่าน">
                                <i class="fa-regular fa-eye"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="auth-submit">
                        <i class="fa-solid fa-right-to-bracket"></i>
                        &nbsp; เข้าสู่ระบบ
                    </button>
                </form>

                <p class="auth-switch">
                    ยังไม่มีบัญชีใช่ไหม?
                    <a asp-controller="Auth" asp-action="Register">
                        สมัครสมาชิกฟรี
                    </a>
                </p>

            </div>
        </section>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    // แสดง/ซ่อนรหัสผ่าน
    document.querySelectorAll("[data-toggle-password]").forEach(button => {
        button.addEventListener("click", function () {
            const input = document.getElementById(
                this.getAttribute("data-toggle-password")
            );

            if (!input) return;

            const show = input.type === "password";
            input.type = show ? "text" : "password";

            this.innerHTML = show
                ? '<i class="fa-regular fa-eye-slash"></i>'
                : '<i class="fa-regular fa-eye"></i>';

            this.setAttribute(
                "aria-label",
                show ? "ซ่อนรหัสผ่าน" : "แสดงรหัสผ่าน"
            );
        });
    });

    // สมัครสมาชิกสำเร็จ
    @if (TempData["SuccessMessage"] != null)
    {
        <text>
        Swal.fire({
            icon: 'success',
            title: 'สมัครสมาชิกสำเร็จ!',
            text: 'บัญชีของคุณพร้อมใช้งานแล้ว กรุณาเข้าสู่ระบบ',
            confirmButtonText: 'เข้าสู่ระบบ',
            confirmButtonColor: '#ff1744',
            background: '#0b1221',
            color: '#f8fafc',
            allowOutsideClick: false
        });
        </text>
    }
</script>

</body>
</html>
