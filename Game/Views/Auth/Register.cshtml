
@{
    ViewData["Title"] = "สมัครสมาชิก - GameWorld";
    Layout = null;
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body style="margin:0">

<div class="auth-page">
    <div class="auth-card">

        <section class="auth-form-panel">
            <div class="auth-form-content">

                <div class="auth-eyebrow">JOIN THE GAME</div>
                <h2 class="auth-title">สร้างบัญชี</h2>
                <p class="auth-subtitle">
                    สมัครสมาชิกเพื่อเริ่มต้นประสบการณ์ Gaming ของคุณ
                </p>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="auth-validation">
                        @TempData["ErrorMessage"]
                    </div>
                }

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="auth-validation">
                        @Html.ValidationSummary()
                    </div>
                }

                <form asp-controller="Auth"
                      asp-action="Register"
                      method="post"
                      id="registerForm">

                    <div class="auth-field">
                        <label class="auth-label" for="registerEmail">
                            อีเมล (Email)
                        </label>

                        <div class="auth-input-wrap">
                            <i class="fa-regular fa-envelope auth-input-icon"></i>

                            <input class="auth-input"
                                   id="registerEmail"
                                   type="email"
                                   name="email"
                                   placeholder="example@email.com"
                                   autocomplete="email"
                                   required />
                        </div>
                    </div>

                    <div class="auth-field">
                        <label class="auth-label" for="registerPassword">
                            รหัสผ่าน (Password)
                        </label>

                        <div class="auth-input-wrap">
                            <i class="fa-solid fa-lock auth-input-icon"></i>

                            <input class="auth-input"
                                   id="registerPassword"
                                   type="password"
                                   name="password"
                                   placeholder="อย่างน้อย 8 ตัวอักษร"
                                   minlength="8"
                                   autocomplete="new-password"
                                   required />

                            <button class="auth-password-toggle"
                                    type="button"
                                    data-toggle-password="registerPassword"
                                    aria-label="แสดงรหัสผ่าน">
                                <i class="fa-regular fa-eye"></i>
                            </button>
                        </div>
                    </div>

                    <div class="auth-field">
                        <label class="auth-label" for="confirmPassword">
                            ยืนยันรหัสผ่าน
                        </label>

                        <div class="auth-input-wrap">
                            <i class="fa-solid fa-shield-halved auth-input-icon"></i>

                            <input class="auth-input"
                                   id="confirmPassword"
                                   type="password"
                                   name="confirmPassword"
                                   placeholder="กรอกรหัสผ่านอีกครั้ง"
                                   minlength="8"
                                   autocomplete="new-password"
                                   required />

                            <button class="auth-password-toggle"
                                    type="button"
                                    data-toggle-password="confirmPassword"
                                    aria-label="แสดงรหัสผ่าน">
                                <i class="fa-regular fa-eye"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="auth-submit">
                        <i class="fa-solid fa-user-plus"></i>
                        &nbsp; สมัครสมาชิก
                    </button>
                </form>

                <p class="auth-switch">
                    มีบัญชีอยู่แล้ว?
                    <a asp-controller="Auth" asp-action="Login">
                        เข้าสู่ระบบ
                    </a>
                </p>

            </div>
        </section>

        <section class="auth-brand">
            <div class="auth-logo-icon">
                <i class="fa-solid fa-gamepad"></i>
            </div>

            <h1>WHAT<span>GAME</span></h1>

            <p>
                เข้าร่วมชุมชนคนรักเกม ค้นพบเกมใหม่ ๆ
                และสะสมเกมโปรดของคุณได้ในที่เดียว
            </p>

            <div class="auth-brand-line"></div>
        </section>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    // แสดง/ซ่อนรหัสผ่าน
    document.querySelectorAll("[data-toggle-password]").forEach(button => {
        button.addEventListener("click", function () {
            const input = document.getElementById(
                this.getAttribute("data-toggle-password")
            );

            if (!input) return;

            const show = input.type === "password";
            input.type = show ? "text" : "password";

            this.innerHTML = show
                ? '<i class="fa-regular fa-eye-slash"></i>'
                : '<i class="fa-regular fa-eye"></i>';

            this.setAttribute(
                "aria-label",
                show ? "ซ่อนรหัสผ่าน" : "แสดงรหัสผ่าน"
            );
        });
    });

    // ตรวจสอบรหัสผ่านให้ตรงกันก่อนส่งฟอร์ม
    document.getElementById("registerForm").addEventListener("submit", function (e) {
        const password = document.getElementById("registerPassword").value;
        const confirmPassword = document.getElementById("confirmPassword").value;

        if (password !== confirmPassword) {
            e.preventDefault();

            Swal.fire({
                icon: "error",
                title: "รหัสผ่านไม่ตรงกัน",
                text: "กรุณาตรวจสอบรหัสผ่านทั้งสองช่องอีกครั้ง",
                confirmButtonText: "ตกลง",
                confirmButtonColor: "#ff1744",
                background: "#0b1221",
                color: "#f8fafc"
            });
        }
    });
</script>

</body>
</html>
