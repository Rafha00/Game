
@model Game.Models.User

@{
    ViewData["Title"] = "โปรไฟล์ของฉัน";
    Layout = null;

    var email = Model?.Email ?? "";
    var role = (Model?.Role ?? "").Trim().ToLowerInvariant();

    var roleLabel = role switch
    {
        "admin" => "ผู้ดูแลระบบ",
        "manager" => "ผู้จัดการ",
        "staff" => "พนักงาน",
        "customer" => "ลูกค้า",
        _ => "ไม่ระบุสิทธิ์"
    };

    var initial = !string.IsNullOrWhiteSpace(email)
        ? email.Substring(0, 1).ToUpperInvariant()
        : "?";
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - GAMEWORLD</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: "Segoe UI", Tahoma, sans-serif;
            background: #080b14;
            color: #f8fafc;
        }

        .profile-layout {
            display: flex;
            min-height: 100vh;
        }

        .profile-main {
            flex: 1;
            min-width: 0;
            padding: 34px;
            background:
                radial-gradient(
                    ellipse at top right,
                    rgba(124, 58, 237, .12),
                    transparent 45%
                ),
                #080b14;
        }

        .profile-container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .profile-heading {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 28px;
        }

        .heading-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 58px;
            height: 58px;
            flex-shrink: 0;
            border-radius: 18px;
            background: linear-gradient(135deg, #7c3aed, #4c1d95);
            box-shadow: 0 8px 30px rgba(124, 58, 237, .2);
            font-size: 23px;
        }

        .profile-heading h1 {
            margin: 0;
            font-size: 27px;
            font-weight: 800;
            letter-spacing: -.5px;
        }

        .profile-heading p {
            margin: 7px 0 0;
            color: #94a3b8;
            font-size: 13px;
        }

        .profile-card {
            display: grid;
            grid-template-columns: 310px minmax(0, 1fr);
            overflow: hidden;
            border: 1px solid rgba(139, 92, 246, .3);
            border-radius: 22px;
            background: rgba(17, 22, 37, .94);
            box-shadow: 0 20px 70px rgba(0, 0, 0, .2);
        }

        /* LEFT PROFILE */
        .profile-overview {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 35px 25px;
            border-right: 1px solid rgba(139, 92, 246, .2);
            background: linear-gradient(
                180deg,
                rgba(124, 58, 237, .09),
                rgba(17, 22, 37, .2)
            );
        }

        .profile-avatar {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 112px;
            height: 112px;
            margin: 5px 0 22px;
            border: 3px solid #a78bfa;
            border-radius: 50%;
            background: linear-gradient(135deg, #9333ea, #4f46e5);
            box-shadow:
                0 0 0 8px rgba(124, 58, 237, .09),
                0 0 35px rgba(124, 58, 237, .23);
            color: white;
            font-size: 43px;
            font-weight: 800;
        }

        .profile-email {
            max-width: 100%;
            margin: 0;
            overflow-wrap: anywhere;
            color: white;
            text-align: center;
            font-size: 16px;
            font-weight: 700;
        }

        .profile-caption {
            margin: 9px 0 17px;
            color: #94a3b8;
            font-size: 12px;
        }

        .role-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 9px 17px;
            border: 1px solid rgba(167, 139, 250, .25);
            border-radius: 999px;
            background: rgba(124, 58, 237, .2);
            color: #c4b5fd;
            font-size: 12px;
            font-weight: 700;
        }

        .overview-divider {
            width: 100%;
            height: 1px;
            margin: 30px 0 24px;
            background: rgba(148, 163, 184, .14);
        }

        .overview-message {
            color: #94a3b8;
            text-align: center;
            font-size: 12px;
            line-height: 1.9;
        }

        .overview-message i {
            display: block;
            margin-bottom: 12px;
            color: #a78bfa;
            font-size: 27px;
        }

        /* RIGHT CONTENT */
        .profile-details {
            min-width: 0;
            padding: 35px;
        }

        .section-heading {
            display: flex;
            align-items: center;
            gap: 11px;
            margin: 0 0 20px;
            font-size: 18px;
            font-weight: 750;
        }

        .section-heading i {
            color: #a78bfa;
            font-size: 19px;
        }

        .detail-list {
            display: flex;
            flex-direction: column;
            gap: 13px;
        }

        .detail-row {
            display: grid;
            grid-template-columns: minmax(125px, .7fr) minmax(0, 1.3fr);
            align-items: center;
            gap: 16px;
            min-height: 70px;
            padding: 14px 17px;
            border: 1px solid #252d42;
            border-radius: 13px;
            background: rgba(8, 13, 29, .55);
        }

        .detail-label {
            display: flex;
            align-items: center;
            gap: 11px;
            color: #94a3b8;
            font-size: 13px;
        }

        .detail-label i {
            width: 18px;
            color: #a78bfa;
            text-align: center;
        }

        .detail-value {
            min-width: 0;
            padding: 11px 13px;
            overflow-wrap: anywhere;
            border: 1px solid #29334d;
            border-radius: 9px;
            background: #11182b;
            color: #e2e8f0;
            font-size: 13px;
        }

        .detail-value.role-value {
            display: flex;
            align-items: center;
            gap: 9px;
            border-color: transparent;
            background: transparent;
            padding-left: 0;
        }

        .security-section {
            margin-top: 30px;
            padding-top: 26px;
            border-top: 1px solid #293047;
        }

        .security-card {
            display: flex;
            align-items: flex-start;
            gap: 15px;
            padding: 19px;
            border: 1px solid #29334d;
            border-radius: 13px;
            background: rgba(8, 13, 29, .55);
        }

        .security-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 42px;
            flex-shrink: 0;
            border-radius: 12px;
            background: rgba(124, 58, 237, .16);
            color: #c4b5fd;
            font-size: 17px;
        }

        .security-card h3 {
            margin: 1px 0 7px;
            color: #e2e8f0;
            font-size: 14px;
            font-weight: 700;
        }

        .security-card p {
            margin: 0;
            color: #94a3b8;
            font-size: 12px;
            line-height: 1.8;
        }

        .security-status {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-top: 12px;
            color: #86efac;
            font-size: 11px;
        }

        .security-status i {
            font-size: 8px;
        }

        .profile-footer {
            margin-top: 22px;
            color: #64748b;
            text-align: center;
            font-size: 11px;
        }

        @@media (max-width: 1000px) {
            .profile-main {
                padding: 24px;
            }

            .profile-card {
                grid-template-columns: 250px minmax(0, 1fr);
            }

            .profile-details {
                padding: 25px;
            }

            .detail-row {
                grid-template-columns: 1fr;
                gap: 9px;
            }
        }

        @@media (max-width: 760px) {
            .profile-layout {
                flex-direction: column;
            }

            .profile-layout > aside {
                width: 100% !important;
                min-height: auto !important;
                flex: 0 0 auto;
            }

            .profile-main {
                padding: 22px 14px;
            }

            .profile-heading {
                gap: 12px;
                margin-bottom: 20px;
            }

            .heading-icon {
                width: 47px;
                height: 47px;
                border-radius: 14px;
            }

            .profile-heading h1 {
                font-size: 21px;
            }

            .profile-card {
                grid-template-columns: minmax(0, 1fr);
                border-radius: 16px;
            }

            .profile-overview {
                padding: 28px 20px;
                border-right: 0;
                border-bottom: 1px solid rgba(139, 92, 246, .2);
            }

            .profile-avatar {
                width: 90px;
                height: 90px;
                font-size: 34px;
            }

            .overview-divider {
                margin: 20px 0;
            }

            .profile-details {
                padding: 23px 16px;
            }

            .section-heading {
                font-size: 16px;
            }

            .detail-row {
                padding: 13px;
            }

            .security-card {
                padding: 14px;
            }
        }
    </style>
</head>

<body>
    <div class="profile-layout">

        @* Sidebar ใช้ไฟล์เดิมที่มีระบบแสดงเมนูตาม Role *@
        <partial name="_Sidebar" />

        <main class="profile-main">
            <div class="profile-container">

                @* Page heading *@
                <header class="profile-heading">
                    <div class="heading-icon">
                        <i class="fa-solid fa-user-astronaut"></i>
                    </div>

                    <div>
                        <h1>โปรไฟล์ของฉัน</h1>
                        <p>ดูข้อมูลบัญชีและสิทธิ์การใช้งาน GAMEWORLD</p>
                    </div>
                </header>

                <section class="profile-card">

                    @* Profile overview *@
                    <div class="profile-overview">

                        <div class="profile-avatar">
                            @initial
                        </div>

                        <p class="profile-email">
                            @(string.IsNullOrWhiteSpace(email)
                                ? "ไม่พบอีเมล"
                                : email)
                        </p>

                        <p class="profile-caption">
                            บัญชีสมาชิก GAMEWORLD
                        </p>

                        <span class="role-badge">
                            <i class="fa-solid fa-shield-halved"></i>
                            @roleLabel
                        </span>

                        <div class="overview-divider"></div>

                        <div class="overview-message">
                            <i class="fa-solid fa-gamepad"></i>

                            <div class="text-white font-semibold mb-1">
                                ยินดีต้อนรับสู่ GAMEWORLD
                            </div>

                            <div>
                                จัดการบัญชีของคุณได้จากหน้านี้
                                <br />
                                ขอให้สนุกกับโลกแห่งเกม
                            </div>
                        </div>

                    </div>

                    @* Account details *@
                    <div class="profile-details">

                        <h2 class="section-heading">
                            <i class="fa-solid fa-address-card"></i>
                            ข้อมูลบัญชี
                        </h2>

                        <div class="detail-list">

                            <div class="detail-row">
                                <div class="detail-label">
                                    <i class="fa-solid fa-envelope"></i>
                                    อีเมลผู้ใช้งาน
                                </div>

                                <div class="detail-value">
                                    @(string.IsNullOrWhiteSpace(email)
                                        ? "ไม่พบข้อมูลอีเมล"
                                        : email)
                                </div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">
                                    <i class="fa-solid fa-user-shield"></i>
                                    สถานะสิทธิ์ (Role)
                                </div>

                                <div class="detail-value role-value">
                                    <span class="role-badge">
                                        <i class="fa-solid fa-user"></i>
                                        @roleLabel
                                    </span>
                                </div>
                            </div>

                        </div>

                        @* Security information *@
                        <div class="security-section">

                            <h2 class="section-heading">
                                <i class="fa-solid fa-lock"></i>
                                ความปลอดภัย
                            </h2>

                            <div class="security-card">
                                <div class="security-icon">
                                    <i class="fa-solid fa-shield-halved"></i>
                                </div>

                                <div>
                                    <h3>การรักษาความปลอดภัยบัญชี</h3>

                                    <p>
                                        รหัสผ่านเป็นข้อมูลส่วนตัว
                                        จึงไม่แสดงรหัสผ่านในหน้าโปรไฟล์
                                        เพื่อป้องกันการเปิดเผยข้อมูลสำคัญ
                                    </p>

                                    <div class="security-status">
                                        <i class="fa-solid fa-circle"></i>
                                        <span>ข้อมูลบัญชีได้รับการปกป้อง</span>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <div class="profile-footer">
                            GAMEWORLD &copy; @DateTime.Now.Year
                            <span class="mx-2">•</span>
                            Account Profile
                        </div>

                    </div>
                </section>

            </div>
        </main>
    </div>
</body>
</html>
