<body style="background-color: #0b0f19; margin: 0; color: #ffffff;">
    
                  
<style>
    .gw-navbar,
    .gw-navbar * {
        box-sizing: border-box;
    }

    .gw-navbar {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        min-height: 76px;
        z-index: 1000;
        padding: 0 4%;
        background: rgba(5, 9, 20, .96);
        border-bottom: 1px solid rgba(255,255,255,.08);
        box-shadow: 0 8px 30px rgba(0,0,0,.25);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        color: #fff;
    }

    .gw-navbar-inner {
        min-height: 76px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
        max-width: 1600px;
        margin: 0 auto;
    }

    /* LOGO */
    .gw-brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        flex-shrink: 0;
    }

    .gw-brand-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ff244b;
        font-size: 23px;
        background: rgba(255,23,68,.10);
        border: 1px solid rgba(255,23,68,.28);
        box-shadow: 0 0 18px rgba(255,23,68,.08);
    }

    .gw-brand-text {
        color: #fff;
        font-size: 25px;
        font-weight: 900;
        letter-spacing: -1px;
        white-space: nowrap;
        font-style: italic;
    }

    .gw-brand-text span {
        color: #ff244b;
    }

    /* MENU */
    .gw-menu {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 30px;
    }

    .gw-menu a {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 28px 0;
        color: #aab7ca;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        transition: color .2s;
        white-space: nowrap;
    }

    .gw-menu a::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: 17px;
        height: 2px;
        background: #ff244b;
        transform: scaleX(0);
        transform-origin: left;
        transition: transform .25s;
    }

    .gw-menu a:hover,
    .gw-menu a.active {
        color: #fff;
    }

    .gw-menu a:hover::after,
    .gw-menu a.active::after {
        transform: scaleX(1);
    }

    /* RIGHT SIDE */
    .gw-nav-right {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 14px;
        flex-shrink: 0;
    }

    .gw-cart-link {
        position: relative;
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        border: 1px solid rgba(255,255,255,.09);
        background: rgba(255,255,255,.035);
        color: #dbe5f5;
        font-size: 17px;
        text-decoration: none;
        transition: .25s;
    }

    .gw-cart-link:hover {
        color: #ff244b;
        background: rgba(255,23,68,.08);
        border-color: rgba(255,23,68,.4);
    }

    #cartBadge {
        position: absolute;
        top: -6px;
        right: -6px;
        min-width: 18px;
        height: 18px;
        padding: 0 4px;
        display: none;
        align-items: center;
        justify-content: center;
        border-radius: 20px;
        background: #ff1744;
        color: white;
        border: 2px solid #080d19;
        font-size: 10px;
        font-weight: 800;
        line-height: 1;
    }

    /* PROFILE */
    .gw-profile {
        position: relative;
    }

    .gw-profile-btn {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: linear-gradient(135deg,#ff1744,#a9002c);
        border: 1px solid rgba(255,255,255,.18);
        color: white;
        font-size: 21px;
        cursor: pointer;
        transition: .25s;
    }

    .gw-profile-btn:hover {
        box-shadow: 0 0 20px rgba(255,23,68,.35);
        transform: translateY(-1px);
    }

    .gw-dropdown {
        display: none;
        position: absolute;
        top: calc(100% + 14px);
        right: 0;
        width: 245px;
        padding: 7px;
        border-radius: 14px;
        background: #0b1221;
        border: 1px solid #24334b;
        box-shadow: 0 18px 45px rgba(0,0,0,.55);
        animation: gwDropdownIn .18s ease-out;
    }

    .gw-dropdown.show {
        display: block;
    }

    @@keyframes gwDropdownIn {
        from {
            opacity: 0;
            transform: translateY(-6px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .gw-dropdown-user {
        padding: 13px 12px;
        border-bottom: 1px solid rgba(255,255,255,.08);
        margin-bottom: 5px;
    }

    .gw-dropdown-label {
        color: #8190a8;
        font-size: 11px;
        margin: 0 0 5px;
    }

    .gw-dropdown-email {
        color: #fff;
        font-size: 12px;
        font-weight: 700;
        margin: 0;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    .gw-dropdown a {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 11px 12px;
        color: #bdc9da;
        border-radius: 8px;
        font-size: 13px;
        text-decoration: none;
        transition: .2s;
    }

    .gw-dropdown a:hover {
        background: rgba(255,255,255,.06);
        color: #fff;
    }

    .gw-dropdown a i {
        width: 17px;
        text-align: center;
        color: #ff536f;
    }

    .gw-dropdown form {
        margin: 5px 0 0;
        padding-top: 5px;
        border-top: 1px solid rgba(255,255,255,.08);
    }

    .gw-logout {
        display: flex;
        align-items: center;
        gap: 11px;
        width: 100%;
        padding: 11px 12px;
        border: none;
        border-radius: 8px;
        background: transparent;
        color: #ff7187;
        font-size: 13px;
        text-align: left;
        cursor: pointer;
        transition: .2s;
    }

    .gw-logout:hover {
        background: rgba(255,23,68,.10);
        color: #ff244b;
    }

    /* LOGIN BUTTON */
    .gw-login-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 42px;
        padding: 0 20px;
        border-radius: 10px;
        color: white;
        background: linear-gradient(110deg,#ff1744,#d50936);
        border: 1px solid rgba(255,255,255,.08);
        box-shadow: 0 5px 20px rgba(255,23,68,.18);
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
        transition: .25s;
        white-space: nowrap;
    }

    .gw-login-btn:hover {
        color: white;
        background: #e50935;
        box-shadow: 0 7px 25px rgba(255,23,68,.35);
        transform: translateY(-1px);
    }

    /* MOBILE */
    .gw-mobile-toggle {
        display: none;
        width: 40px;
        height: 40px;
        border-radius: 9px;
        background: rgba(255,255,255,.05);
        border: 1px solid rgba(255,255,255,.12);
        color: white;
        font-size: 19px;
        cursor: pointer;
    }

    @@media (max-width: 1000px) {
        .gw-navbar {
            padding: 0 3%;
        }

        .gw-navbar-inner {
            gap: 15px;
        }

        .gw-menu {
            gap: 17px;
        }

        .gw-menu a {
            font-size: 13px;
        }

        .gw-brand-text {
            font-size: 22px;
        }
    }

    @@media (max-width: 760px) {
        .gw-navbar-inner {
            min-height: 68px;
            flex-wrap: wrap;
            padding: 12px 0;
        }

        .gw-navbar {
            min-height: 68px;
        }

        .gw-brand-icon {
            width: 37px;
            height: 37px;
            font-size: 20px;
        }

        .gw-brand-text {
            font-size: 21px;
        }

        .gw-nav-right {
            gap: 9px;
        }

        .gw-cart-link,
        .gw-profile-btn {
            width: 38px;
            height: 38px;
        }

        .gw-mobile-toggle {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .gw-menu {
            display: none;
            order: 3;
            width: 100%;
            flex-direction: column;
            align-items: stretch;
            gap: 0;
            padding: 7px 0;
            border-top: 1px solid rgba(255,255,255,.08);
        }

        .gw-menu.mobile-open {
            display: flex;
        }

        .gw-menu a {
            padding: 13px 10px;
            border-radius: 7px;
        }

        .gw-menu a:hover,
        .gw-menu a.active {
            background: rgba(255,255,255,.04);
        }

        .gw-menu a::after {
            display: none;
        }

        .gw-dropdown {
            right: -5px;
            width: min(245px, calc(100vw - 30px));
        }

        .gw-login-btn {
            min-height: 38px;
            padding: 0 13px;
            font-size: 12px;
        }
    }

    @@media (max-width: 380px) {
        .gw-brand-text {
            font-size: 18px;
        }

        .gw-brand {
            gap: 6px;
        }

        .gw-nav-right {
            gap: 6px;
        }

        .gw-brand-icon {
            width: 33px;
            height: 33px;
        }
    }

    /* ป้องกันเนื้อหาถูก Navbar fixed บัง */
    body {
        padding-top: 76px;
    }

    @@media (max-width: 760px) {
        body {
            padding-top: 68px;
        }
    }
</style>

<nav class="gw-navbar">
    <div class="gw-navbar-inner">

        <!-- LOGO -->
        <a href="/" class="gw-brand">
            <div class="gw-brand-icon">
                <i class="fa-solid fa-gamepad"></i>
            </div>
            <span class="gw-brand-text">
                GAME<span>WORLD</span>
            </span>
        </a>

        <!-- MENU: LOGIN ONLY -->
        @if (User?.Identity?.IsAuthenticated == true)
        {
            <div class="gw-menu" id="gwMenu">
                <a href="/">
                    <i class="fa-solid fa-house"></i> หน้าหลัก
                </a>

                <a asp-controller="Product" asp-action="Index">
                    <i class="fa-solid fa-gamepad"></i> เกมทั้งหมด
                </a>

                <a href="/Home/About">
                    <i class="fa-solid fa-circle-info"></i> เกี่ยวกับเรา
                </a>
            </div>
        }

        <!-- RIGHT SIDE -->
        <div class="gw-nav-right">

            @if (User?.Identity?.IsAuthenticated == true)
            {
                <!-- CART -->
                <a asp-controller="Cart"
                   asp-action="Index"
                   class="gw-cart-link"
                   title="ตะกร้าสินค้า"
                   aria-label="ตะกร้าสินค้า">

                    <i class="fa-solid fa-cart-shopping"></i>
                    <span id="cartBadge">0</span>
                </a>

                <!-- PROFILE -->
                <div class="gw-profile" id="profileContainer">

                    <button type="button"
                            class="gw-profile-btn"
                            id="profileBtn"
                            aria-label="เปิดเมนูโปรไฟล์"
                            aria-expanded="false"
                            aria-controls="profileDropdown">
                        <i class="fa-regular fa-circle-user"></i>
                    </button>

                    <div class="gw-dropdown"
                         id="profileDropdown">

                        <div class="gw-dropdown-user">
                            <p class="gw-dropdown-label">เข้าสู่ระบบด้วย</p>
                            <p class="gw-dropdown-email">
                                @User.Identity.Name
                            </p>
                        </div>

                        <a asp-controller="Auth" asp-action="Profile">
                            <i class="fa-solid fa-gear"></i>
                            ตั้งค่าโปรไฟล์
                        </a>

                        <a asp-controller="Cart" asp-action="MyOrders">
                            <i class="fa-solid fa-clock-rotate-left"></i>
                            ประวัติการสั่งซื้อ
                        </a>

                        <form asp-controller="Auth"
                              asp-action="Logout"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit" class="gw-logout">
                                <i class="fa-solid fa-right-from-bracket"></i>
                                ออกจากระบบ
                            </button>
                        </form>

                    </div>
                </div>

                <button type="button"
                        class="gw-mobile-toggle"
                        id="gwMobileToggle"
                        aria-label="เปิดเมนู"
                        aria-expanded="false">
                    <i class="fa-solid fa-bars"></i>
                </button>
            }
            else
            {
                <a asp-controller="Auth"
                   asp-action="Login"
                   class="gw-login-btn">
                    <i class="fa-solid fa-right-to-bracket"></i>
                    เข้าสู่ระบบ
                </a>
            }

        </div>
    </div>
</nav>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const profileBtn = document.getElementById("profileBtn");
        const profileDropdown = document.getElementById("profileDropdown");
        const profileContainer = document.getElementById("profileContainer");

        // PROFILE DROPDOWN
        if (profileBtn && profileDropdown && profileContainer) {
            profileBtn.addEventListener("click", function (event) {
                event.stopPropagation();

                const isOpen = profileDropdown.classList.toggle("show");
                profileBtn.setAttribute("aria-expanded", String(isOpen));
            });

            profileDropdown.addEventListener("click", function (event) {
                event.stopPropagation();
            });

            document.addEventListener("click", function () {
                profileDropdown.classList.remove("show");
                profileBtn.setAttribute("aria-expanded", "false");
            });

            document.addEventListener("keydown", function (event) {
                if (event.key === "Escape") {
                    profileDropdown.classList.remove("show");
                    profileBtn.setAttribute("aria-expanded", "false");
                }
            });
        }

        // MOBILE MENU
        const mobileToggle = document.getElementById("gwMobileToggle");
        const menu = document.getElementById("gwMenu");

        if (mobileToggle && menu) {
            mobileToggle.addEventListener("click", function () {
                const isOpen = menu.classList.toggle("mobile-open");

                mobileToggle.setAttribute("aria-expanded", String(isOpen));
                mobileToggle.innerHTML = isOpen
                    ? '<i class="fa-solid fa-xmark"></i>'
                    : '<i class="fa-solid fa-bars"></i>';
            });
        }

        // CART BADGE
        window.updateCartBadge = function (count) {
            const badge = document.getElementById("cartBadge");
            if (!badge) return;

            const n = Math.max(0, Number(count) || 0);

            badge.textContent = n > 99 ? "99+" : String(n);
            badge.style.display = n > 0 ? "flex" : "none";
        };

        fetch("/Cart/Count")
            .then(response => {
                if (!response.ok) {
                    throw new Error("Unable to load cart count");
                }
                return response.json();
            })
            .then(data => {
                window.updateCartBadge(data.count);
            })
            .catch(() => {
                // หากยังดึงจำนวนสินค้าไม่ได้ จะซ่อน Badge ไว้
            });
    });
</script>

  
