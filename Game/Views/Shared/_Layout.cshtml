
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GameWorld</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Game.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/output.css" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>

<body>
<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        padding-top: 76px;
        background: #0b0f19;
        color: #fff;
        min-height: 100vh;
    }

    .gw-navbar {
        position: fixed;
        z-index: 1000;
        top: 0;
        left: 0;
        width: 100%;
        min-height: 76px;
        padding: 0 4%;
        background: rgba(5, 9, 20, .97);
        border-bottom: 1px solid rgba(255,255,255,.08);
        box-shadow: 0 8px 30px rgba(0,0,0,.25);
        backdrop-filter: blur(18px);
        color: white;
    }

    .gw-navbar-inner {
        min-height: 76px;
        max-width: 1600px;
        margin: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
    }

    .gw-brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        flex-shrink: 0;
    }

    .gw-brand-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ff244b;
        font-size: 23px;
        background: rgba(255,23,68,.1);
        border: 1px solid rgba(255,23,68,.28);
    }

    .gw-brand-text {
        color: white;
        font-size: 25px;
        font-weight: 900;
        letter-spacing: -1px;
        font-style: italic;
        white-space: nowrap;
    }

    .gw-brand-text span {
        color: #ff244b;
    }

    .gw-menu {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 30px;
    }

    .gw-menu a {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 28px 0;
        color: #aab7ca;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        transition: color .2s;
    }

    .gw-menu a:hover,
    .gw-menu a.active {
        color: white;
    }

    .gw-menu a::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: 17px;
        height: 2px;
        background: #ff244b;
        transform: scaleX(0);
        transition: transform .25s;
    }

    .gw-menu a:hover::after,
    .gw-menu a.active::after {
        transform: scaleX(1);
    }

    .gw-nav-right {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 14px;
        flex-shrink: 0;
    }

    .gw-cart-link {
        position: relative;
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        border: 1px solid rgba(255,255,255,.09);
        background: rgba(255,255,255,.035);
        color: #dbe5f5;
        font-size: 17px;
        text-decoration: none;
        transition: .25s;
    }

    .gw-cart-link:hover {
        color: #ff244b;
        border-color: rgba(255,23,68,.4);
    }

    #cartBadge {
        position: absolute;
        top: -6px;
        right: -6px;
        min-width: 18px;
        height: 18px;
        padding: 0 4px;
        display: none;
        align-items: center;
        justify-content: center;
        border-radius: 20px;
        background: #ff1744;
        color: white;
        border: 2px solid #080d19;
        font-size: 10px;
        font-weight: 800;
    }

    .gw-profile {
        position: relative;
    }

    .gw-profile-btn {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: linear-gradient(135deg,#ff1744,#a9002c);
        border: 1px solid rgba(255,255,255,.18);
        color: white;
        font-size: 21px;
        cursor: pointer;
    }

    .gw-profile-btn:hover {
        box-shadow: 0 0 20px rgba(255,23,68,.35);
    }

    .gw-dropdown {
        display: none;
        position: absolute;
        top: calc(100% + 14px);
        right: 0;
        width: 245px;
        padding: 7px;
        border-radius: 14px;
        background: #0b1221;
        border: 1px solid #24334b;
        box-shadow: 0 18px 45px rgba(0,0,0,.55);
    }

    .gw-dropdown.show {
        display: block;
        animation: gwDropdownIn .18s ease-out;
    }

    @@keyframes gwDropdownIn {
        from {
            opacity: 0;
            transform: translateY(-6px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .gw-dropdown-user {
        padding: 13px 12px;
        border-bottom: 1px solid rgba(255,255,255,.08);
        margin-bottom: 5px;
    }

    .gw-dropdown-label {
        color: #8190a8;
        font-size: 11px;
        margin: 0 0 5px;
    }

    .gw-dropdown-email {
        color: white;
        font-size: 12px;
        font-weight: 700;
        margin: 0;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    .gw-dropdown a {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 11px 12px;
        color: #bdc9da;
        border-radius: 8px;
        font-size: 13px;
        text-decoration: none;
        transition: .2s;
    }

    .gw-dropdown a:hover {
        background: rgba(255,255,255,.06);
        color: white;
    }

    .gw-dropdown a i {
        width: 17px;
        text-align: center;
        color: #ff536f;
    }

    .gw-dropdown form {
        margin: 5px 0 0;
        padding-top: 5px;
        border-top: 1px solid rgba(255,255,255,.08);
    }

    .gw-logout {
        display: flex;
        align-items: center;
        gap: 11px;
        width: 100%;
        padding: 11px 12px;
        border: none;
        border-radius: 8px;
        background: transparent;
        color: #ff7187;
        font-size: 13px;
        text-align: left;
        cursor: pointer;
    }

    .gw-logout:hover {
        background: rgba(255,23,68,.10);
        color: #ff244b;
    }

    .gw-login-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 42px;
        padding: 0 20px;
        border-radius: 10px;
        color: white;
        background: linear-gradient(110deg,#ff1744,#d50936);
        border: 1px solid rgba(255,255,255,.08);
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
        transition: .25s;
    }

    .gw-login-btn:hover {
        color: white;
        background: #e50935;
        transform: translateY(-1px);
    }

    .gw-mobile-toggle {
        display: none;
        width: 40px;
        height: 40px;
        border-radius: 9px;
        background: rgba(255,255,255,.05);
        border: 1px solid rgba(255,255,255,.12);
        color: white;
        font-size: 19px;
        cursor: pointer;
    }

    .gw-footer {
        background: #0b0f19;
        border-top: 1px solid rgba(255,255,255,.08);
        color: #94a3b8;
        padding: 4rem 2.5rem 2rem;
        margin-top: 5rem;
        font-family: sans-serif;
    }

    .gw-footer-grid {
        max-width: 1200px;
        margin: 0 auto 3rem;
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(220px,1fr));
        gap: 3rem;
    }

    .gw-footer h4 {
        color: white;
        font-size: .95rem;
        font-weight: 700;
        margin-bottom: 1.25rem;
    }

    .gw-footer p,
    .gw-footer li,
    .gw-footer a {
        font-size: .85rem;
        line-height: 1.7;
    }

    .gw-footer ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: .6rem;
    }

    .gw-footer a {
        color: #94a3b8;
        text-decoration: none;
        transition: color .2s;
    }

    .gw-footer a:hover {
        color: #ff536f;
    }

    .gw-footer-bottom {
        max-width: 1200px;
        margin: auto;
        border-top: 1px solid rgba(255,255,255,.05);
        padding-top: 1.5rem;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
    }

    .gw-footer-bottom p {
        margin: 0;
        font-size: .75rem;
        color: #64748b;
    }

    .gw-footer-legal {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
    }

    @@media (max-width: 1000px) {
        .gw-navbar {
            padding: 0 3%;
        }

        .gw-navbar-inner {
            gap: 15px;
        }

        .gw-menu {
            gap: 17px;
        }

        .gw-menu a {
            font-size: 13px;
        }

        .gw-brand-text {
            font-size: 22px;
        }
    }

    @@media (max-width: 760px) {
        body {
            padding-top: 68px;
        }

        .gw-navbar {
            min-height: 68px;
        }

        .gw-navbar-inner {
            min-height: 68px;
            flex-wrap: wrap;
            padding: 12px 0;
        }

        .gw-brand-icon {
            width: 37px;
            height: 37px;
            font-size: 20px;
        }

        .gw-brand-text {
            font-size: 21px;
        }

        .gw-nav-right {
            gap: 9px;
        }

        .gw-cart-link,
        .gw-profile-btn {
            width: 38px;
            height: 38px;
        }

        .gw-mobile-toggle {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .gw-menu {
            display: none;
            order: 3;
            width: 100%;
            flex-direction: column;
            align-items: stretch;
            gap: 0;
            padding: 7px 0;
            border-top: 1px solid rgba(255,255,255,.08);
        }

        .gw-menu.mobile-open {
            display: flex;
        }

        .gw-menu a {
            padding: 13px 10px;
            border-radius: 7px;
        }

        .gw-menu a:hover,
        .gw-menu a.active {
            background: rgba(255,255,255,.04);
        }

        .gw-menu a::after {
            display: none;
        }

        .gw-dropdown {
            right: -5px;
            width: min(245px, calc(100vw - 30px));
        }

        .gw-login-btn {
            min-height: 38px;
            padding: 0 13px;
            font-size: 12px;
        }

        .gw-footer {
            padding: 3rem 1.25rem 1.5rem;
        }
    }

    @@media (max-width: 380px) {
        .gw-brand-text {
            font-size: 18px;
        }

        .gw-brand {
            gap: 6px;
        }

        .gw-nav-right {
            gap: 6px;
        }

        .gw-brand-icon {
            width: 33px;
            height: 33px;
        }
    }

    /* ===============================
   GAMEWORLD PREMIUM FOOTER
================================ */
.gw-footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-top: 0;
    padding: 64px 24px 0;
    background: #090b14;
    border-top: 1px solid rgba(139, 92, 246, .22);
    color: #a1a9bd;
    font-family: inherit;
}

.gw-footer,
.gw-footer * {
    box-sizing: border-box;
}

.gw-footer-glow {
    position: absolute;
    z-index: -1;
    top: -170px;
    left: 50%;
    width: 620px;
    height: 300px;
    transform: translateX(-50%);
    border-radius: 50%;
    background: rgba(124, 58, 237, .13);
    filter: blur(90px);
    pointer-events: none;
}

.gw-footer-container {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
}

.gw-footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.25fr 1.15fr;
    gap: 48px;
    padding-bottom: 48px;
}

/* BRAND */
.gw-footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    color: #fff;
    text-decoration: none;
}

.gw-logo-icon {
    display: flex;
    width: 46px;
    height: 46px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(196, 181, 253, .3);
    border-radius: 14px;
    background: linear-gradient(145deg, #8b5cf6, #5b21b6);
    box-shadow: 0 8px 25px rgba(124, 58, 237, .25);
    color: white;
    font-size: 23px;
    transition: transform .25s ease, box-shadow .25s ease;
}

.gw-footer-logo:hover .gw-logo-icon {
    transform: translateY(-3px) rotate(-4deg);
    box-shadow: 0 12px 30px rgba(124, 58, 237, .4);
}

.gw-logo-text {
    color: #fff;
    font-size: 23px;
    font-weight: 800;
    letter-spacing: .7px;
}

.gw-logo-text span,
.gw-footer-bottom strong span {
    color: #a78bfa;
}

.gw-footer-description {
    max-width: 330px;
    margin: 0 0 23px;
    color: #929bb0;
    font-size: 13px;
    line-height: 1.95;
}

/* SOCIAL */
.gw-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.gw-socials a {
    display: flex;
    width: 39px;
    height: 39px;
    align-items: center;
    justify-content: center;
    border: 1px solid #282e42;
    border-radius: 11px;
    background: #121625;
    color: #aab2c6;
    font-size: 16px;
    text-decoration: none;
    transition: color .2s ease, background .2s ease,
                border-color .2s ease, transform .2s ease;
}

.gw-socials a:hover {
    transform: translateY(-3px);
    border-color: rgba(167, 139, 250, .55);
    background: rgba(124, 58, 237, .17);
    color: #c4b5fd;
}

/* COLUMNS */
.gw-footer-column h4 {
    margin: 5px 0 23px;
    color: #f5f6fc;
    font-size: 15px;
    font-weight: 600;
}

.gw-footer-column h4 span {
    display: block;
    margin-top: 5px;
    color: #747e96;
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 1.5px;
}

.gw-footer-column ul {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
}

.gw-footer-column ul li,
.gw-footer-column ul li a {
    min-width: 0;
}

.gw-footer-column ul a {
    display: inline-flex;
    align-items: flex-start;
    gap: 10px;
    color: #929bb0;
    font-size: 12px;
    line-height: 1.8;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color .2s ease, transform .2s ease;
}

.gw-footer-column ul a i {
    flex-shrink: 0;
    margin-top: 5px;
    color: #6f4bb8;
    font-size: 10px;
}

.gw-footer-column ul a:hover {
    transform: translateX(3px);
    color: #c4b5fd;
}

/* SUPPORT */
.gw-footer-support > p {
    margin: 0 0 17px;
    color: #929bb0;
    font-size: 12px;
    line-height: 1.9;
}

.gw-support-link {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 13px 12px;
    border: 1px solid #292f43;
    border-radius: 13px;
    background: linear-gradient(120deg, #151a2a, #101421);
    color: #fff;
    text-decoration: none;
    transition: border-color .2s ease, background .2s ease;
}

.gw-support-link:hover {
    border-color: rgba(167, 139, 250, .5);
    background: #191d30;
}

.gw-support-icon {
    display: flex;
    flex-shrink: 0;
    width: 37px;
    height: 37px;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: rgba(139, 92, 246, .16);
    color: #c4b5fd;
    font-size: 15px;
}

.gw-support-link > span:nth-child(2) {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 3px;
    overflow-wrap: anywhere;
    font-size: 11px;
}

.gw-support-link small {
    color: #929bb0;
    font-size: 10px;
}

.gw-support-arrow {
    flex-shrink: 0;
    margin-left: auto;
    color: #7f89a2;
    font-size: 10px;
}

.gw-support-note {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    margin-top: 13px;
    color: #818ba1;
    font-size: 10px;
    line-height: 1.7;
}

.gw-support-note i {
    margin-top: 3px;
    color: #4ade80;
}

/* BOTTOM BAR */
.gw-footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 76px;
    padding: 18px 0;
    border-top: 1px solid rgba(148, 163, 184, .13);
}

.gw-footer-bottom p {
    margin: 0;
    color: #747e94;
    font-size: 11px;
    line-height: 1.8;
}

.gw-footer-bottom strong {
    color: #e2e6f1;
    font-weight: 700;
}

.gw-footer-legal {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 15px;
}

.gw-footer-legal a {
    color: #858ea4;
    font-size: 11px;
    text-decoration: none;
    transition: color .2s ease;
}

.gw-footer-legal a:hover {
    color: #c4b5fd;
}

.gw-legal-divider {
    width: 1px;
    height: 13px;
    background: #343b50;
}

.gw-back-top {
    display: flex;
    flex-shrink: 0;
    width: 37px;
    height: 37px;
    align-items: center;
    justify-content: center;
    border: 1px solid #30364b;
    border-radius: 11px;
    background: #141827;
    color: #c4b5fd;
    text-decoration: none;
    transition: transform .2s ease, background .2s ease;
}

.gw-back-top:hover {
    transform: translateY(-3px);
    background: #29203e;
}

/* RESPONSIVE */
@@media (max-width: 1100px) {
    .gw-footer-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 38px 45px;
    }
}

@@media (max-width: 600px) {
    .gw-footer {
        padding: 42px 20px 0;
    }

    .gw-footer-grid {
        grid-template-columns: minmax(0, 1fr);
        gap: 32px;
        padding-bottom: 32px;
    }

    .gw-footer-description {
        max-width: 100%;
    }

    .gw-footer-column h4 {
        margin-bottom: 16px;
    }

    .gw-footer-column ul {
        gap: 12px;
    }

    .gw-footer-bottom {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 15px;
        padding: 20px 0;
    }

    .gw-footer-bottom p {
        grid-column: 1 / -1;
    }

    .gw-footer-legal {
        justify-content: flex-start;
        gap: 10px;
    }

    .gw-footer-legal a {
        font-size: 10px;
    }
}

@@media (prefers-reduced-motion: reduce) {
    .gw-footer *,
    .gw-footer *::before,
    .gw-footer *::after {
        transition: none !important;
    }
}
</style>

<!-- NAVBAR -->
<nav class="gw-navbar">
    <div class="gw-navbar-inner">

        <a asp-controller="Home" asp-action="Index" class="gw-brand">
            <div class="gw-brand-icon">
                <i class="fa-solid fa-gamepad"></i>
            </div>
            <span class="gw-brand-text">WHAT<span>GAME</span></span>
        </a>

        @if (User?.Identity?.IsAuthenticated == true)
        {
            <div class="gw-menu" id="gwMenu">
                <a asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-house"></i> หน้าหลัก
                </a>

                <a asp-controller="Product" asp-action="Index">
                    <i class="fa-solid fa-gamepad"></i> เกมทั้งหมด
                </a>

                <a asp-controller="Home" asp-action="About">
                    <i class="fa-solid fa-circle-info"></i> เกี่ยวกับเรา
                </a>
            </div>
        }

        <div class="gw-nav-right">
            @if (User?.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Cart"
                   asp-action="Index"
                   class="gw-cart-link"
                   title="ตะกร้าสินค้า"
                   aria-label="ตะกร้าสินค้า">
                    <i class="fa-solid fa-cart-shopping"></i>
                    <span id="cartBadge">0</span>
                </a>

                <div class="gw-profile" id="profileContainer">
                    <button type="button"
                            class="gw-profile-btn"
                            id="profileBtn"
                            aria-label="เปิดเมนูโปรไฟล์"
                            aria-expanded="false"
                            aria-controls="profileDropdown">
                        <i class="fa-regular fa-circle-user"></i>
                    </button>

                    <div class="gw-dropdown" id="profileDropdown">
                        <div class="gw-dropdown-user">
                            <p class="gw-dropdown-label">เข้าสู่ระบบด้วย</p>
                            <p class="gw-dropdown-email">@User.Identity.Name</p>
                        </div>

                        <a asp-controller="Auth" asp-action="Profile">
