<!doctype html>
<html lang="th">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@ViewData["Title"] · WHATGAME Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true">

  <style>
    /* ลบขอบขาวรอบหน้าจอ */
    html, body {
      margin: 0;
      padding: 0;
      min-height: 100%;
      background: #0b0b1a;
      font-family: 'Prompt', 'Noto Sans Thai', system-ui, -apple-system, 'Segoe UI', sans-serif;
    }

    /* แก้: เปลี่ยน hidden เป็น clip เพื่อให้ position: sticky ของ sidebar ทำงานได้ */
    html, body { overflow-x: clip; }

    .admin-container {
      display: flex;
      min-height: 100vh;
      width: 100%;
      background: #0b0b1a;
    }

    /* จอใหญ่: wrapper ไม่มีผลต่อ layout เดิม */
    .sidebar-wrap { display: contents; }
    .admin-container .gw-sidebar { flex-shrink: 0; }

    /* เพิ่ม: Sidebar ตรึงติดจอ สูงเต็มหน้าจอ ไม่ขาดตอนเวลาเลื่อน (เฉพาะจอใหญ่) */
    @@media (min-width: 1024px) {
      .admin-container .gw-sidebar {
        position: sticky;
        top: 0;
        height: 100vh;
        align-self: flex-start;
        overflow-y: auto;      /* เมนูเยอะให้เลื่อนในตัวเอง */
      }
    }

    .sidebar-backdrop { display: none; }
    .mobile-topbar { display: none; }

    /* เนื้อหาหลักขยายเต็มพื้นที่ที่เหลือ */
    .main-content {
      flex: 1 1 0;
      min-width: 0;
      padding: 0;
      background: #0b0b1a;
    }

    /* ===== Tablet & Mobile (< 1024px) ===== */
    @@media (max-width: 1023px) {
      .mobile-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: sticky;
        top: 0;
        z-index: 40;
        padding: 12px 16px;
        background: rgba(11, 11, 26, 0.92);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(139, 92, 246, 0.25);
        color: #fff;
      }
      .mobile-topbar button {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 12px;
        background: rgba(124, 58, 237, 0.2);
        border: 1px solid rgba(139, 92, 246, 0.3);
        color: #c4b5fd;
        font-size: 18px;
        cursor: pointer;
      }
      .mobile-topbar .brand {
        font-weight: 800;
        letter-spacing: .5px;
        color: #fff;
      }

      .admin-container { flex-direction: column; }

      .sidebar-wrap {
        display: block;
        position: fixed;
        top: 0;
        left: 0;
        bottom: 0;
        width: 280px;
        max-width: 85vw;
        z-index: 60;
        overflow-y: auto;
        background: #0b0b1a;
        transform: translateX(-100%);
        transition: transform .3s ease;
      }
      .sidebar-wrap.open { transform: translateX(0); }

      /* บังคับให้ Sidebar เดิมเต็ม wrapper (กัน width/position/height เดิมชนกัน) */
      .sidebar-wrap > .gw-sidebar,
      .sidebar-wrap > aside,
      .sidebar-wrap > nav {
        position: static !important;
        width: 100% !important;
        min-width: 0 !important;
        max-width: none !important;
        height: auto !important;
        min-height: 100%;
      }

      .sidebar-backdrop {
        display: block;
        position: fixed;
        inset: 0;
        z-index: 50;
        background: rgba(0, 0, 0, .6);
        opacity: 0;
        pointer-events: none;
        transition: opacity .3s ease;
      }
      .sidebar-backdrop.show { opacity: 1; pointer-events: auto; }

      .main-content { width: 100%; }
    }
  </style>
</head>
<body>
  <!-- Top bar สำหรับมือถือ/แท็บเล็ต -->
  <div class="mobile-topbar">
    <button id="menuToggle" type="button" aria-label="เปิดเมนู">
      <i class="fa-solid fa-bars"></i>
    </button>
    <span class="brand">WHATGAME</span>
    <span style="width:40px"></span>
  </div>
  <div id="sidebarBackdrop" class="sidebar-backdrop"></div>

  <div class="admin-container">
    <!--ดึง Sidebar มาแสดงด้านซ้าย -->
    <div id="sidebarWrap" class="sidebar-wrap">
      <partial name="_Sidebar" />
    </div>

    <!-- พื้นที่แสดงเนื้อหาหลักของแต่ละหน้า -->
    <main class="main-content">
        @RenderBody()
    </main>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

  <script>
    (function () {
      var sidebar  = document.getElementById('sidebarWrap');
      var backdrop = document.getElementById('sidebarBackdrop');
      var toggle   = document.getElementById('menuToggle');

      function setOpen(open) {
        sidebar.classList.toggle('open', open);
        backdrop.classList.toggle('show', open);
        document.body.style.overflow = open ? 'hidden' : '';
      }

      toggle.addEventListener('click', function () {
        setOpen(!sidebar.classList.contains('open'));
      });
      backdrop.addEventListener('click', function () { setOpen(false); });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') setOpen(false);
      });
      // กดลิงก์ในเมนูแล้วปิดเอง
      sidebar.addEventListener('click', function (e) {
        if (e.target.closest('a')) setOpen(false);
      });
      window.addEventListener('resize', function () {
        if (window.innerWidth >= 1024) setOpen(false);
      });
    })();
  </script>

  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>