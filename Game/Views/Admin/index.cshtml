@model Game.Models.AdminDashboardViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "แผงควบคุมแอดมิน";

    var roles = new[]
    {
        ("admin", "ผู้ดูแลระบบ", "fa-solid fa-shield-halved"),
        ("manager", "ผู้จัดการ", "fa-solid fa-user-tie"),
        ("staff", "พนักงาน", "fa-solid fa-id-badge"),
        ("user", "ผู้ใช้ทั่วไป", "fa-solid fa-user")
    };

    var recentUsers = Model.RecentUsers?.ToList()
                       ?? new List<Game.Models.User>();
}

<style>
    /* =====================================
        WHATGAME ADMIN DASHBOARD
    ===================================== */

    .ad-dashboard {
        width: 100%;
        max-width: none;
        min-width: 0;
        margin: 0;
        padding: 28px 32px 48px;
        min-height: 100vh;
        color: #f8f9ff;
        background: transparent;
        font-family: 'Prompt', 'Kanit', 'Noto Sans Thai', system-ui, -apple-system, 'Segoe UI', sans-serif;
        overflow-x: hidden;
    }

    .ad-dashboard,
    .ad-dashboard *,
    .ad-dashboard *::before,
    .ad-dashboard *::after {
        box-sizing: border-box;
    }

    /* ให้ element ข้อความรับฟอนต์ของ dashboard (ไม่แตะ <i> ของ Font Awesome) */
    .ad-dashboard :where(h1, h2, p, span, strong, a, li, div):not(.ad-role-icon) {
        font-family: inherit;
    }

    /* บังคับฟอนต์ไอคอนกลับมา */
    .ad-dashboard i.fa-solid,
    .ad-dashboard i.fa-regular {
        font-family: "Font Awesome 6 Free" !important;
        font-style: normal;
    }
    .ad-dashboard i.fa-solid { font-weight: 900; }
    .ad-dashboard i.fa-regular { font-weight: 400; }


    /* HEADER */

    .ad-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 32px;
        width: 100%;
        min-width: 0;
    }

    .ad-heading {
        min-width: 0;
    }

    .ad-heading h1 {
        color: #fff;
        font-size: 29px;
        font-weight: 800;
        letter-spacing: -.6px;
        margin: 0 0 9px;
    }

    .ad-heading p {
        color: #a5a8d5;
        font-size: 15px;
        margin: 0;
    }

    .ad-add-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        flex-shrink: 0;
        padding: 14px 23px;
        border-radius: 14px;
        background: linear-gradient(135deg, #9858ff, #6935e9);
        color: #fff !important;
        font-size: 15px;
        font-weight: 700;
        text-decoration: none !important;
        white-space: nowrap;
        box-shadow: 0 8px 25px rgba(124, 58, 237, .25);
        transition: .25s ease;
    }

    .ad-actions{display:flex;gap:12px;align-items:center;flex-wrap:wrap}

.ad-add-btn.ghost{
    background:transparent;
    border:1px solid rgba(255,255,255,.15);
    color:#c4b5fd;
    box-shadow:none;
}
.ad-add-btn.ghost:hover{background:rgba(255,255,255,.06)}

    .ad-add-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 32px rgba(139, 92, 246, .4);
        background: linear-gradient(135deg, #a879ff, #7743fa);
    }

    /* SUMMARY */

    .ad-summary {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
        gap: 20px;
        margin-bottom: 24px;
        width: 100%;
    }

    /* TOTAL CARD */

    .ad-total-card {
        position: relative;
        overflow: hidden;
        min-width: 0;
        min-height: 268px;
        padding: 29px;
        border-radius: 23px;
        background: linear-gradient(140deg, #642ce0, #8d50f6);
        box-shadow: 0 12px 35px rgba(104, 50, 226, .2);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: .3s ease;
    }

    .ad-total-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 16px 40px rgba(124, 58, 237, .35);
    }

    .ad-total-card::before {
        content: "";
        position: absolute;
        width: 230px;
        height: 230px;
        border-radius: 50%;
        background: rgba(255,255,255,.08);
        right: -75px;
        top: -95px;
    }

    .ad-total-card::after {
        content: "";
        position: absolute;
        width: 160px;
        height: 160px;
        border-radius: 50%;
        background: rgba(255,255,255,.06);
        right: 30px;
        bottom: -105px;
    }

    .ad-total-label {
        position: relative;
        z-index: 1;
        color: #eee6ff;
        font-size: 17px;
        font-weight: 600;
    }

    .ad-total-number {
        position: relative;
        z-index: 1;
        color: #fff;
        font-size: clamp(55px, 7vw, 76px);
        line-height: 1;
        font-weight: 800;
        margin: 15px 0;
        letter-spacing: -2px;
    }

    .ad-total-footer {
        position: relative;
        z-index: 1;
        color: #e5d9ff;
        font-size: 15px;
        font-weight: 600;
    }

    /* ROLE GRID */

    .ad-role-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
        min-width: 0;
    }

    .ad-role-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        min-width: 0;
        min-height: 126px;
        padding: 22px;
        border-radius: 22px;
        background: #131329;
        border: 1px solid #29294b;
        text-decoration: none !important;
        transition: .25s ease;
    }

    .ad-role-card:hover {
        transform: translateY(-4px);
        border-color: var(--role-color);
        background: #191832;
        box-shadow: 0 10px 30px rgba(0,0,0,.2);
    }

    .ad-role-info {
        min-width: 0;
    }

    .ad-role-label {
        display: block;
        color: #a9add9;
        font-size: 14px;
        margin-bottom: 10px;
    }

    .ad-role-number {
        display: block;
        color: #fff;
        font-size: 36px;
        line-height: 1;
        font-weight: 800;
    }

    .ad-role-icon {
        width: 46px;
        height: 46px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--role-color);
        font-size: 28px;
        transition: .25s ease;
    }

    .ad-role-card:hover .ad-role-icon {
        transform: scale(1.15);
        filter: drop-shadow(0 0 9px var(--role-color));
    }

    .role-admin   { --role-color: #ad8aff; }
    .role-manager { --role-color: #ffbd27; }
    .role-staff   { --role-color: #20d4e8; }
    .role-user    { --role-color: #94a3b8; }

    /* RECENT USERS */

    .ad-recent-card {
        width: 100%;
        min-width: 0;
        padding: 27px 28px;
        border-radius: 23px;
        background: #131329;
        border: 1px solid #29294b;
        box-shadow: 0 10px 30px rgba(0,0,0,.12);
    }

    .ad-recent-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 12px;
    }

    .ad-recent-title {
        display: flex;
        align-items: center;
        gap: 11px;
        margin: 0;
        color: #fff;
        font-size: 21px;
        font-weight: 800;
    }

    .ad-recent-title i {
        color: #a77aff;
        font-size: 19px;
    }

    .ad-view-all {
        color: #a98aff !important;
        text-decoration: none !important;
        font-size: 14px;
        font-weight: 700;
        transition: .2s;
        white-space: nowrap;
    }

    .ad-view-all:hover {
        color: #d3baff !important;
    }

    /* USER ITEM */

    .ad-user-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .ad-user-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        min-height: 73px;
        padding: 12px 0;
        border-bottom: 1px solid #292943;
        transition: .2s;
    }

    .ad-user-item:last-child {
        border-bottom: none;
    }

    .ad-user-item:hover .ad-user-email {
        color: #bd9cff;
    }

    .ad-user-info {
        display: flex;
        align-items: center;
        gap: 13px;
        min-width: 0;
    }

    .ad-avatar {
        width: 44px;
        height: 44px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        color: #fff;
        font-size: 17px;
        font-weight: 800;
        background: linear-gradient(145deg, #944fff, #5430e8);
        box-shadow: 0 4px 14px rgba(116, 58, 237, .22);
    }

    .ad-user-email {
        color: #f1f1ff;
        font-size: 15px;
        font-weight: 600;
        overflow-wrap: anywhere;
        transition: .2s;
    }

    /* ROLE BADGE */

    .ad-role-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        min-width: 65px;
        padding: 7px 14px;
        border: 1px solid var(--role-color);
        border-radius: 30px;
        color: var(--role-color);
        background: color-mix(in srgb, var(--role-color) 10%, transparent);
        font-size: 12px;
        font-weight: 700;
        text-transform: lowercase;
        white-space: nowrap;
    }

    /* EMPTY */

    .ad-empty {
        text-align: center;
        padding: 38px 15px;
        color: #8588b0;
    }

    .ad-empty i {
        display: block;
        margin-bottom: 12px;
        color: #8c63e9;
        font-size: 36px;
    }

    .ad-empty p {
        margin: 0;
        font-size: 14px;
    }

    /* RESPONSIVE */

    @@media (max-width: 1100px) {
        .ad-summary {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    @@media (max-width: 900px) {
        .ad-total-card {
            min-height: 220px;
        }

        .ad-role-card {
            min-height: 115px;
        }
    }

    @@media (max-width: 600px) {
        .ad-dashboard {
            padding: 14px 12px 30px;
        }

        .ad-header {
            align-items: flex-start;
            flex-direction: column;
            margin-bottom: 23px;
        }

        .ad-heading h1 {
            font-size: 23px;
        }

        .ad-heading p {
            font-size: 13px;
        }

        .ad-add-btn {
            width: 100%;
            padding: 13px;
        }

        .ad-summary {
            gap: 14px;
        }

        .ad-total-card {
            min-height: 205px;
            padding: 23px;
        }

        .ad-role-grid {
            gap: 10px;
        }

        .ad-role-card {
            min-height: 105px;
            padding: 14px;
            border-radius: 16px;
        }

        .ad-role-label {
            font-size: 12px;
        }

        .ad-role-number {
            font-size: 29px;
        }

        .ad-role-icon {
            width: 30px;
            font-size: 21px;
        }

        .ad-recent-card {
            padding: 20px 16px;
        }

        .ad-recent-title {
            font-size: 18px;
        }

        .ad-user-item {
            min-height: 68px;
        }

        .ad-user-email {
            font-size: 13px;
        }

        .ad-avatar {
            width: 38px;
            height: 38px;
            font-size: 15px;
        }

        .ad-role-badge {
            min-width: 55px;
            padding: 6px 9px;
            font-size: 10px;
        }
    }
</style>

<div class="ad-dashboard">

    <!-- HEADER -->
    <header class="ad-header">
    <div class="ad-heading">
        <h1>แผงควบคุมแอดมิน</h1>
        <p>ภาพรวมสมาชิกทั้งหมดใน WHATGAME</p>
    </div>

    <div class="ad-actions">
        <a class="ad-add-btn ghost" asp-controller="AdminUsers" asp-action="Index">
            <i class="fa-solid fa-users-gear"></i>
            จัดการผู้ใช้
        </a>

    </div>
</header>

    <!-- SUMMARY -->
    <section class="ad-summary">

        <!-- TOTAL MEMBERS -->
        <div class="ad-total-card">
            <span class="ad-total-label">
                <i class="fa-solid fa-users"></i>
                &nbsp; สมาชิกทั้งหมด
            </span>

            <strong class="ad-total-number">
                @Model.Total.ToString("N0")
            </strong>

            <span class="ad-total-footer">
                แบ่งเป็น 4 สิทธิ์การใช้งาน
            </span>
        </div>

        <!-- ROLE CARDS -->
        <div class="ad-role-grid">

            @foreach (var role in roles)
            {
                var roleName = role.Item1;
                var roleTitle = role.Item2;
                var roleIcon = role.Item3;

                <a class="ad-role-card role-@roleName.ToLower()"
                   asp-controller="AdminUsers"
                   asp-action="Index"
                   asp-route-role="@roleName">

                    <div class="ad-role-info">
                        <span class="ad-role-label">
                            @roleTitle
                        </span>

                        <strong class="ad-role-number">
                            @Model.CountOf(roleName).ToString("N0")
                        </strong>
                    </div>

                    <div class="ad-role-icon">
                        <i class="@roleIcon"></i>
                    </div>

                </a>
            }

        </div>
    </section>

    <!-- RECENT USERS -->
    <section class="ad-recent-card">

        <div class="ad-recent-header">
            <h2 class="ad-recent-title">
                <i class="fa-solid fa-clock-rotate-left"></i>
                สมาชิกล่าสุด
            </h2>

            <a class="ad-view-all"
               asp-controller="AdminUsers"
               asp-action="Index">
                ดูทั้งหมด
                <i class="fa-solid fa-arrow-right"></i>
            </a>
        </div>

        <ul class="ad-user-list">

            @if (recentUsers.Any())
            {
                @foreach (var user in recentUsers)
                {
                    var email = user.Email ?? "ไม่ระบุอีเมล";
                    var role = user.Role ?? "User";
                    var firstLetter = !string.IsNullOrWhiteSpace(email)
                        ? email.Substring(0, 1).ToUpper()
                        : "?";

                    var roleClass = role.ToLower();

                    <li class="ad-user-item">

                        <div class="ad-user-info">

                            <div class="ad-avatar">
                                @firstLetter
                            </div>

                            <span class="ad-user-email">
                                @email
                            </span>

                        </div>

                        <span class="ad-role-badge role-@roleClass">
                            @role
                        </span>

                    </li>
                }
            }
            else
            {
                <li class="ad-empty">
                    <i class="fa-solid fa-users-slash"></i>
                    <p>ยังไม่มีข้อมูลสมาชิก</p>
                </li>
            }

        </ul>
    </section>

</div>
