
@{
    ViewData["Title"] = "หน้าแรก - GameWorld";
}

<style>
  

    .gw-home {
        --bg: #050914;
        --panel: #0b1425;
        --red: #ff1744;
        --muted: #9aabc5;
        background: var(--bg);
        color: #fff;
        min-height: 100vh;
        font-family: 'Segoe UI', Tahoma, sans-serif;
        overflow: hidden;
    }

    .gw-home * {
        box-sizing: border-box;
    }

    .gw-container {
        width: min(1400px, 92%);
        margin: auto;
    }

    /* NAVBAR */
    .gw-nav {
        min-height: 76px;
        background: rgba(5, 9, 20, .96);
        border-bottom: 1px solid rgba(255,255,255,.08);
        display: flex;
        align-items: center;
        position: relative;
        z-index: 20;
    }

    .gw-nav-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
    }

    .gw-logo {
        font-size: 27px;
        font-weight: 900;
        font-style: italic;
        color: white;
        text-decoration: none;
        white-space: nowrap;
        letter-spacing: -1px;
    }

    .gw-logo span {
        color: var(--red);
    }

    .gw-logo i {
        color: var(--red);
        margin-right: 7px;
    }

    .gw-links {
        display: flex;
        align-items: center;
        gap: 30px;
    }

    .gw-links a {
        color: #c5cede;
        text-decoration: none;
        font-size: 14px;
        transition: .25s;
    }

    .gw-links a:hover,
    .gw-links a.active {
        color: white;
    }

    .gw-links a.active {
        border-bottom: 2px solid var(--red);
        padding-bottom: 9px;
    }

    .gw-nav-action {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .gw-search {
        width: 220px;
        background: #080e1c;
        border: 1px solid #1c2a43;
        border-radius: 10px;
        padding: 11px 13px;
        color: white;
        outline: none;
    }

    .gw-search:focus {
        border-color: var(--red);
    }

    .gw-icon-link {
        color: white;
        text-decoration: none;
        font-size: 20px;
    }

    /* HERO */
    .gw-hero {
       
        min-height: 490px;
        position: relative;
        display: flex;
        align-items: center;
        background:
            linear-gradient(90deg,
                #050914 0%,
                rgba(5,9,20,.97) 25%,
                rgba(5,9,20,.75) 48%,
                rgba(5,9,20,.12) 100%),
            url('https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=2000&auto=format&fit=crop')
            center 42% / cover no-repeat;
        border-bottom: 1px solid #1a263b;
    }

    .gw-hero::after {
        content: "";
        position: absolute;
        inset: auto 0 0;
        height: 100px;
        background: linear-gradient(transparent, var(--bg));
        pointer-events: none;
    }

    .gw-hero-content {
        position: relative;
        z-index: 2;
        max-width: 690px;
        padding: 65px 0 80px;
    }

    .gw-eyebrow {
        color: #c4d0e3;
        letter-spacing: 5px;
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 17px;
    }

    .gw-eyebrow span {
        color: var(--red);
        padding: 0 9px;
    }

    .gw-hero h1 {
        font-size: clamp(35px, 5vw, 68px);
        font-weight: 950;
        line-height: 1.04;
        letter-spacing: -2px;
        margin: 0 0 22px;
        text-transform: uppercase;
    }

    .gw-hero h1 span {
        color: var(--red);
        display: block;
        text-shadow: 0 0 35px rgba(255,23,68,.2);
    }

    .gw-hero p {
        color: #b7c4d8;
        font-size: 15px;
        line-height: 1.9;
        max-width: 520px;
        margin-bottom: 28px;
    }

    .gw-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
    }

    .gw-btn {
        min-height: 47px;
        padding: 0 25px;
        border-radius: 9px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        text-decoration: none;
        font-weight: 700;
        font-size: 14px;
        transition: transform .25s, box-shadow .25s, background .25s;
    }

    .gw-btn:hover {
        transform: translateY(-3px);
    }

    .gw-btn-primary {
        background: var(--red);
        color: white;
        box-shadow: 0 7px 25px rgba(255,23,68,.23);
    }

    .gw-btn-primary:hover {
        background: #e50935;
        color: white;
        box-shadow: 0 10px 32px rgba(255,23,68,.38);
    }

    .gw-btn-outline {
        border: 1px solid #526682;
        color: white;
        background: rgba(5,9,20,.5);
    }

    .gw-btn-outline:hover {
        border-color: white;
        color: white;
    }

    /* FEATURED SECTION */
    .gw-featured {
        padding: 34px 0 75px;
    }

    .gw-section-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
    }

    .gw-section-title {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .gw-title-icon {
        color: var(--red);
        font-size: 34px;
    }

    .gw-section-title h2 {
        font-size: 27px;
        font-weight: 850;
        margin: 0 0 5px;
    }

    .gw-section-title p {
        font-size: 13px;
        color: var(--muted);
        margin: 0;
    }

    .gw-view-all {
        color: var(--red);
        text-decoration: none;
        font-size: 14px;
        font-weight: 700;
        white-space: nowrap;
    }

    .gw-view-all:hover {
        color: #ff718d;
    }

    /* GAME CARDS */
    .gw-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 20px;
    }

    .gw-card {
        background: linear-gradient(180deg, #0c1628, #080f1d);
        border: 1px solid #23334e;
        border-radius: 13px;
        overflow: hidden;
        text-decoration: none;
        color: white;
        min-width: 0;
        transition: transform .3s, border-color .3s, box-shadow .3s;
    }

    .gw-card:hover {
        transform: translateY(-7px);
        border-color: var(--red);
        box-shadow: 0 15px 35px rgba(0,0,0,.35),
                    0 0 20px rgba(255,23,68,.07);
        color: white;
    }

    .gw-card-image {
        height: 195px;
        position: relative;
        overflow: hidden;
        background: #111c30;
    }

    .gw-card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform .5s;
    }

    .gw-card:hover .gw-card-image img {
        transform: scale(1.08);
    }

    .gw-tag {
        position: absolute;
        top: 12px;
        right: 12px;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 750;
        color: #55d9ff;
        background: rgba(3,12,28,.9);
        border: 1px solid rgba(85,217,255,.5);
        backdrop-filter: blur(8px);
    }

    .gw-tag.green {
        color: #49f0c1;
        border-color: rgba(73,240,193,.5);
    }

    .gw-tag.pink {
        color: #ff78c6;
        border-color: rgba(255,120,198,.5);
    }

    .gw-tag.yellow {
        color: #d4ff79;
        border-color: rgba(212,255,121,.5);
    }

    .gw-card-body {
        padding: 18px;
    }

    .gw-card-body h3 {
        font-size: 17px;
        font-weight: 800;
        margin: 0 0 10px;
        line-height: 1.4;
    }

    .gw-card-body p {
        color: #9aabc5;
        font-size: 12px;
        line-height: 1.8;
        margin: 0;
        min-height: 44px;
    }

    .gw-card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        margin-top: 18px;
        padding-top: 13px;
        border-top: 1px solid #1c2a40;
    }

    .gw-game-info {
        color: #aab9d0;
        font-size: 11px;
    }

    .gw-game-info i {
        color: var(--red);
        margin-right: 5px;
    }

    .gw-arrow {
        width: 34px;
        height: 34px;
        border: 1px solid #293c5d;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: .25s;
    }

    .gw-card:hover .gw-arrow {
        background: var(--red);
        border-color: var(--red);
    }

    /* RESPONSIVE */
    @@media (max-width: 1100px) {
        .gw-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .gw-links {
            gap: 16px;
        }

        .gw-search {
            width: 160px;
        }
    }

    @@media (max-width: 760px) {
        .gw-nav {
            padding: 15px 0;
        }

        .gw-nav-inner {
            flex-wrap: wrap;
            gap: 15px;
        }

        .gw-logo {
            font-size: 23px;
        }

        .gw-links {
            order: 3;
            width: 100%;
            justify-content: center;
            gap: 23px;
        }

        .gw-links a {
            font-size: 12px;
        }

        .gw-nav-action {
            gap: 13px;
        }

        .gw-search {
            width: 125px;
            padding: 9px;
            font-size: 12px;
        }

        .gw-hero {
            min-height: 440px;
            background-position: 58% center;
        }

        .gw-hero-content {
            padding: 60px 0;
        }

        .gw-hero h1 {
            letter-spacing: -1px;
        }

        .gw-hero p {
            font-size: 13px;
        }

        .gw-section-title h2 {
            font-size: 21px;
        }

        .gw-card-image {
            height: 160px;
        }

        .gw-card-body {
            padding: 13px;
        }

        .gw-card-body h3 {
            font-size: 15px;
        }
    }

    @@media (max-width: 480px) {
        .gw-container {
            width: 92%;
        }

        .gw-grid {
            grid-template-columns: 1fr;
            gap: 17px;
        }

        .gw-card-image {
            height: 210px;
        }

        .gw-section-heading {
            align-items: flex-start;
        }

        .gw-section-title {
            gap: 10px;
        }

        .gw-section-title h2 {
            font-size: 19px;
        }

        .gw-view-all {
            font-size: 12px;
            padding-top: 6px;
        }

        .gw-hero h1 {
            font-size: 38px;
        }

        .gw-eyebrow {
            letter-spacing: 3px;
        }

        .gw-btn {
            padding: 0 16px;
        }
    }
</style>

<div class="gw-home">

   

    <!-- HERO -->
    <section class="gw-hero">
        <div class="gw-container">
            <div class="gw-hero-content">

                <div class="gw-eyebrow">
                    PLAY <span>•</span> EXPLORE <span>•</span> ENJOY
                </div>

                <h1>
                    GAMEWORLD -
                    <span>GAMING THEME</span>
                </h1>

                <p>
                    ค้นพบโลกแห่งเกมที่คุณชื่นชอบ รวมเกมแอ็กชัน
                    RPG และเกมแข่งรถไว้ในที่เดียว
                    เลือกเกมที่ใช่สำหรับคุณ แล้วเริ่มการผจญภัยครั้งใหม่ได้เลย
                </p>

                <div class="gw-buttons">
                    <a href="/Product" class="gw-btn gw-btn-primary">
                        <i class="fa-solid fa-cart-shopping"></i>
                        เลือกซื้อเกม
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>

                    <a href="#featured" class="gw-btn gw-btn-outline">
                        <i class="fa-solid fa-play"></i>
                        ดูเกมแนะนำ
                    </a>
                </div>

            </div>
        </div>
    </section>

    <!-- FEATURED GAMES -->
    <section class="gw-featured" id="featured">
        <div class="gw-container">

            <div class="gw-section-heading">
                <div class="gw-section-title">
                    <div class="gw-title-icon">
                        <i class="fa-brands fa-playstation"></i>
                    </div>
                    <div>
                        <h2>เกมยอดฮิตแนะนำ</h2>
                        <p>เกมที่น่าสนใจสำหรับสายเกมเมอร์</p>
                    </div>
                </div>

                <a href="/Product" class="gw-view-all">
                    ดูเกมทั้งหมด <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>

            <div class="gw-grid">

                <!-- GAME 1 -->
                <a href="/Product/Category/Fps" class="gw-card">
                    <div class="gw-card-image">
                        <img src="https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=800&auto=format&fit=crop"
                             alt="Cyber Legends 2077"
                             loading="lazy" />
                        <span class="gw-tag">Action / RPG</span>
                    </div>

                    <div class="gw-card-body">
                        <h3>Cyber Legends: 2077</h3>
                        <p>
                            ผจญภัยในโลกไซเบอร์พังก์
                            พร้อมบรรยากาศแห่งอนาคตและการต่อสู้สุดเข้มข้น
                        </p>

                        <div class="gw-card-footer">
                            <div class="gw-game-info">
                                <i class="fa-solid fa-star"></i> เกมแอ็กชัน
                                &nbsp; | &nbsp;
                                <i class="fa-solid fa-desktop"></i> PC
                            </div>
                            <span class="gw-arrow">
                                <i class="fa-solid fa-arrow-right"></i>
                            </span>
                        </div>
                    </div>
                </a>

                <!-- GAME 2 -->
                <a href="/Product/Category/Rpg" class="gw-card">
                    <div class="gw-card-image">
                        <img src="https://images.unsplash.com/photo-1518709268805-4e9042af9f23?q=80&w=800&auto=format&fit=crop"
                             alt="Elden Realm"
                             loading="lazy" />
                        <span class="gw-tag green">Open World</span>
                    </div>

                    <div class="gw-card-body">
                        <h3>Elden Realm</h3>
                        <p>
                            สำรวจดินแดนแฟนตาซีอันกว้างใหญ่
                            ต่อสู้กับศัตรูและค้นพบความลับที่ซ่อนอยู่
                        </p>

                        <div class="gw-card-footer">
                            <div class="gw-game-info">
                                <i class="fa-solid fa-star"></i> RPG
                                &nbsp; | &nbsp;
                                <i class="fa-solid fa-desktop"></i> PC
                            </div>
                            <span class="gw-arrow">
                                <i class="fa-solid fa-arrow-right"></i>
                            </span>
                        </div>
                    </div>
                </a>

                <!-- GAME 3 -->
                <a href="/Product/Category/Racing" class="gw-card">
                    <div class="gw-card-image">
                        <img src="https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?q=80&w=800&auto=format&fit=crop"
                             alt="Speed Horizon Ultimate"
                             loading="lazy" />
                        <span class="gw-tag pink">Racing</span>
                    </div>

                    <div class="gw-card-body">
                        <h3>Speed Horizon Ultimate</h3>
                        <p>
                            สัมผัสความเร็วกับรถสปอร์ตสุดหรู
                            บนเส้นทางที่ท้าทายและเต็มไปด้วยการแข่งขัน
                        </p>

                        <div class="gw-card-footer">
                            <div class="gw-game-info">
                                <i class="fa-solid fa-star"></i> Racing
                                &nbsp; | &nbsp;
                                <i class="fa-solid fa-desktop"></i> PC
                            </div>
                            <span class="gw-arrow">
                                <i class="fa-solid fa-arrow-right"></i>
                            </span>
                        </div>
                    </div>
                </a>

                <!-- GAME 4 -->
                <a href="/Product/Category/Fps" class="gw-card">
                    <div class="gw-card-image">
                        <img src="https://images.unsplash.com/photo-1509198397868-475647b2a1e5?q=80&w=800&auto=format&fit=crop"
                             alt="Tactical Ops Zero"
                             loading="lazy" />
                        <span class="gw-tag yellow">FPS / Tactical</span>
                    </div>

                    <div class="gw-card-body">
                        <h3>Tactical Ops: Zero</h3>
                        <p>
                            วางแผนการรบ ทำงานเป็นทีม
                            และพิสูจน์ความแม่นยำในสนามรบ
                        </p>

                        <div class="gw-card-footer">
                            <div class="gw-game-info">
                                <i class="fa-solid fa-star"></i> FPS
                                &nbsp; | &nbsp;
                                <i class="fa-solid fa-desktop"></i> PC
                            </div>
                            <span class="gw-arrow">
                                <i class="fa-solid fa-arrow-right"></i>
                            </span>
                        </div>
                    </div>
                </a>

            </div>
        </div>
    </section>

</div>
